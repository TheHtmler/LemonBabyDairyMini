.page {
  min-height: 100vh;
  background: #FFFDF7;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page.has-bar {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.cover {
  width: 100%;
  height: 420rpx;
  background: #FFF3C4;
  display: block;
}

.panel {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 0, 0.08);
  box-sizing: border-box;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #FFF3C4;
  color: #8A6A00;
  font-size: 22rpx;
}

.authorLabel {
  display: block;
  margin-top: 12rpx;
  color: #A08A4A;
  font-size: 26rpx;
}

.desc {
  display: block;
  margin-top: 16rpx;
  color: #555;
  font-size: 28rpx;
  line-height: 1.6;
}

.meta-row {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  color: #8A6A00;
  font-size: 24rpx;
}

.nutrition-grid {
  display: flex;
  gap: 12rpx;
}

.nutri-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: #FFF8E1;
  border-radius: 16rpx;
}

.nutri-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5A4200;
}

.nutri-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A08A4A;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 247, 0.96);
  border-top: 1rpx solid rgba(255, 184, 0, 0.18);
  box-sizing: border-box;
}

.like-bar {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #FFF8E1;
  border: 2rpx solid rgba(255, 184, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #8A6200;
  box-sizing: border-box;
}

.like-bar.liked {
  background: linear-gradient(135deg, #FFE08A, #FFD45A);
  border-color: transparent;
  color: #3F2C00;
  font-weight: 700;
}

.like-bar-text {
  font-size: 28rpx;
}

.like-num {
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}

.bar-spacer {
  flex: 1;
}

.edit-bar {
  min-width: 168rpx;
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 42rpx;
  background: linear-gradient(145deg, #FFD86A, #FFB800);
  color: #3F2C00;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.like-icon {
  width: 32rpx;
  height: 30rpx;
  position: relative;
  flex-shrink: 0;
}

.like-icon::before,
.like-icon::after {
  content: '';
  position: absolute;
  top: 0;
  width: 17rpx;
  height: 28rpx;
  border-radius: 17rpx 17rpx 0 0;
  background: #C4A86A;
}

.like-icon::before {
  left: 16rpx;
  transform: rotate(-45deg);
  transform-origin: 0 100%;
}

.like-icon::after {
  left: 0;
  transform: rotate(45deg);
  transform-origin: 100% 100%;
}

.like-icon.on::before,
.like-icon.on::after,
.like-bar.liked .like-icon::before,
.like-bar.liked .like-icon::after {
  background: #E85D4C;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4200;
  margin-bottom: 16rpx;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FFF3C4;
  font-size: 28rpx;
}

.ing-name {
  color: #333;
}

.ing-amount {
  color: #999;
}

.step {
  margin-bottom: 24rpx;
}

.step-index {
  display: block;
  font-size: 24rpx;
  color: #FFB800;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.step-image {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  margin-bottom: 10rpx;
}

.step-text {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

.state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #999;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  color: #5A4200;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  display: block;
  color: #A08A4A;
  font-size: 26rpx;
}
