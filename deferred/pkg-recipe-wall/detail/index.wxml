<view class="page {{post && !unavailable ? 'has-bar' : ''}}">
  <view wx:if="{{loading}}" class="state">加载中...</view>

  <view wx:elif="{{unavailable}}" class="state">
    <text class="empty-title">内容不可用</text>
    <text class="empty-tip">{{message || '该食谱已下架或不存在'}}</text>
  </view>

  <block wx:elif="{{post}}">
    <image
      class="cover"
      src="{{post.coverFileId}}"
      mode="aspectFill"
      data-url="{{post.coverFileId}}"
      bindtap="previewImage"
    />

    <view class="panel">
      <text class="title">{{post.title}}</text>
      <view class="tag-row" wx:if="{{post.tags && post.tags.length}}">
        <text class="tag" wx:for="{{post.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="authorLabel">{{authorLabel}}</text>
      <text class="desc" wx:if="{{post.description}}">{{post.description}}</text>
      <view class="meta-row" wx:if="{{cookingText || difficultyLabel}}">
        <text wx:if="{{cookingText}}">⏱ {{cookingText}}</text>
        <text wx:if="{{difficultyLabel}}">难度 {{difficultyLabel}}</text>
      </view>
    </view>

    <view class="panel" wx:if="{{nutrition}}">
      <view class="section-title">营养预估（整道）</view>
      <view class="nutrition-grid">
        <view class="nutri-item">
          <text class="nutri-value">{{nutrition.caloriesText}}</text>
          <text class="nutri-label">热量 kcal</text>
        </view>
        <view class="nutri-item">
          <text class="nutri-value">{{nutrition.proteinText}}</text>
          <text class="nutri-label">蛋白 g</text>
        </view>
        <view class="nutri-item">
          <text class="nutri-value">{{nutrition.carbsText}}</text>
          <text class="nutri-label">碳水 g</text>
        </view>
        <view class="nutri-item">
          <text class="nutri-value">{{nutrition.fatText}}</text>
          <text class="nutri-label">脂肪 g</text>
        </view>
      </view>
    </view>

    <view class="panel">
      <view class="section-title">用料</view>
      <view class="ingredient" wx:for="{{post.ingredients}}" wx:key="foodId">
        <text class="ing-name">{{item.foodName || item.name}}</text>
        <text class="ing-amount">{{item.amount || (item.quantity + item.unit)}}</text>
      </view>
    </view>

    <view class="panel">
      <view class="section-title">做法</view>
      <view class="step" wx:for="{{post.steps}}" wx:key="index" wx:for-index="index">
        <text class="step-index">第 {{index + 1}} 步</text>
        <image
          wx:if="{{item.imageFileId}}"
          class="step-image"
          src="{{item.imageFileId}}"
          mode="aspectFill"
          data-url="{{item.imageFileId}}"
          bindtap="previewImage"
        />
        <text class="step-text">{{item.text}}</text>
      </view>
    </view>

    <view class="bottom-bar">
      <view
        class="like-bar {{liked ? 'liked' : ''}}"
        wx:if="{{post.status !== 'draft'}}"
        bindtap="onToggleLike"
      >
        <view class="like-icon {{liked ? 'on' : ''}}"></view>
        <text class="like-bar-text">{{liked ? '已赞' : '点赞'}}</text>
        <text class="like-num">{{likeCount}}</text>
      </view>
      <view class="bar-spacer" wx:else></view>
      <view class="edit-bar" wx:if="{{canEdit}}" bindtap="goEdit">编辑</view>
    </view>
  </block>
</view>
