<view class="page">
  <view class="hero-card">
    <view class="hero-main">
      <view class="hero-badge">新菜</view>
      <view class="hero-copy">
        <text class="hero-title">写下这道菜</text>
        <text class="hero-subtitle">成品图 + 用料 + 步骤，填好即可上墙</text>
      </view>
    </view>
  </view>

  <view class="tip" wx:if="{{tipText}}">{{tipText}}</view>

  <!-- 1. 成品图 -->
  <view class="panel">
    <view class="section-head">
      <view class="section-index">1</view>
      <view class="section-titles">
        <text class="section-title">成品图片</text>
        <text class="section-tip">选一张最好看的成品照做封面</text>
      </view>
    </view>
    <view class="cover-box {{coverTempPath || coverFileId ? 'has-image' : ''}}" hover-class="press-soft" bindtap="chooseCover">
      <image wx:if="{{coverTempPath || coverFileId}}" class="cover" src="{{coverTempPath || coverFileId}}" mode="aspectFill" />
      <view wx:else class="cover-empty">
        <view class="cover-camera"></view>
        <text class="cover-placeholder">点击上传做好的成品</text>
        <text class="cover-hint">建议横图或方图，清晰更好看</text>
      </view>
    </view>
  </view>

  <!-- 2. 标题 -->
  <view class="panel">
    <view class="section-head">
      <view class="section-index">2</view>
      <view class="section-titles">
        <text class="section-title">菜谱标题</text>
        <text class="section-tip">简洁好记，方便搜索</text>
      </view>
    </view>
    <input class="compact-input" maxlength="40" placeholder="例如：南瓜泥" value="{{title}}" bindinput="onTitleInput" />
  </view>

  <!-- 3. 描述 -->
  <view class="panel">
    <view class="section-head">
      <view class="section-index">3</view>
      <view class="section-titles">
        <text class="section-title">菜谱描述</text>
        <text class="section-tip">适合什么阶段、口感如何</text>
      </view>
    </view>
    <textarea class="compact-textarea" maxlength="500" placeholder="简单介绍这道菜，适合什么阶段等" value="{{description}}" bindinput="onDescriptionInput" />
  </view>

  <view class="panel">
    <view class="section-head">
      <view class="section-index">#</view>
      <view class="section-titles">
        <text class="section-title">标签（可选）</text>
        <text class="section-tip">最多 {{tagMaxCount}} 个，便于发现</text>
      </view>
    </view>
    <view class="selected-tags" wx:if="{{selectedTags.length}}">
      <view class="selected-tag" wx:for="{{selectedTags}}" wx:key="*this">
        <text>#{{item}}</text>
        <text class="selected-tag-remove" data-tag="{{item}}" bindtap="onRemoveSelectedTag">×</text>
      </view>
    </view>
    <view class="custom-tag-row">
      <input
        class="compact-input custom-tag-input"
        maxlength="{{tagMaxLen}}"
        placeholder="自定义，如软食、手指食物"
        value="{{customTagInput}}"
        bindinput="onCustomTagInput"
        bindconfirm="onAddCustomTag"
      />
      <view class="link-btn" hover-class="press-soft" bindtap="onAddCustomTag">添加</view>
    </view>
    <view class="suggest-label">快捷建议</view>
    <view class="tags">
      <view
        class="tag {{selectedTagSet[item] ? 'active' : ''}}"
        wx:for="{{tagSuggestions}}"
        wx:key="*this"
        data-tag="{{item}}"
        bindtap="onToggleTag"
      >{{item}}</view>
    </view>
  </view>

  <!-- 4. 用料 -->
  <view class="panel">
    <view class="section-head">
      <view class="section-index">4</view>
      <view class="section-titles">
        <text class="section-title">用料</text>
        <text class="section-tip">从食物库选择，自动估算营养</text>
      </view>
    </view>
    <view class="ing-head">
      <text class="ing-col-name">食材</text>
      <text class="ing-col-qty">份量</text>
    </view>

    <view class="ing-row" wx:for="{{ingredients}}" wx:key="foodId">
      <view class="ing-name">{{item.foodName}}</view>
      <view class="ing-qty">
        <input
          class="qty-input"
          type="digit"
          placeholder="0"
          value="{{item.quantity}}"
          data-index="{{index}}"
          bindinput="onQuantityInput"
          bindblur="onQuantityBlur"
        />
        <text class="qty-unit">{{item.unit}}</text>
      </view>
    </view>

    <view class="ing-empty" wx:if="{{!ingredients.length}}">还没有用料，请从食物库添加</view>

    <view class="ing-actions">
      <view class="ghost-btn" hover-class="press-soft" bindtap="openAdjustSheet">调整顺序</view>
      <view class="ghost-btn primary" hover-class="press-soft" bindtap="addIngredients">添加食材</view>
    </view>
  </view>

  <!-- 5. 做法 -->
  <view class="panel">
    <view class="section-head">
      <view class="section-index">5</view>
      <view class="section-titles">
        <text class="section-title">做法</text>
        <text class="section-tip">一步一张图更好跟做</text>
      </view>
    </view>

    <view class="step-block" id="step-block-{{index}}" wx:for="{{steps}}" wx:key="index">
      <view class="label-row">
        <view class="step-badge">第 {{index + 1}} 步</view>
        <text class="remove" wx:if="{{steps.length > 1}}" data-index="{{index}}" bindtap="removeStep">删除</text>
      </view>

      <view class="step-image-box {{item.imageTempPath || item.imageFileId ? 'has-image' : ''}}" data-index="{{index}}" bindtap="chooseStepImage">
        <image wx:if="{{item.imageTempPath || item.imageFileId}}" class="step-image" src="{{item.imageTempPath || item.imageFileId}}" mode="aspectFill" />
        <view wx:else class="step-empty">
          <text class="cover-placeholder">上传步骤图（可选）</text>
        </view>
      </view>
      <view class="step-image-actions" wx:if="{{item.imageTempPath || item.imageFileId}}">
        <text class="link" data-index="{{index}}" bindtap="chooseStepImage">换图</text>
        <text class="remove" data-index="{{index}}" bindtap="clearStepImage">删图</text>
      </view>

      <textarea
        class="compact-textarea step-text"
        maxlength="500"
        placeholder="写下这一步的做法"
        value="{{item.text}}"
        data-index="{{index}}"
        adjust-position="{{false}}"
        cursor-spacing="{{24}}"
        hold-keyboard="{{true}}"
        show-confirm-bar="{{false}}"
        bindfocus="onStepFocus"
        bindblur="onStepBlur"
        bindinput="onStepInput"
      />

      <view class="step-add-row" wx:if="{{index === steps.length - 1}}">
        <view class="ghost-btn primary" hover-class="press-soft" bindtap="addStep">+ 添加一步</view>
      </view>
    </view>
  </view>

  <!-- 6. 高级设置 -->
  <view class="panel">
    <view class="advanced-entry" bindtap="toggleAdvanced">
      <view class="section-head compact">
        <view class="section-index soft">···</view>
        <view class="section-titles">
          <text class="section-title">高级设置</text>
          <text class="section-tip">时长与难度，可稍后补充</text>
        </view>
      </view>
      <text class="link">{{showAdvanced ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{showAdvanced}}" class="advanced-body">
      <text class="field-label">烹饪时长（分钟）</text>
      <input class="compact-input" type="number" placeholder="例如 20" value="{{cookingMinutes}}" bindinput="onCookingMinutesInput" />
      <text class="field-label spaced">烹饪难度</text>
      <view class="tags">
        <view
          class="tag {{difficulty === item.value ? 'active' : ''}}"
          wx:for="{{difficultyOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="onSelectDifficulty"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="nutrition-card">
    <text class="nutrition-title">预估营养</text>
    <view class="nutrition-grid">
      <view class="nutrition-item">
        <text class="nutrition-value">{{nutritionPreview.caloriesText}}</text>
        <text class="nutrition-label">热量</text>
      </view>
      <view class="nutrition-item">
        <text class="nutrition-value">{{nutritionPreview.proteinText}}</text>
        <text class="nutrition-label">蛋白 g</text>
      </view>
      <view class="nutrition-item">
        <text class="nutrition-value">{{nutritionPreview.carbsText}}</text>
        <text class="nutrition-label">碳水 g</text>
      </view>
      <view class="nutrition-item">
        <text class="nutrition-value">{{nutritionPreview.fatText}}</text>
        <text class="nutrition-label">脂肪 g</text>
      </view>
    </view>
  </view>

  <view class="footer-actions {{focusedStepIndex >= 0 ? 'keyboard-open' : ''}}">
    <button
      class="draft-btn"
      wx:if="{{canSaveDraft}}"
      hover-class="press-soft"
      loading="{{savingDraft}}"
      disabled="{{savingDraft}}"
      bindtap="onSaveDraft"
    >存草稿</button>
    <button
      class="save-btn"
      hover-class="press-soft"
      loading="{{submitting}}"
      disabled="{{submitting || savingDraft}}"
      bindtap="onPreview"
    >{{submitBtnText}}</button>
  </view>
</view>

<!-- 调整用料弹层：排序 / 删除 -->
<view class="sheet-mask" wx:if="{{showAdjustSheet}}" bindtap="closeAdjustSheet"></view>
<view class="sheet" wx:if="{{showAdjustSheet}}">
  <view class="sheet-handle"></view>
  <view class="sheet-title">调整用料</view>
  <view class="sheet-tip">可上移、下移或删除</view>
  <view class="sheet-item" wx:for="{{ingredients}}" wx:key="foodId">
    <text class="sheet-name">{{index + 1}}. {{item.foodName}}</text>
    <view class="sheet-ops">
      <text class="sheet-btn" data-index="{{index}}" data-offset="-1" bindtap="moveIngredient">上移</text>
      <text class="sheet-btn" data-index="{{index}}" data-offset="1" bindtap="moveIngredient">下移</text>
      <text class="sheet-btn danger" data-index="{{index}}" bindtap="removeIngredient">删除</text>
    </view>
  </view>
  <button class="sheet-close" hover-class="press-soft" bindtap="closeAdjustSheet">完成</button>
</view>
