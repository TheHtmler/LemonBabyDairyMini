.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #FFFDF7;
  box-sizing: border-box;
}

.tip {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FFF3C4;
  color: #8A6A00;
  font-size: 24rpx;
}

.state {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #999;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 220rpx;
  background: #FFF3C4;
  display: block;
}

.body {
  padding: 20rpx 24rpx 24rpx;
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.meta {
  display: block;
  margin: 10rpx 0 16rpx;
  color: #A08A4A;
  font-size: 24rpx;
}

.danger-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #FFE0A3;
  color: #8A4A00;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.danger-btn::after {
  border: none;
}
