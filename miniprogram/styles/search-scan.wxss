/* 首页、搜索和扫描共用的线性图标，图形始终约束在同一尺寸内。 */
.ss-icon { position: relative; display: block; width: 36rpx; height: 36rpx; flex-shrink: 0; color: #8d7853; box-sizing: border-box; }
.ss-icon-search::before { content: ''; position: absolute; left: 3rpx; top: 2rpx; width: 23rpx; height: 23rpx; border: 3rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.ss-icon-search::after { content: ''; position: absolute; left: 24rpx; top: 24rpx; width: 12rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; transform: rotate(45deg); transform-origin: left center; }
.ss-icon-camera::before { content: ''; position: absolute; left: 2rpx; right: 2rpx; top: 10rpx; bottom: 3rpx; border: 3rpx solid currentColor; border-radius: 6rpx; }
.ss-icon-camera::after { content: ''; position: absolute; top: 4rpx; left: 11rpx; width: 14rpx; height: 7rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 4rpx 4rpx 0 0; box-sizing: border-box; }
.ss-camera-lens { position: absolute; top: 16rpx; left: 12rpx; width: 13rpx; height: 13rpx; border: 3rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.ss-icon-close::before,.ss-icon-close::after { content: ''; position: absolute; top: 17rpx; left: 5rpx; width: 27rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; transform: rotate(45deg); }
.ss-icon-close::after { transform: rotate(-45deg); }
.ss-icon-filter::before,.ss-icon-filter::after { content: ''; position: absolute; left: 4rpx; top: 8rpx; width: 28rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; }
.ss-icon-filter::after { left: 10rpx; top: 25rpx; width: 16rpx; }
.ss-filter-middle { position: absolute; left: 7rpx; top: 17rpx; width: 22rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; }
.ss-icon-album { border: 3rpx solid currentColor; border-radius: 6rpx; overflow: hidden; }
.ss-icon-album::before { content: ''; position: absolute; right: 5rpx; top: 5rpx; width: 6rpx; height: 6rpx; border-radius: 50%; background: currentColor; }
.ss-icon-album::after { content: ''; position: absolute; left: 5rpx; top: 18rpx; width: 19rpx; height: 19rpx; border: 3rpx solid currentColor; transform: rotate(45deg); border-radius: 2rpx; }
.ss-icon-arrow { width: 20rpx; height: 20rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(45deg); }
.ss-icon-notice::before { content: ''; position: absolute; left: 1rpx; top: 13rpx; width: 12rpx; height: 13rpx; border: 3rpx solid currentColor; border-right: 0; border-radius: 4rpx 0 0 4rpx; box-sizing: border-box; }
.ss-icon-notice::after { content: ''; position: absolute; left: 11rpx; top: 7rpx; width: 15rpx; height: 22rpx; border: 3rpx solid currentColor; border-radius: 2rpx; transform: skewY(-18deg); box-sizing: border-box; }
.ss-notice-handle { position: absolute; left: 6rpx; top: 24rpx; width: 7rpx; height: 10rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; border-radius: 0 0 0 3rpx; box-sizing: border-box; }
.ss-notice-wave { position: absolute; right: 0; top: 11rpx; width: 6rpx; height: 15rpx; border-right: 3rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
