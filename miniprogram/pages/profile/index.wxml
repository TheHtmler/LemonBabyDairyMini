<view class="profile-container">
  <!-- 宝宝信息区域 -->
  <view class="user-info">
    <!-- 头像区域 - 点击可更换头像 -->
    <view class="avatar-wrapper" bindtap="onAvatarClick">
      <image class="avatar" src="{{babyInfo.avatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
      <view class="avatar-edit-icon">换头像</view>
    </view>
    
    <view class="user-details">
      <!-- 展示宝宝信息 -->
      <view class="baby-info">
        <text class="baby-name">{{babyInfo.name || '柠檬宝宝'}}</text>
        <view class="baby-gender-tag">{{babyInfo.gender === 'male' ? '男孩' : '女孩'}}</view>
      </view>
      <text class="baby-birthday" wx:if="{{babyInfo.birthday}}">{{babyInfo.birthday}}</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-sections">
    <view class="menu-container" wx:for="{{visibleMenuGroups}}" wx:key="id">
      <view class="menu-section-header">
        <view class="menu-section-accent"></view>
        <text class="menu-section-title">{{item.title}}</text>
      </view>
      <view
        class="menu-item {{menuItem.action === 'share' ? 'share-item' : ''}}"
        wx:for="{{item.items}}"
        wx:for-item="menuItem"
        wx:key="id"
        data-item="{{menuItem}}"
        bindtap="handleMenuClick"
      >
        <view class="menu-content">
          <view class="menu-name">{{menuItem.name}}</view>
          <view class="menu-desc" wx:if="{{menuItem.description}}">{{menuItem.description}}</view>
        </view>
        <view class="menu-arrow">
          <image src="/images/icons/arrow-right.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>柠檬宝宝日记 v1.0.0</text>
  </view>
</view> 

<avatar-cropper
  visible="{{showAvatarCropper}}"
  imageSrc="{{avatarCropSrc}}"
  cropSize="{{300}}"
  uploading="{{uploadingAvatar}}"
  bind:close="hideAvatarCropper"
  bind:confirm="onAvatarCropped"
/>

<!-- 「同步数据」底部弹层：从其他宝宝复制库数据到当前宝宝 -->
<view class="sync-mask {{showSyncPanel ? 'show' : ''}}" bindtap="closeSyncPanel"></view>
<view class="sync-sheet {{showSyncPanel ? 'show' : ''}}">
  <view class="sync-sheet-header">
    <text class="sync-sheet-title">同步数据</text>
    <text class="sync-sheet-close" bindtap="closeSyncPanel">✕</text>
  </view>
  <view class="sync-sheet-subtitle">把其他宝宝的食物库、食谱等数据复制到「{{babyInfo.name || '当前宝宝'}}」</view>
  <baby-sync-panel
    wx:if="{{showSyncPanel}}"
    target-baby-uid="{{babyInfo.babyUid}}"
    show-run-button
    show-title="{{false}}"
    show-empty-hint
    bind:done="onSyncPanelDone"
  />
</view>
