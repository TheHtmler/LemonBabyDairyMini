<view class="report-page">
  <view wx:if="{{loading}}" class="empty-state">正在加载报告…</view>
  <block wx:else>
    <view class="main-tabs">
      <button class="main-tab {{mainTab === 'archive' ? 'active' : ''}}" data-tab="archive" bindtap="switchMainTab">报告列表</button>
      <button class="main-tab {{mainTab === 'compare' ? 'active' : ''}}" data-tab="compare" bindtap="switchMainTab">报告对比</button>
    </view>
    <view wx:if="{{loadError}}" class="error-banner"><text>{{loadError}}</text><button class="text-button" bindtap="retryReports">重试</button></view>
    <view wx:if="{{mainTab === 'archive'}}" class="archive-panel">
      <view class="type-filters">
        <button wx:for="{{reportTypeTabs}}" wx:key="key" class="type-pill {{item.active ? 'active' : ''}}" data-type="{{item.key}}" bindtap="handleTypeFilterChange">{{item.label}}<text class="count">{{item.count}}</text></button>
      </view>
      <view wx:if="{{!archiveReportCards.length && !loadError}}" class="empty-state">
        <text class="empty-title">还没有这类报告</text><text class="muted">可拍照识别或手动录入</text><button class="primary-button" bindtap="onAddReport">录入第一份报告</button>
      </view>
      <view class="report-timeline">
        <view wx:for="{{reportYearGroups}}" wx:for-item="group" wx:for-index="yearIndex" wx:key="year" class="year-group">
          <view class="year-heading">
            <text>{{group.year === '未知' ? '日期未录入' : group.year + ' 年'}}</text>
            <button wx:if="{{yearIndex === 0}}" class="add-button" bindtap="onAddReport">＋ 添加报告</button>
          </view>
          <view class="report-list">
            <button wx:for="{{group.reports}}" wx:key="reportId" class="report-row" data-report-id="{{item.reportId}}" bindtap="openDetailView">
              <text class="date-column">{{item.monthDay}}</text>
              <view class="report-body">
                <view class="report-title-row"><text class="report-name">{{item.reportTypeLabel}}</text><text class="status-badge {{item.statusClass}}">{{item.statusText}}</text></view>
                <view class="report-meta"><text>已录入 {{item.filledCount}}/{{item.totalCount}} 项</text><text wx:if="{{item.labName}}" class="lab-name">{{item.labName}}</text></view>
              </view>
              <text class="chevron">›</text>
            </button>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="compare-panel">
      <view class="type-filters">
        <button wx:for="{{compareTypeTabs}}" wx:key="key" class="type-pill {{compareReportType === item.key ? 'active' : ''}}" data-type="{{item.key}}" bindtap="handleCompareTypeChange">{{item.label}}</button>
      </view>
      <view wx:if="{{compareReportOptions.length < 2 && !loadError}}" class="empty-state">
        <text class="empty-title">{{compareReportOptions.length ? '还需要一份同类报告' : '还没有这类报告'}}</text>
        <text class="muted">两份同类报告可查看指标变化</text><button class="primary-button" bindtap="onAddReport">添加同类报告</button>
      </view>
      <block wx:if="{{compareReportOptions.length >= 2}}">
        <view class="compare-actions">
          <button class="diet-button" bindtap="openCompareDiet" disabled="{{!currentCompareView.canCompare}}"><text>检测前 7 天饮食对比</text><text>›</text></button>
          <button class="add-button" bindtap="onAddReport">＋ 添加报告</button>
        </view>
        <button class="choose-reports" bindtap="openReportChooser"><text>选择对比报告（{{compareReportIds.length}}）</text><text>＋</text></button>
        <view wx:if="{{!currentCompareView.canCompare}}" class="selection-hint">请至少选择两份同类报告。</view>
        <block wx:else>
          <view wx:if="{{currentCompareView.metricOptions.length}}" class="metric-toolbar">
            <view class="metric-modes">
              <button class="mode-button {{!compareSelectedMetricKeys.length ? 'selected' : ''}}" data-mode="all" bindtap="setCompareMetricMode">全部指标</button>
              <button class="mode-button {{compareFocusOnly ? 'selected' : ''}}" data-mode="focus" bindtap="setCompareMetricMode">重点指标</button>
            </view>
            <button class="filter-button {{compareFilterVisible || (compareSelectedMetricKeys.length && !compareFocusOnly) ? 'selected' : ''}}" bindtap="toggleCompareFilter">{{compareFilterVisible ? '收起筛选' : '自选指标'}}</button>
          </view>
          <view wx:if="{{compareFilterVisible}}" class="metric-filters"><button wx:for="{{currentCompareView.metricOptions}}" wx:key="key" class="metric-chip {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="toggleCompareMetric">{{item.name}}</button></view>
          <scroll-view scroll-x="true" enhanced="true" show-scrollbar="{{true}}" class="comparison-scroll">
            <view class="multi-table" style="width: {{currentCompareView.tableWidthRpx}}rpx;">
              <view class="multi-row multi-head">
                <view class="multi-name">检验项目 / 单位</view>
                <view wx:for="{{currentCompareView.columns}}" wx:key="reportId" class="multi-cell multi-column">
                  <button class="column-date" data-report-id="{{item.reportId}}" bindtap="openDetailView">{{item.date}} ›</button>
                  <text wx:if="{{item.labName}}" class="secondary">{{item.labName}}</text>
                  <text wx:if="{{item.sameDayLabel}}" class="secondary">{{item.sameDayLabel}}</text>
                  <button class="baseline-button {{item.isBaseline ? 'selected' : ''}}" data-report-id="{{item.reportId}}" bindtap="setCompareBaseline" disabled="{{item.isBaseline}}">{{item.isBaseline ? '对照报告' : '设为对照'}}</button>
                </view>
              </view>
              <view wx:for="{{currentCompareView.compareRows}}" wx:for-item="row" wx:key="key" class="multi-row">
                <view class="multi-name"><text>{{row.name}}</text><text wx:if="{{row.secondaryText}}" class="secondary">{{row.secondaryText}}</text><text wx:if="{{row.sharedRange}}" class="inline-range">参考范围 {{row.rangeText || '未提供'}}</text></view>
                <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="reportId" class="multi-cell">
                  <view class="value-line {{cell.status}}"><text class="number">{{cell.valueText}}</text><text wx:if="{{cell.marker}}" class="marker">{{cell.marker}}</text></view>
                  <text wx:if="{{cell.status === 'unknown'}}" class="secondary">待核对</text>
                  <text wx:if="{{!row.sharedRange}}" class="inline-range">{{cell.rangeText || '未提供'}}</text>
                  <text wx:if="{{!cell.isBaseline}}" class="cell-delta">较对照 {{cell.deltaText}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
          <view wx:if="{{!currentCompareView.metricOptions.length}}" class="empty-state"><text class="empty-title">尚无可对比指标</text><text class="muted">所选报告均未录入检测值，可进入报告编辑补充。</text></view>
          <text class="note">↑ 偏高　↓ 偏低 · 升降不代表好转或恶化。</text>
        </block>
      </block>
    </view>
  </block>
  <view wx:if="{{reportChooserVisible}}" class="diet-modal-mask" bindtap="closeReportChooser" catchtouchmove="preventScroll">
    <view class="diet-modal" catchtap="stopPropagation">
      <view class="diet-modal-heading"><text class="diet-modal-title">选择对比报告</text><button class="modal-close" bindtap="closeReportChooser">取消</button></view>
      <view class="choice-tools"><button class="text-button" bindtap="selectRecentReports">最近两份</button><button class="text-button" bindtap="selectAllReports">全选</button></view>
      <scroll-view scroll-y="true" class="report-choice-scroll">
        <button wx:for="{{reportChoiceOptions}}" wx:key="reportId" class="report-choice {{item.selected ? 'selected' : ''}}" data-report-id="{{item.reportId}}" bindtap="toggleReportChoice">
          <view class="choice-copy"><text>{{item.date}}</text><text wx:if="{{item.labName}}" class="secondary">{{item.labName}}</text><text wx:if="{{item.sameDayLabel}}" class="secondary">{{item.sameDayLabel}}</text></view>
          <text class="selection-check">{{item.selected ? '✓' : ''}}</text>
        </button>
      </scroll-view>
      <view class="choice-footer"><text class="muted">已选 {{draftReportIds.length}} 份</text><button class="add-button" bindtap="confirmReportChoices" disabled="{{draftReportIds.length < 2}}">确认对比</button></view>
    </view>
  </view>
  <view wx:if="{{compareDietVisible}}" class="diet-modal-mask" bindtap="closeCompareDiet" catchtouchmove="preventScroll">
    <view class="diet-modal" catchtap="stopPropagation">
      <view class="diet-modal-heading">
        <text class="diet-modal-title">检测前 7 天饮食对比</text>
        <button class="modal-close" bindtap="closeCompareDiet" aria-label="关闭饮食对比">关闭</button>
      </view>
      <scroll-view scroll-y="true" class="diet-modal-scroll">
        <view class="diet-modal-body">
            <text wx:if="{{compareDietLoading}}" class="note">正在加载饮食记录…</text>
            <view wx:elif="{{compareDietError}}" class="error-banner"><text>{{compareDietError}}</text><button class="text-button" bindtap="retryDiet">重试</button></view>
            <block wx:else>
              <text wx:if="{{!currentCompareView.hasNutritionData}}" class="note">未找到可计算系数的记录，请核对对应日期的饮食和体重。</text>
              <view wx:for="{{currentCompareView.nutritionCompareSeries}}" wx:key="key" class="diet-metric">
                <view class="diet-heading"><text>{{item.label}}</text><text class="secondary">{{item.unit}}</text></view>
                <view class="diet-sides"><view wx:for="{{item.sides}}" wx:for-item="side" wx:key="reportId" class="diet-side"><text class="diet-report-date">{{side.label}}{{side.isBaseline ? ' · 对照' : ''}}</text><text wx:if="{{side.labName}}" class="secondary">{{side.labName}}</text><text wx:if="{{side.sameDayLabel}}" class="secondary">{{side.sameDayLabel}}</text><text class="secondary">{{side.fullDateRange}}</text><text class="secondary">有效 {{side.coverageText}} · 均值 {{side.averageText || '—'}}</text><view class="sparkline"><view wx:for="{{side.points}}" wx:for-item="point" wx:key="date" class="spark-column"><view class="spark-track"><view class="spark-bar {{point.missing ? 'missing' : ''}}" style="height: {{point.heightRpx}}rpx;"></view></view><text class="secondary">{{point.label}}</text></view></view></view></view>
              </view>
              <text class="note">各指标仅统计有效记录；历史系数使用对应日期汇总中的体重，不推断饮食与化验变化的因果关系。</text>
            </block>
        </view>
      </scroll-view>
    </view>
  </view>
  <view wx:if="{{typePickerVisible}}" class="report-type-mask" bindtap="onCloseTypePicker" catchtouchmove="preventScroll">
    <view class="report-type-sheet" catchtap="stopPropagation">
      <text class="sheet-title">选择报告类型</text>
      <button wx:for="{{reportEntryTypes}}" wx:key="key" class="report-type-item" data-type="{{item.key}}" bindtap="onSelectReportType">{{item.name}}<text>›</text></button>
      <button class="text-button full-width" bindtap="onCloseTypePicker">取消</button>
    </view>
  </view>
</view>
