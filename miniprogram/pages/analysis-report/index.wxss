page { background: #faf6ed; color: #283b32; font-size: 26rpx; }
.report-page { width: 100%; min-width: 0; padding: 8rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.report-page view { box-sizing: border-box; }
/* 统一原生按钮尺寸，防止默认宽度和边距挤压紧凑布局。 */
.report-page button[class] { display: flex; align-items: center; justify-content: center; width: auto; height: auto; min-width: 0; max-width: 100%; margin: 0; padding: 0; box-sizing: border-box; font-size: inherit; font-weight: 400; line-height: 1.3; background: transparent; color: inherit; border-radius: 0; }
.report-page button::after { border: 0; }
.report-page button[disabled] { opacity: .45; }
.report-page button:active { opacity: .75; }
.report-page .main-tabs { display: flex; margin-bottom: 12rpx; border-bottom: 1rpx solid #d5dccf; }
.report-page button.main-tab { flex: 1 1 0%; min-height: 88rpx; padding: 0 16rpx; position: relative; color: #5f6d5c; font-size: 27rpx; }
.report-page .main-tab.active { color: #283b32; font-weight: 600; }
.report-page .main-tab.active::before { content: ''; position: absolute; bottom: -1rpx; height: 4rpx; left: 28%; right: 28%; border-radius: 4rpx; background: #376c55; }
.report-page .muted, .report-page .secondary { font-size: 22rpx; color: #5f6d5c; line-height: 1.5; }
.report-page .secondary { display: block; font-weight: 400; margin-top: 4rpx; overflow-wrap: break-word; }
