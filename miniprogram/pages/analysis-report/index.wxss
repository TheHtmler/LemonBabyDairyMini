.report-page .report-type-picker { flex: 1; min-width: 0; }
.report-page .toolbar-select { display: flex; align-items: center; gap: 12rpx; min-height: 76rpx; padding: 0 8rpx; font-size: 27rpx; font-weight: 500; }
.report-page .toolbar-select > text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.report-page .down-chevron { flex: 0 0 10rpx; width: 10rpx; height: 10rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: translateY(-3rpx) rotate(45deg); margin: 0 4rpx; }
.report-page .small-chevron, .report-page .metric-chevron { flex: 0 0 9rpx; width: 9rpx; height: 9rpx; border-right: 2rpx solid currentColor; border-top: 2rpx solid currentColor; transform: rotate(45deg); }
.report-page button.choose-reports { flex: 0 0 auto; gap: 12rpx; min-height: 76rpx; padding: 0 8rpx; color: #376c55; font-size: 24rpx; white-space: nowrap; }
