.report-page .comparison-scroll { width: 100%; min-width: 0; background: #fffdf8; }
.report-page .table-body { position: relative; }
/* 露出下一列、边缘渐隐及常驻滚动轨道共同提示横向滚动。 */
.report-page .scroll-edge { position: absolute; top: 0; bottom: 0; width: 28rpx; pointer-events: none; z-index: 5; }
