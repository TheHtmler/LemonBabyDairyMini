.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  background: #FFFDF7;
  box-sizing: border-box;
}

.tip {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FFF3C4;
  color: #8A6A00;
  font-size: 24rpx;
  line-height: 1.5;
}

.panel {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #5A4200;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.label-row,
.advanced-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.link {
  color: #FFB800;
  font-size: 26rpx;
}

.cover-box,
.step-image-box {
  height: 320rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-image-box {
  height: 200rpx;
}

.cover,
.step-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  color: #A08A4A;
  font-size: 26rpx;
}

.compact-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.compact-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.ing-head,
.ing-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ing-head {
  margin-bottom: 12rpx;
  color: #A08A4A;
  font-size: 24rpx;
}

.ing-col-name,
.ing-name {
  flex: 1.4;
}

.ing-col-qty,
.ing-qty {
  flex: 1;
}

.ing-row {
  margin-bottom: 12rpx;
}

.ing-name {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ing-qty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.qty-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.qty-unit {
  color: #8A6A00;
  font-size: 24rpx;
}

.ing-empty {
  padding: 24rpx 0;
  color: #A08A4A;
  font-size: 26rpx;
  text-align: center;
}

.ing-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.step-block {
  margin-bottom: 12rpx;
}

.step-add-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.step-label {
  font-size: 26rpx;
  color: #FFB800;
  font-weight: 600;
}

.step-image-actions {
  display: flex;
  gap: 24rpx;
  margin: 10rpx 0 12rpx;
}

.remove {
  color: #C48A00;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  color: #8A6A00;
  font-size: 24rpx;
}

.tag.active {
  background: #FFB800;
  color: #5A4200;
  font-weight: 600;
}

.nutrition-bar {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  color: #8A6A00;
  font-size: 22rpx;
  line-height: 1.5;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 247, 0.96);
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #FFB800;
  color: #5A4200;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.save-btn::after {
  border: none;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  max-height: 70vh;
  overflow-y: auto;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5A4200;
}

.sheet-tip {
  margin: 8rpx 0 20rpx;
  color: #A08A4A;
  font-size: 24rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #FFF3C4;
}

.sheet-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.sheet-ops {
  display: flex;
  gap: 12rpx;
}

.sheet-btn {
  font-size: 24rpx;
  color: #8A6A00;
  padding: 8rpx 10rpx;
}

.sheet-btn.danger {
  color: #C45A00;
}

.sheet-close {
  width: 100%;
  margin: 24rpx 0 0;
  padding: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #FFB800;
  color: #5A4200;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.sheet-close::after {
  border: none;
}
