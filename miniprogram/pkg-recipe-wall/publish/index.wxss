.page {
  min-height: 100vh;
  padding: 20rpx 22rpx calc(220rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 88% 6%, rgba(255, 232, 143, 0.42), transparent 28%),
    linear-gradient(180deg, #FFF8E8 0%, #FFFDF7 48%, #FFFFFF 100%);
  box-sizing: border-box;
}

.hero-card {
  margin-bottom: 16rpx;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 12% 20%, rgba(255, 231, 156, 0.55), transparent 40%),
    linear-gradient(135deg, #FFFDF5, #FFE7A8);
  border: 2rpx solid rgba(255, 184, 0, 0.18);
  box-shadow: 0 10rpx 22rpx rgba(255, 184, 0, 0.1);
  box-sizing: border-box;
}

.hero-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-badge {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #FFE27A, #FFB800);
  color: #3F2C00;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -4rpx 0 rgba(230, 150, 0, 0.16);
}

.hero-copy {
  min-width: 0;
}

.hero-title,
.section-title {
  color: #332600;
  font-weight: 800;
}

.hero-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.2;
}

.hero-subtitle,
.section-tip,
.field-label {
  color: #7C6B45;
  font-size: 22rpx;
}

.hero-subtitle {
  display: block;
  margin-top: 8rpx;
  line-height: 1.4;
}

.tip {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #FFF3C4;
  border: 2rpx solid rgba(255, 184, 0, 0.22);
  color: #8A6200;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.panel {
  margin-bottom: 16rpx;
  padding: 22rpx 20rpx 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 184, 0, 0.1);
  box-shadow: 0 8rpx 18rpx rgba(255, 184, 0, 0.07);
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.section-head.compact {
  margin-bottom: 0;
  flex: 1;
  min-width: 0;
}

.section-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #FFE27A, #FFB800);
  color: #3F2C00;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.section-index.soft {
  background: #FFF3C4;
  color: #8A6200;
  letter-spacing: -2rpx;
}

.section-titles {
  min-width: 0;
}

.section-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.25;
}

.section-tip {
  display: block;
  margin-top: 6rpx;
  line-height: 1.35;
}

.label-row,
.advanced-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.link {
  color: #C48A00;
  font-size: 26rpx;
  font-weight: 600;
}

.link-btn {
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #FFF3C4;
  color: #8A6200;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 68rpx;
  box-sizing: border-box;
}

.cover-box,
.step-image-box {
  position: relative;
  height: 340rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(180deg, #FFFDF5 0%, #FFF3C4 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 184, 0, 0.38);
  box-sizing: border-box;
}

.cover-box.has-image,
.step-image-box.has-image {
  border-style: solid;
  border-color: rgba(255, 184, 0, 0.16);
}

.step-image-box {
  height: 200rpx;
}

.cover,
.step-image {
  width: 100%;
  height: 100%;
}

.cover-empty,
.step-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.cover-camera {
  width: 64rpx;
  height: 48rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #FFE08A;
  position: relative;
  box-shadow: inset 0 -3rpx 0 rgba(230, 150, 0, 0.14);
}

.cover-camera::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin: -11rpx 0 0 -11rpx;
  border-radius: 50%;
  border: 4rpx solid #8A6200;
  box-sizing: border-box;
}

.cover-camera::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 18rpx;
  width: 18rpx;
  height: 10rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: #FFE08A;
}

.cover-placeholder {
  color: #8A6200;
  font-size: 28rpx;
  font-weight: 600;
}

.cover-hint {
  margin-top: 8rpx;
  color: #B08F3A;
  font-size: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
}

.field-label.spaced {
  margin-top: 20rpx;
}

.compact-input,
.compact-textarea {
  width: 100%;
  padding: 0 20rpx;
  background: #FFF9EA;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 184, 0, 0.14);
  box-sizing: border-box;
  font-size: 28rpx;
  color: #332600;
}

.compact-input {
  height: 72rpx;
}

.compact-textarea {
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
}

.step-text {
  min-height: 140rpx;
}

.ing-head,
.ing-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.ing-head {
  margin-bottom: 12rpx;
  padding: 0 4rpx;
  color: #A08A4A;
  font-size: 22rpx;
}

.ing-col-name,
.ing-name {
  flex: 1.4;
  min-width: 0;
}

.ing-col-qty,
.ing-qty {
  flex: 1;
  min-width: 0;
}

.ing-row {
  margin-bottom: 12rpx;
}

.ing-name {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 18rpx;
  background: #FFF9EA;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 184, 0, 0.12);
  font-size: 28rpx;
  color: #332600;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ing-qty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 14rpx;
  background: #FFF9EA;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 184, 0, 0.12);
  box-sizing: border-box;
}

.qty-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #332600;
}

.qty-unit {
  color: #8A6200;
  font-size: 24rpx;
  font-weight: 600;
}

.ing-empty {
  padding: 28rpx 12rpx;
  color: #A08A4A;
  font-size: 26rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #FFFDF5;
  border: 2rpx dashed rgba(255, 184, 0, 0.28);
  box-sizing: border-box;
}

.ing-actions,
.step-add-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ing-actions {
  justify-content: space-between;
}

.ghost-btn {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  color: #8A6200;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
  border: 2rpx solid rgba(255, 184, 0, 0.16);
  box-sizing: border-box;
}

.ghost-btn.primary {
  background: linear-gradient(135deg, #FFE27A, #FFB800);
  color: #3F2C00;
  border-color: transparent;
  font-weight: 700;
}

.step-block {
  margin-bottom: 8rpx;
  padding-bottom: 8rpx;
}

.step-block + .step-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(255, 184, 0, 0.16);
}

.step-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #FFF3C4;
  color: #8A6200;
  font-size: 24rpx;
  font-weight: 700;
}

.step-image-actions {
  display: flex;
  gap: 24rpx;
  margin: 10rpx 0 12rpx;
}

.remove {
  color: #C48A00;
  font-size: 24rpx;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFD45A, #FFB800);
  color: #3F2C00;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-tag-remove {
  font-size: 28rpx;
  line-height: 1;
  padding: 0 2rpx;
}

.custom-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.custom-tag-input {
  flex: 1;
}

.suggest-label {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #A08A4A;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #FFF9EA;
  color: #8A6200;
  font-size: 24rpx;
  border: 2rpx solid rgba(255, 184, 0, 0.12);
  box-sizing: border-box;
}

.tag.active {
  background: linear-gradient(135deg, #FFE27A, #FFB800);
  color: #3F2C00;
  font-weight: 700;
  border-color: transparent;
}

.advanced-body {
  padding-top: 8rpx;
}

.nutrition-card {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 10% 20%, rgba(255, 232, 150, 0.45), transparent 42%),
    #FFFFFF;
  border: 2rpx solid rgba(255, 184, 0, 0.14);
  box-shadow: 0 8rpx 18rpx rgba(255, 184, 0, 0.07);
  box-sizing: border-box;
}

.nutrition-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #332600;
}

.nutrition-grid {
  display: flex;
  gap: 12rpx;
}

.nutrition-item {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: #FFF9EA;
  text-align: center;
  box-sizing: border-box;
}

.nutrition-value {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #8A6200;
  font-variant-numeric: tabular-nums;
}

.nutrition-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A08A4A;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 12;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 253, 247, 0.72), rgba(255, 253, 247, 0.98) 36%);
  box-sizing: border-box;
}

.footer-actions.keyboard-open {
  display: none;
}

.draft-btn,
.save-btn {
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.draft-btn {
  flex: 0.9;
  background: #FFF3C4;
  color: #8A6200;
  border: 2rpx solid rgba(255, 184, 0, 0.28);
}

.save-btn {
  flex: 1.2;
  background: linear-gradient(135deg, #FFD45A, #FFB800 55%, #F0A800);
  color: #3F2C00;
  box-shadow: 0 12rpx 24rpx rgba(255, 184, 0, 0.32);
}

.draft-btn::after,
.save-btn::after {
  border: none;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 28, 0, 0.42);
  z-index: 20;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  max-height: 70vh;
  overflow-y: auto;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFDF7;
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 184, 0, 0.35);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #332600;
}

.sheet-tip {
  margin: 8rpx 0 16rpx;
  color: #A08A4A;
  font-size: 24rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(255, 184, 0, 0.1);
}

.sheet-name {
  flex: 1;
  font-size: 28rpx;
  color: #332600;
}

.sheet-ops {
  display: flex;
  gap: 8rpx;
}

.sheet-btn {
  font-size: 24rpx;
  color: #8A6200;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #FFF3C4;
}

.sheet-btn.danger {
  color: #C45A00;
  background: #FFE8D6;
}

.sheet-close {
  width: 100%;
  margin: 24rpx 0 0;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFD45A, #FFB800);
  color: #3F2C00;
  font-size: 28rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.sheet-close::after {
  border: none;
}

.press-soft {
  transform: scale(0.97);
  opacity: 0.92;
}
