.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #FFFDF7;
  box-sizing: border-box;
}

.tip {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FFF3C4;
  color: #8A6A00;
  font-size: 24rpx;
  line-height: 1.5;
}

.panel {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #5A4200;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.link {
  color: #FFB800;
  font-size: 26rpx;
}

.cover-box,
.step-image-box {
  height: 280rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover,
.step-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  color: #A08A4A;
  font-size: 26rpx;
}

.compact-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.compact-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  color: #8A6A00;
  font-size: 24rpx;
}

.tag.active {
  background: #FFB800;
  color: #5A4200;
  font-weight: 600;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.half {
  flex: 1;
}

.remove {
  color: #C48A00;
  font-size: 24rpx;
  padding: 8rpx;
}

.step-block {
  margin-bottom: 24rpx;
}

.step-label {
  font-size: 26rpx;
  color: #FFB800;
  font-weight: 600;
}

.step-image-box {
  margin-top: 12rpx;
  height: 200rpx;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 247, 0.96);
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #FFB800;
  color: #5A4200;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.save-btn::after {
  border: none;
}
