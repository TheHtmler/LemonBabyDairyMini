.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #FFFDF7;
  box-sizing: border-box;
}

.state {
  padding: 100rpx 24rpx;
  text-align: center;
  color: #999;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  color: #5A4200;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  display: block;
  color: #A08A4A;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 0, 0.08);
}

.cover {
  width: 100%;
  height: 240rpx;
  background: #FFF3C4;
  display: block;
}

.body {
  padding: 20rpx 24rpx 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.status {
  font-size: 22rpx;
  color: #5A8A3A;
  background: #EEF8E8;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.status.down {
  color: #A05A00;
  background: #FFF3C4;
}

.meta {
  display: block;
  margin: 10rpx 0 16rpx;
  color: #A08A4A;
  font-size: 24rpx;
}

.delete-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: #FFF8E1;
  color: #8A6A00;
  font-size: 26rpx;
  box-sizing: border-box;
}

.delete-btn::after {
  border: none;
}
