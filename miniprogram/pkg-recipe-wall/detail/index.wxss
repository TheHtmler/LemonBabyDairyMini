.page {
  min-height: 100vh;
  background: #FFFDF7;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.cover {
  width: 100%;
  height: 420rpx;
  background: #FFF3C4;
  display: block;
}

.panel {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 0, 0.08);
  box-sizing: border-box;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.tag {
  font-size: 22rpx;
  color: #8A6A00;
  background: #FFF3C4;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.authorLabel {
  display: block;
  margin-top: 12rpx;
  color: #A08A4A;
  font-size: 26rpx;
}

.like-row {
  margin-top: 20rpx;
}

.like-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #FFF8E1;
  color: #8A6A00;
  font-size: 28rpx;
  box-sizing: border-box;
}

.like-btn::after {
  border: none;
}

.like-btn.liked {
  background: #FFB800;
  color: #5A4200;
  font-weight: 600;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4200;
  margin-bottom: 16rpx;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FFF3C4;
  font-size: 28rpx;
}

.ing-name {
  color: #333;
}

.ing-amount {
  color: #999;
}

.step {
  margin-bottom: 24rpx;
}

.step-index {
  display: block;
  font-size: 24rpx;
  color: #FFB800;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.step-text {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

.step-image {
  margin-top: 12rpx;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
}

.state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #999;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  color: #5A4200;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  display: block;
  color: #A08A4A;
  font-size: 26rpx;
}
