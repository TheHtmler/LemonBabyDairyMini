<view class="page">
  <view class="tip">仅开发者可见。下架后普通用户无法浏览该食谱。</view>

  <view wx:if="{{loading}}" class="state">加载中...</view>

  <view wx:elif="{{empty}}" class="state">当前没有可下架的已发布食谱</view>

  <view wx:else class="list">
    <view class="card" wx:for="{{posts}}" wx:key="id">
      <image class="cover" src="{{item.coverFileId}}" mode="aspectFill" />
      <view class="body">
        <text class="title">{{item.title}}</text>
        <text class="meta">{{item.authorLabel}} · 赞 {{item.likeCount}}</text>
        <button class="danger-btn" data-id="{{item.id}}" bindtap="onTakeDown">下架</button>
      </view>
    </view>
  </view>
</view>
