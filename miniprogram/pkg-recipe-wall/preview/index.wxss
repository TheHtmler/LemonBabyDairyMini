.page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: #FFFDF7;
  box-sizing: border-box;
}

.cover {
  width: 100%;
  height: 420rpx;
  background: #FFF3C4;
  display: block;
}

.panel {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #FFF3C4;
  color: #8A6A00;
  font-size: 22rpx;
}

.authorLabel {
  display: block;
  margin-top: 10rpx;
  color: #A08A4A;
  font-size: 26rpx;
}

.desc {
  display: block;
  margin-top: 16rpx;
  color: #555;
  font-size: 28rpx;
  line-height: 1.6;
}

.meta-row {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  color: #8A6A00;
  font-size: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4200;
  margin-bottom: 16rpx;
}

.nutrition-grid {
  display: flex;
  gap: 12rpx;
}

.nutri-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  background: #FFF8E1;
  border-radius: 16rpx;
}

.nutri-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5A4200;
}

.nutri-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A08A4A;
}

.ingredient {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FFF3C4;
  font-size: 28rpx;
}

.ing-name { color: #333; }
.ing-amount { color: #999; }

.step {
  margin-bottom: 24rpx;
}

.step-index {
  display: block;
  font-size: 24rpx;
  color: #FFB800;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.step-image {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  margin-bottom: 10rpx;
}

.step-text {
  display: block;
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 247, 0.96);
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #FFB800;
  color: #5A4200;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.save-btn::after {
  border: none;
}
