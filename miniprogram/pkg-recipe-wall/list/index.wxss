.page {
  min-height: 100vh;
  padding: 0 20rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF3C4 0%, #FFFDF7 28%, #FFFFFF 100%);
}

.header {
  padding: 20rpx 0 8rpx;
  position: sticky;
  top: 0;
  z-index: 5;
  background: linear-gradient(180deg, #FFF3C4 0%, #FFF8E1 70%, rgba(255, 253, 247, 0.96) 100%);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.brand-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #5A4200;
  line-height: 1.2;
}

.brand-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A08A4A;
}

.mine-link {
  font-size: 26rpx;
  color: #8A6A00;
  padding: 8rpx 4rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 10rpx 10rpx 20rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(255, 184, 0, 0.12);
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: #333;
}

.search-action {
  font-size: 24rpx;
  color: #A08A4A;
  padding: 8rpx 10rpx;
}

.search-action.primary {
  color: #5A4200;
  font-weight: 600;
  background: #FFE08A;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.tag-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
  width: 100%;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #8A6A00;
  font-size: 24rpx;
  box-sizing: border-box;
}

.filter-chip.active {
  background: #FFB800;
  color: #5A4200;
  font-weight: 600;
}

.filter-tip {
  display: block;
  margin: 10rpx 4rpx 0;
  font-size: 20rpx;
  color: #B59A55;
}

.state {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  color: #5A4200;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-tip {
  display: block;
  color: #A08A4A;
  margin-bottom: 28rpx;
}

.empty-btn {
  width: 280rpx;
  margin: 0 auto;
  padding: 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #FFB800;
  color: #5A4200;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.empty-btn::after {
  border: none;
}

.waterfall {
  column-count: 2;
  column-gap: 16rpx;
  margin-top: 8rpx;
}

.card {
  break-inside: avoid;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 0, 0.1);
}

.cover-wrap {
  position: relative;
}

.cover {
  width: 100%;
  background: #FFF3C4;
  display: block;
}

.cover-tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(90, 66, 0, 0.72);
  color: #FFF8E1;
  font-size: 20rpx;
}

.card-body {
  padding: 16rpx 18rpx 18rpx;
}

.title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.35;
}

.authorLabel {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A08A4A;
  line-height: 1.3;
}

.card-foot {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.like-btn {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF8E1;
  color: #8A6A00;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.like-btn.liked {
  background: #FFB800;
  color: #5A4200;
  font-weight: 600;
}

.likeCount {
  font-variant-numeric: tabular-nums;
}

.tip {
  padding: 24rpx;
  font-size: 24rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10;
  min-width: 112rpx;
  height: 112rpx;
  padding: 0 20rpx;
  border-radius: 56rpx;
  background: #FFB800;
  box-shadow: 0 12rpx 28rpx rgba(255, 184, 0, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.fab-plus {
  font-size: 40rpx;
  line-height: 1;
  color: #5A4200;
  font-weight: 600;
}

.fab-text {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #5A4200;
  font-weight: 600;
}
