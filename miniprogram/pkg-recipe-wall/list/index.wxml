<view class="page">
  <view class="header">
    <view class="header-top">
      <view class="brand">
        <text class="brand-title">食谱墙</text>
        <text class="brand-sub">0-10 岁孩子的每日灵感</text>
      </view>
      <text class="mine-link" bindtap="goMine">我的发布</text>
    </view>

    <view class="search-bar">
      <input
        class="search-input"
        confirm-type="search"
        placeholder="搜索菜名、描述、食材"
        value="{{keywordInput}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
      />
      <text class="search-action" wx:if="{{keyword || keywordInput}}" bindtap="onClearSearch">清除</text>
      <text class="search-action primary" bindtap="onSearchConfirm">搜索</text>
    </view>

    <view class="filter-row">
      <view
        class="filter-chip {{filter === item.value ? 'active' : ''}}"
        wx:for="{{filterOptions}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onSelectFilter"
      >{{item.name}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中...</view>

  <view wx:elif="{{empty}}" class="state empty">
    <text class="empty-title">{{keyword || filter === 'liked' ? '没有符合条件的食谱' : '还没有食谱'}}</text>
    <text class="empty-tip">{{filter === 'liked' ? (keyword ? '换个关键词试试' : '去给喜欢的食谱点个赞吧') : (keyword ? '换个关键词试试' : '来分享 0-10 岁孩子的日常食谱吧')}}</text>
    <button class="empty-btn" wx:if="{{!keyword && filter !== 'liked'}}" bindtap="goPublish">去发布</button>
  </view>

  <view wx:else class="waterfall">
    <view
      class="card"
      wx:for="{{posts}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="cover-wrap">
        <image
          class="cover"
          style="height: {{item.coverHeight}}rpx;"
          src="{{item.coverFileId}}"
          mode="aspectFill"
        />
        <text class="cover-tag" wx:if="{{item.tagText}}">{{item.tagText}}</text>
      </view>
      <view class="card-body">
        <text class="title">{{item.title}}</text>
        <text class="authorLabel">{{item.authorLabel}}</text>
        <view class="card-foot">
          <view
            class="like-btn {{item.liked ? 'liked' : ''}}"
            data-id="{{item.id}}"
            catchtap="onToggleLike"
          >
            <text>{{item.liked ? '已赞' : '赞'}}</text>
            <text class="likeCount">{{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="state tip" wx:if="{{loadingMore}}">加载更多...</view>
  <view class="state tip" wx:elif="{{!hasMore && posts.length}}">没有更多了</view>

  <view class="fab" bindtap="goPublish">
    <text class="fab-plus">+</text>
    <text class="fab-text">发布</text>
  </view>
</view>
