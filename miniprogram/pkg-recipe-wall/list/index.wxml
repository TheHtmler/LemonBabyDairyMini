<view class="page">
  <view class="toolbar">
    <button class="tool-btn ghost" bindtap="goMine">我的</button>
    <button class="tool-btn primary" bindtap="goPublish">发布</button>
  </view>

  <view wx:if="{{loading}}" class="state">加载中...</view>

  <view wx:elif="{{empty}}" class="state empty">
    <text class="empty-title">还没有食谱</text>
    <text class="empty-tip">来发布第一条辅食 / 低蛋白友好食谱吧</text>
    <button class="tool-btn primary empty-btn" bindtap="goPublish">去发布</button>
  </view>

  <view wx:else class="feed">
    <view
      class="card"
      wx:for="{{posts}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image class="cover" src="{{item.coverFileId}}" mode="aspectFill" />
      <view class="card-body">
        <view class="title-row">
          <text class="title">{{item.title}}</text>
          <text class="tag" wx:if="{{item.tags[0]}}">{{item.tags[0]}}</text>
        </view>
        <text class="authorLabel">{{item.authorLabel}}</text>
        <view class="card-foot">
          <view
            class="like-btn {{item.liked ? 'liked' : ''}}"
            data-id="{{item.id}}"
            catchtap="onToggleLike"
          >
            <text>{{item.liked ? '已赞' : '点赞'}}</text>
            <text class="likeCount">{{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="state tip" wx:if="{{loadingMore}}">加载更多...</view>
    <view class="state tip" wx:elif="{{!hasMore && posts.length}}">没有更多了</view>
  </view>
</view>
