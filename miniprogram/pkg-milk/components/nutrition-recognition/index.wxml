<view class="recognition-root">
  <view class="recovery-banner" wx:if="{{purpose !== 'preview' && recoveryPending}}"><text>上次资料的保存结果待确认</text><button class="primary-button" catchtap="recoverFormSave" disabled="{{recoveryBusy}}" loading="{{recoveryBusy}}">恢复保存状态</button></view>
  <view class="recognition-entry" wx:if="{{showTrigger}}">
    <view><text class="entry-title">拍照填写营养</text><text class="entry-hint">拍照或选图，自动填写</text></view>
    <button class="entry-button" size="mini" bindtap="startRecognition" disabled="{{busy}}" loading="{{busy}}">拍照 / 选图</button>
  </view>
  <view class="recognition-overlay {{previewOnly ? 'photo-overlay' : ''}}" wx:if="{{dialogOpen}}">
    <block wx:if="{{previewOnly}}">
      <image class="recognition-photo {{previewScanning ? '' : packagePhotoNeeded && previewEmptyNutrition ? 'photo-needs-label' : !identityVisible ? 'photo-error' : 'photo-with-result'}}" style="{{previewPhotoStyle}}" src="{{previewPhoto}}" mode="aspectFit" />
      <view class="recognition-photo-shade"></view>
      <button class="photo-back" style="{{navigationTop > 0 ? 'top:' + navigationTop + 'px;height:' + navigationHeight + 'px;' : ''}}" catchtap="cancelDialog" aria-label="返回拍照" disabled="{{saving || pendingSave}}"><image class="back-icon" src="/pkg-milk/nutrition-scan/back.png" mode="aspectFit" aria-hidden="true"></image></button>
      <view class="scan-feedback" style="{{scanFeedbackStyle}}" wx:if="{{previewScanning}}" aria-live="polite">
        <view class="scan-grid" aria-hidden="true"></view>
        <view class="scan-sweep" aria-hidden="true"><view class="scan-laser"></view></view>
        <view class="scan-orbit" style="{{scanOrbitStyle}}" aria-hidden="true">
          <view class="scan-ring scan-ring-outer"></view>
          <view class="scan-ring scan-ring-inner"></view>
          <view class="scan-crosshair"></view>
        </view>
        <view class="scan-corner corner-top-left" aria-hidden="true"></view>
        <view class="scan-corner corner-top-right" aria-hidden="true"></view>
        <view class="scan-corner corner-bottom-left" aria-hidden="true"></view>
        <view class="scan-corner corner-bottom-right" aria-hidden="true"></view>
        <view class="scan-phase"><view class="scan-status-dot" aria-hidden="true"></view><text>{{longWaiting ? '仍在处理，请稍候' : scanPhase}}</text></view>
      </view>
    </block>
    <view class="recognition-mask" wx:if="{{!previewScanning}}" catchtap="cancelDialog" catchtouchmove="stopPropagation"></view>
    <view wx:if="{{!previewScanning}}" class="recognition-dialog {{previewOnly ? 'preview-dialog' : ''}} {{previewOnly && !identityVisible ? 'preview-error-dialog' : ''}} {{previewOnly && packagePhotoNeeded && previewEmptyNutrition ? 'preview-photo-required' : ''}}" style="{{keyboardHeight ? 'bottom:' + keyboardHeight + 'px;height:calc(88vh - ' + keyboardHeight + 'px);max-height:calc(88vh - ' + keyboardHeight + 'px);' : ''}}" role="dialog" aria-label="营养识别与核对">
      <view class="preview-grip" wx:if="{{previewOnly}}" aria-hidden="true"></view>
      <view class="dialog-header" wx:else>
        <text class="dialog-title">{{purpose === 'preview' ? (displayMode === 'powder_label' ? '添加奶粉' : '添加食物') : (displayMode === 'powder_label' ? '填写奶粉营养' : '填写食物营养')}}</text>
        <text class="dialog-baby" wx:if="{{purpose === 'preview' && babyName}}">{{babyName}}</text>
        <button class="close-button" catchtap="cancelDialog" aria-label="关闭识别弹窗"><view class="close-icon"></view></button>
      </view>
      <scroll-view class="dialog-body" scroll-y="true" scroll-into-view="{{scrollToField}}" scroll-with-animation="{{false}}">
        <text class="preview-note" wx:if="{{longWaiting}}" aria-live="polite">仍在处理中，请稍候</text>
        <view class="error-row" wx:if="{{error}}"><text class="error-text">{{error}}</text><button wx:if="{{canRetryRecognition}}" class="retry-button" catchtap="retryRecognition" disabled="{{busy}}">{{retryRecognitionRequired ? '重新识别' : '重试'}}</button></view>
        <button wx:if="{{canRestoreDraft}}" class="text-button" catchtap="restorePreviousDraft" disabled="{{busy}}">恢复重新识别前的草稿</button>
        <view class="reference-warning" wx:if="{{!previewOnly && labelFillWarning}}"><text>{{labelFillWarning}}</text></view>
        <view wx:if="{{!previewOnly && canRetryReference}}" class="reference-warning"><text>营养查询失败</text><button class="text-button" catchtap="retryReference" disabled="{{busy}}">重试查询</button></view>
        <view wx:if="{{existingItem}}" class="duplicate-panel"><text>已有相同身份资料：{{existingItem.name}}</text><button class="text-button" catchtap="openDuplicate" disabled="{{busy}}">查看已有资料</button></view>
        <view wx:if="{{duplicateReview}}" class="duplicate-panel">
          <text>找到 {{duplicateReview.total}} 条相近资料，请先核对身份。</text>
          <view wx:for="{{duplicateReview.candidates}}" wx:key="itemId"><text class="duplicate-name">{{item.name}}</text><text class="preview-note">{{item.identity.brand}} {{item.identity.series}} {{item.identity.stage}} {{item.identity.barcode}}</text><button class="text-button" data-index="{{index}}" catchtap="openDuplicate" disabled="{{busy}}">查看这条资料</button></view>
          <button wx:if="{{duplicateReview.canConfirm}}" class="text-button" catchtap="confirmDifferentIdentity" disabled="{{busy}}">已核对，确实是不同物品</button>
          <text wx:else class="preview-note">相近条目较多，请先补充准确名称或产品身份。</text>
          <button wx:if="{{!previewOnly && displayMode !== 'food_object'}}" class="text-button" catchtap="openProductDetails" disabled="{{busy}}">修改品牌或规格</button>
        </view>
        <view class="image-upload-view" wx:if="{{!previewOnly && !identityVisible}}">
          <view class="image-list"><image class="image-preview" wx:for="{{imagePaths}}" wx:key="*this" src="{{item}}" mode="aspectFill" /></view>
          <view class="upload-info"><view class="module-status {{busy ? 'loading' : uploadStatus}}"><view class="spinner" wx:if="{{busy}}"></view><text>{{busy ? scanPhase : uploadText}}</text></view></view>
        </view>

        <view class="preview-section" wx:if="{{previewOnly && identityVisible}}">
          <text class="preview-title">{{previewName}}</text>
          <view class="preview-basis-tabs" wx:if="{{!needType && previewBasisOptions.length}}">
            <button wx:for="{{previewBasisOptions}}" wx:key="value" class="basis-tab {{previewBasisMode === item.value ? 'selected' : ''}}" data-mode="{{item.value}}" catchtap="onPreviewBasisChange" disabled="{{busy}}" aria-pressed="{{previewBasisMode === item.value}}">{{item.label}}</button>
          </view>
          <text class="preview-basis" wx:elif="{{!needType && (!packagePhotoNeeded || !previewEmptyNutrition)}}">{{previewBasis}}</text>
          <block wx:if="{{!needType}}">
            <view class="preview-nutrition-status" wx:if="{{!packagePhotoNeeded && (nutritionLoading || previewNutritionHint)}}">
              <view class="module-status loading" wx:if="{{nutritionLoading}}" aria-live="polite"><view class="spinner"></view><text>{{scanPhase}}</text></view>
              <view class="preview-short-hint" wx:else><text>{{previewNutritionHint}}</text><button wx:if="{{canRetryReference && !labelFillWarning && !needIdentity && !needBasis}}" class="text-button" catchtap="retryReference" disabled="{{busy}}">重试</button></view>
            </view>
            <view class="nutrition-photo-prompt" wx:if="{{packagePhotoNeeded}}">
              <text class="nutrition-photo-title">{{nutritionLoading ? '正在查找该商品的营养资料' : packagePhotoTitle}}</text>
              <text class="nutrition-photo-hint">{{packagePhotoHint}}</text>
              <button wx:if="{{canRetryReference && !needIdentity}}" class="text-button" catchtap="retryReference" disabled="{{busy || pendingSave}}">重试查询</button>
              <button wx:if="{{needsProductPhoto && !identityEditorOpen}}" class="text-button" catchtap="openIdentityEditor" disabled="{{busy || pendingSave}}">手动填写名称</button>
              <button wx:elif="{{!needIdentity}}" class="text-button" catchtap="beginPreviewSave" disabled="{{busy || pendingSave}}">手动填写</button>
            </view>
            <block wx:if="{{!packagePhotoNeeded || !previewEmptyNutrition}}">
            <view class="preview-highlights">
              <view class="preview-highlight highlight-energy">
                <text class="highlight-label">热量</text>
                <view class="highlight-reading"><text class="highlight-value {{previewCalories.hasValue ? '' : 'unrecognized'}}">{{previewCalories.value}}</text><text class="highlight-unit" wx:if="{{previewCalories.hasValue}}">{{previewCalories.unit}}</text></view>
                <text class="nutrient-note" wx:if="{{previewCalories.note}}">{{previewCalories.note}}</text>
              </view>
              <view class="preview-highlight highlight-protein">
                <text class="highlight-label">蛋白质</text>
                <view class="highlight-reading"><text class="highlight-value {{previewProtein.hasValue ? '' : 'unrecognized'}}">{{previewProtein.value}}</text><text class="highlight-unit" wx:if="{{previewProtein.hasValue}}">{{previewProtein.unit}}</text></view>
                <text class="protein-type" wx:if="{{previewProteinType}}">{{previewProteinType}}</text>
                <text class="nutrient-note" wx:if="{{previewProtein.note}}">{{previewProtein.note}}</text>
              </view>
            </view>
            <view class="preview-macros">
              <view class="macro-item" wx:for="{{previewMacros}}" wx:key="path">
                <view class="macro-reading"><text class="macro-value {{item.hasValue ? '' : 'unrecognized'}}">{{item.value}}</text><text class="macro-unit" wx:if="{{item.hasValue}}">{{item.unit}}</text></view>
                <text class="macro-label">{{item.label}}</text>
                <text class="nutrient-note" wx:if="{{item.note}}">{{item.note}}</text>
              </view>
            </view>
            <view class="preview-extras">
              <view class="extra-item" wx:for="{{previewExtras}}" wx:key="path"><text class="extra-label">{{item.label}}</text><text class="extra-reading {{item.hasValue ? '' : 'unrecognized'}}">{{item.value}}{{item.unit}}</text><text class="nutrient-note" wx:if="{{item.note}}">{{item.note}}</text></view>
            </view>
            </block>
            <view class="preview-actions" wx:if="{{canEstimate}}">
              <button class="text-button" catchtap="onRequestEstimate" disabled="{{busy || pendingSave}}">{{estimateButtonText}}</button>
            </view>
            <view class="preview-correction" wx:if="{{needIdentity && (!needsProductPhoto || identityEditorOpen)}}">
              <input class="input" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" cursor-spacing="24" value="{{values.name}}" placeholder="请输入具体食物名称" aria-label="具体食物名称" data-field="name" bindinput="onDialogInput" disabled="{{busy}}" />
              <view class="choice-group"><button class="choice-button" wx:for="{{identityCandidates}}" wx:key="index" data-index="{{index}}" catchtap="onCandidate" disabled="{{busy}}">{{item.name}}</button><button class="text-button" catchtap="onContinueIdentity" disabled="{{busy}}">确认名称</button></view>
              <button wx:if="{{displayMode === 'food_object'}}" class="text-button" catchtap="onSkipEstimate" disabled="{{busy}}">暂不估算</button>
            </view>
            <view class="preview-correction" wx:if="{{needBasis}}">
              <text class="preview-note">营养计量基准</text>
              <view class="preview-basis-fields">
                <input class="input" type="digit" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" cursor-spacing="24" value="{{values.baseQuantity}}" placeholder="基准份量" aria-label="营养基准份量" data-field="baseQuantity" bindinput="onDialogInput" bindblur="onDialogBlur" disabled="{{busy}}" />
                <picker range="{{unitItems}}" value="{{unitIndex}}" bindchange="onUnitChange" disabled="{{busy}}"><view class="picker-display">{{values.unit || '请选择单位'}}</view></picker>
              </view>
            </view>
          </block>
          <view class="reference-choice" wx:if="{{needReference}}"><text>选择对应食物</text><button class="reference-button" wx:for="{{referenceCandidates}}" wx:key="referenceId" data-index="{{index}}" catchtap="onReference" disabled="{{busy}}">{{item.identity.name}} · {{item.source.provider}}</button><button class="text-button" catchtap="onSkipReference" disabled="{{busy}}">暂不使用参考</button></view>
          <text class="preview-note" wx:if="{{needType}}">{{unrecognizedHint}}</text>
        </view>
        <block wx:if="{{!previewOnly && identityVisible}}">
        <view class="form-section">
          <view class="form-section-header"><text class="form-section-title">基础信息</text><text class="estimate-origin" wx:if="{{hasEstimate}}">含 AI 估算</text></view>
          <view wx:if="{{identityVisible}}">
            <view id="recognition-field-name" class="form-item">
              <text class="form-label">名称</text>
              <view class="form-control">
                <input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" value="{{values.name}}" placeholder="请输入名称" aria-label="名称" data-field="name" bindinput="onDialogInput" bindblur="onDialogBlur" disabled="{{busy}}" />
                <view class="choice-group" wx:if="{{needIdentity}}">
                  <button class="choice-button" wx:for="{{identityCandidates}}" wx:key="index" data-index="{{index}}" catchtap="onCandidate" disabled="{{busy}}">使用 {{item.name}}</button>
                  <button class="text-button" catchtap="onContinueIdentity" disabled="{{busy}}">使用当前名称</button>
                </view>
              </view>
            </view>
            <view id="recognition-field-category" class="form-item">
              <text class="form-label">分类</text>
              <view class="form-control form-control-stack">
                <view class="category-picker-row">
                  <picker class="field-picker" range="{{categoryItems}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange" disabled="{{busy}}">
                    <view class="picker-display {{values.category ? '' : 'placeholder'}}"><text class="picker-text">{{categoryLabel || '请选择分类'}}</text><text class="picker-arrow">›</text></view>
                  </picker>
                  <button class="category-add-trigger" wx:if="{{purpose !== 'preview' && unmatchedCategory && displayMode !== 'powder_label'}}" catchtap="toggleCategoryCreate" disabled="{{busy}}">{{categoryCreateOpen ? '收起' : '新增'}}</button>
                </view>
                <view class="custom-category-row" wx:if="{{purpose !== 'preview' && categoryCreateOpen && unmatchedCategory && displayMode !== 'powder_label'}}">
                  <input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input custom-category-input" value="{{newCategoryName}}" maxlength="60" placeholder="新分类名称" aria-label="新分类名称" bindinput="onNewCategoryInput" disabled="{{busy}}" />
                  <button class="custom-category-button" catchtap="onCreateCategory" disabled="{{busy}}" loading="{{categoryCreating}}">{{categoryCreating ? '创建中' : '添加'}}</button>
                </view>
                <text class="field-hint" wx:if="{{categoryCreateOpen}}">添加分类会立即保存，取消识别不会撤销这个分类。</text>
              </view>
            </view>

            <view wx:if="{{nutritionVisible}}">
              <view class="module-status nutrition-status loading" wx:if="{{nutritionLoading}}"><view class="spinner"></view><text>正在填入营养数据</text></view>
              <view class="reference-choice" wx:if="{{needReference}}">
                <button class="reference-button" wx:for="{{referenceCandidates}}" wx:key="referenceId" data-index="{{index}}" catchtap="onReference" disabled="{{busy}}"><text>{{item.identity.name}}</text><text class="reference-provider">{{item.source.provider}} ›</text></button>
                <button class="text-button" catchtap="onSkipReference" disabled="{{busy}}">暂不使用参考</button>
              </view>
              <view class="form-item" wx:if="{{displayMode !== 'powder_label'}}">
                <text class="form-label">记录单位</text>
                <view class="form-control"><picker range="{{unitItems}}" value="{{unitIndex}}" bindchange="onUnitChange" disabled="{{busy}}"><view class="picker-display {{values.unit ? '' : 'placeholder'}}"><text class="picker-text">{{values.unit || '请选择单位'}}</text><text class="picker-arrow">›</text></view></picker></view>
              </view>
              <view id="recognition-field-baseQuantity" class="form-item" wx:if="{{displayMode !== 'powder_label'}}">
                <text class="form-label">营养基准份量</text>
                <view class="form-control"><input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" type="digit" value="{{values.baseQuantity}}" placeholder="默认 100" aria-label="营养基准份量" data-field="baseQuantity" bindinput="onDialogInput" bindblur="onDialogBlur" disabled="{{busy}}" /></view>
              </view>
              <view class="field-hint fixed-basis" wx:else>营养成分 · 每 100g 干粉</view>
              <block wx:for="{{requiredNutrientRows}}" wx:key="path">
                <view id="recognition-field-{{item.path}}" class="form-item nutrient-row">
                  <text class="form-label">{{item.formLabel}} ({{item.unit}})</text>
                  <view class="form-control">
                    <view class="input input-loading" wx:if="{{item.loading}}"><view class="skeleton-value"></view><view class="spinner"></view></view>
                    <input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" wx:else class="input" type="digit" value="{{item.value}}" placeholder="必填" aria-label="{{item.label}} {{item.unit}}" data-field="{{item.path}}" bindinput="onDialogInput" disabled="{{busy}}" />
                    <text class="field-hint" wx:if="{{item.value === '' && item.labelValue !== ''}}">标签：{{item.labelValue}} {{item.unit}} · 基准待确认</text>
                  </view>
                </view>
                <view class="form-item" wx:if="{{item.path === 'protein' && displayMode !== 'powder_label'}}">
                  <text class="form-label">蛋白来源</text>
                  <view class="form-control form-control-stack">
                    <picker range="{{proteinItems}}" range-key="label" value="{{proteinIndex}}" bindchange="onProteinChange" disabled="{{busy}}">
                      <view class="picker-display {{values.proteinTypeIndex >= 0 ? '' : 'placeholder'}}"><text class="picker-text">{{values.proteinTypeIndex >= 0 ? proteinOptions[values.proteinTypeIndex].label : '请选择蛋白来源'}}</text><text class="picker-arrow">›</text></view>
                    </picker>
                    <button class="text-button special-confirm" wx:if="{{proteinSuggestionSpecial && proteinSuggestionIndex !== values.proteinTypeIndex}}" catchtap="onUseProteinSuggestion" disabled="{{busy}}">确认使用特殊蛋白</button>
                  </view>
                </view>
              </block>
              <view wx:if="{{displayMode === 'powder_label'}}">
                <view id="recognition-field-ratioPowder" class="form-item"><text class="form-label">粉量 (g)</text><view class="form-control"><input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" type="digit" value="{{values.ratioPowder}}" placeholder="必填" aria-label="奶粉粉量" data-field="ratioPowder" bindinput="onDialogInput" disabled="{{busy}}" /></view></view>
                <view id="recognition-field-ratioWater" class="form-item"><text class="form-label">加水量 (ml)</text><view class="form-control"><input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" type="digit" value="{{values.ratioWater}}" placeholder="必填" aria-label="冲调加水量" data-field="ratioWater" bindinput="onDialogInput" disabled="{{busy}}" /></view></view>
              </view>
            </view>
          </view>
        </view>

        <view class="form-section" wx:if="{{identityVisible}}">
          <button class="section-toggle" catchtap="toggleOptional" aria-expanded="{{optionalOpen}}"><text class="form-section-title">更多信息 · 选填</text><text>{{optionalOpen ? '收起' : '展开'}}</text></button>
          <view id="recognition-field-details" wx:if="{{optionalOpen && displayMode !== 'food_object'}}">
            <view class="form-item"><text class="form-label">品牌</text><view class="form-control"><input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" value="{{identityDetails.brand}}" maxlength="240" data-key="brand" bindinput="onIdentityDetailInput" bindblur="onIdentityDetailBlur" aria-label="产品品牌" disabled="{{busy}}" /></view></view>
            <view class="form-item"><text class="form-label">系列</text><view class="form-control"><input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" value="{{identityDetails.series}}" maxlength="240" data-key="series" bindinput="onIdentityDetailInput" bindblur="onIdentityDetailBlur" aria-label="产品系列" disabled="{{busy}}" /></view></view>
            <view class="form-item"><text class="form-label">段数或规格</text><view class="form-control"><input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" value="{{identityDetails.stage}}" maxlength="240" data-key="stage" bindinput="onIdentityDetailInput" bindblur="onIdentityDetailBlur" aria-label="产品段数或规格" disabled="{{busy}}" /></view></view>
            <view class="form-item"><text class="form-label">条码</text><view class="form-control"><input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" class="input" value="{{identityDetails.barcode}}" maxlength="32" data-key="barcode" bindinput="onIdentityDetailInput" bindblur="onIdentityDetailBlur" aria-label="产品条码" disabled="{{busy}}" /></view></view>
          </view>
          <view id="recognition-field-{{item.path}}" wx:if="{{optionalOpen}}" class="form-item nutrient-row" wx:for="{{optionalNutrientRows}}" wx:key="path">
            <text class="form-label">{{item.formLabel}} ({{item.unit}})</text>
            <view class="form-control">
              <view class="input input-loading" wx:if="{{item.loading}}"><view class="skeleton-value"></view><view class="spinner"></view></view>
              <input adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeight" bindconfirm="useResults" cursor-spacing="24" wx:else class="input" type="digit" value="{{item.value}}" placeholder="选填" aria-label="{{item.label}} {{item.unit}}" data-field="{{item.path}}" bindinput="onDialogInput" disabled="{{busy}}" />
              <text class="field-hint" wx:if="{{item.value === '' && item.labelValue !== ''}}">标签：{{item.labelValue}} {{item.unit}} · 基准待确认</text>
            </view>
          </view>
        </view>
        <button wx:if="{{canEstimate}}" class="text-button" catchtap="onRequestEstimate" disabled="{{busy || pendingSave}}">{{estimateButtonText}}</button>
        </block>
      </scroll-view>
      <view class="dialog-footer">
        <view class="footer-actions"><button class="secondary-button" catchtap="cancelDialog" disabled="{{saving || pendingSave}}">{{previewOnly ? '重拍' : '取消'}}</button><button wx:if="{{pendingSave}}" class="primary-button" catchtap="recoverPreviewSave" disabled="{{busy}}">恢复保存状态</button><button wx:elif="{{previewOnly && needsProductPhoto}}" class="primary-button" catchtap="openIdentityEditor" disabled="{{busy}}">填写名称</button><button wx:elif="{{!previewOnly || !needType}}" class="primary-button" catchtap="useResults" disabled="{{busy || !identityVisible || (previewOnly && !canUse)}}" loading="{{busy}}">{{saving ? '保存中' : busy ? '处理中' : previewOnly ? needsNutritionPhoto ? '手动填写' : '应用结果' : purpose === 'preview' ? '保存' : '填入表单'}}</button></view>
      </view>
    </view>
  </view>
</view>
