<page-meta page-style="{{preview ? 'overflow: hidden;' : ''}}" />
<view class="search-page">
  <view class="search-header">
    <view class="search-baby">当前宝宝：{{babyName}}</view>
    <view class="search-toolbar">
      <view class="search-bar">
        <view class="ss-icon ss-icon-search" aria-hidden="true"></view>
        <input class="search-input" value="{{query}}" placeholder="输入想查的内容或问题" placeholder-class="search-placeholder" maxlength="300" confirm-type="search" focus="{{queryFocus}}" bindinput="onInput" bindconfirm="submit" aria-label="搜索内容" />
        <button wx:if="{{query}}" class="icon-button search-clear" bindtap="clearQuery" aria-label="清除搜索"><view class="ss-icon ss-icon-close" aria-hidden="true"></view></button>
      </view>
      <button class="search-submit" bindtap="submit" disabled="{{busy || !searchEnabled || !query}}">{{busy ? '查询中' : '搜索'}}</button>
    </view>
  </view>
  <view class="saved-addition" wx:if="{{savedAddition}}"><text>已加入{{babyName}}的资料库{{savedAddition.name ? '：' + savedAddition.name : ''}}</text><button class="text-button" bindtap="openAddedItem">查看刚加入资料</button></view>
  <view wx:if="{{capabilityError}}" class="service-message" role="alert"><text>{{capabilityError}}</text><button class="text-button" bindtap="retryCapabilities" loading="{{capabilitiesLoading}}" disabled="{{capabilitiesLoading}}">重试</button></view>

  <view class="search-loading" wx:if="{{busy}}" role="status" aria-live="polite">
    <view class="search-mascot-stage" aria-hidden="true"><image class="search-mascot" src="/images/milk-lemon-loading.png" mode="aspectFit" /></view>
    <text class="loading-title">柠檬正在帮你找</text>
    <text class="loading-caption">{{slow ? '查询时间稍长，请再等一下，也可以在上方调整问题' : '正在查找相关资料与记录…'}}</text>
  </view>
  <view class="search-feedback" wx:if="{{question && !busy}}" role="alert">
    <text class="question-title">{{question.message}}</text>
    <view class="choice-options"><button wx:for="{{question.options}}" wx:key="id" data-id="{{item.id}}" bindtap="resolveChoice">{{item.label}}</button></view>
    <view class="threshold-entry" wx:if="{{question.input}}"><input type="digit" value="{{thresholdValue}}" placeholder="{{question.input.label}}" bindinput="onThreshold" aria-label="{{question.input.label}}" /><text>{{question.input.unit}}</text><button class="text-button" bindtap="resolveThreshold">查询</button></view>
  </view>
  <view class="search-feedback" wx:if="{{!busy && (error || message && !question)}}" role="alert"><text>{{error || message}}</text><view class="feedback-actions" wx:if="{{retryAvailable && !moreError}}"><button class="text-button" bindtap="retrySearch">重试</button></view></view>
  <view class="result-summary" wx:if="{{resultSummary && !busy}}" aria-live="polite">{{resultSummary}}</view>
  <view class="search-empty" wx:if="{{emptyState && !busy}}" role="status" aria-live="polite"><view class="empty-mark" aria-hidden="true"><view class="ss-icon ss-icon-search"></view></view><text class="empty-title">{{emptyState.title}}</text><text class="empty-description">{{emptyState.description}}</text></view>

  <view class="intro" wx:if="{{!hasSearched && !query}}">
    <view class="example-heading"><text class="example-title">试试这样搜</text><text class="example-hint">查系统食物，也能查宝宝已有记录</text></view>
    <view class="quick-queries"><button wx:for="{{exampleQueries}}" wx:key="query" class="quick-query" data-query="{{item.query}}" bindtap="useQuery" disabled="{{!searchEnabled}}" hover-class="query-pressed"><text class="quick-query-label">{{item.query}}</text></button></view>
    <view wx:if="{{recent.length}}" class="recent"><view class="section-head"><text>最近搜索</text><button class="text-button" bindtap="clearRecent">清空</button></view><view class="recent-queries"><button wx:for="{{recent}}" wx:key="*this" class="recent-query" data-query="{{item}}" bindtap="useQuery" bindlongpress="removeRecent" disabled="{{!searchEnabled}}" hover-class="query-pressed">{{item}}</button></view></view>
  </view>
  <view class="feature-list" wx:if="{{result && result.kind === 'feature' && !busy}}"><button wx:for="{{result.items}}" wx:key="id" class="feature-row" data-id="{{item.id}}" bindtap="feature"><text class="feature-name">{{item.name}}</text><view class="ss-icon ss-icon-arrow"></view></button></view>
  <view class="result-group" wx:if="{{result && result.kind === 'list' && !busy && !emptyState}}">
    <block wx:for="{{visibleItems}}" wx:key="id">
    <view wx:if="{{item.groupLabel}}" class="section-head"><text>{{item.groupLabel}} · {{item.groupTotal}} 项</text><button wx:if="{{item.groupHasMore}}" class="text-button" data-id="{{item.groupId}}" bindtap="openResultGroup">查看全部</button></view>
    <view id="search-result-{{index}}" class="result-row {{highlightedId === item.id ? 'result-highlighted' : ''}}" data-id="{{item.id}}" bindtap="openItem" role="button" hover-class="row-pressed">
      <image wx:if="{{item.thumbnailUrl}}" class="result-thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onResultImageError" />
      <view wx:else class="result-thumbnail result-placeholder" aria-hidden="true"><text>{{item.typeLabel}}</text></view>
      <view class="result-content">
        <view class="result-title-line"><text class="result-name">{{item.name}}</text><text wx:if="{{item.source !== 'history'}}" class="source-tag {{item.source}}">{{item.sourceText}}</text></view>
        <view class="field-answers" wx:if="{{item.answers.length}}"><view class="field-answer" wx:for="{{item.answers}}" wx:for-item="answer" wx:key="field"><text class="answer-label">{{answer.label}}</text><text class="answer-value {{answer.known ? '' : 'answer-missing'}}">{{answer.value}}</text><text class="answer-note" wx:if="{{answer.note}}">{{answer.note}}</text></view></view>
        <view class="result-nutrition" wx:elif="{{item.hasNutrition}}"><text class="energy-value">{{item.energyText}}</text><text class="result-basis"> / {{item.basisCaption}}</text></view>
        <view class="ingredient-caption" wx:elif="{{item.type === 'meal'}}">{{item.mealSummary}}</view>
        <view class="ingredient-caption" wx:elif="{{item.type === 'recipe'}}"><text wx:for="{{item.ingredients}}" wx:for-item="ingredient" wx:key="index">{{ingredient}}{{index + 1 < item.ingredients.length ? '、' : ''}}</text></view>
        <view class="ingredient-caption" wx:elif="{{item.type === 'medication'}}">{{item.medicationText || '未填写剂量和频率'}}</view>
        <view class="result-caption" wx:if="{{!item.answers.length && item.hasNutrition}}">蛋白质 {{item.proteinText}}</view>
        <view class="result-caption" wx:if="{{item.source === 'history'}}"><text>{{item.date}} {{item.time}}</text><text wx:if="{{item.type === 'meal'}}">共 {{item.foodCount}} 项 · 查看餐次详情</text><text wx:if="{{item.actualQuantity > 0}}">实际食用 {{item.actualQuantity}} {{item.actualUnitText}}</text></view>
      </view><view class="ss-icon ss-icon-arrow result-open-arrow"></view>
    </view>
    </block>
  </view>
  <view class="metric-results" wx:if="{{result && !busy && !emptyState && (result.kind === 'scalar' || result.kind === 'series' || result.kind === 'comparison')}}">
    <view class="metric-heading"><view class="metric-title-line"><text class="metric-title">{{result.label}}</text><text class="metric-unit">{{result.unit}}</text></view><text class="metric-period" wx:if="{{result.requestedDays}}">有效 {{result.knownDays}} / {{result.requestedDays}} 天</text></view>
    <view wx:if="{{result.kind === 'scalar'}}"><view class="summary-reading" wx:for="{{result.rows}}" wx:key="index"><text class="answer-label" wx:if="{{result.rows.length > 1}}">{{item.label}}</text><view><text class="summary-value {{item.known ? '' : 'answer-missing'}}">{{item.displayValue}}</text><text class="summary-unit">{{item.unit}}</text></view><text class="answer-note" wx:if="{{item.recordedDays}}">{{item.recordedDays}} 天有记录</text><text class="answer-note" wx:if="{{item.date}}">记录日期：{{item.date}}</text><text class="answer-note" wx:if="{{item.firstMeasurement && item.lastMeasurement}}">测量范围：{{item.firstMeasurement.date}} 至 {{item.lastMeasurement.date}}</text><text class="answer-note" wx:if="{{!item.known && item.missingReason}}">{{item.missingReason}}</text></view></view>
    <view wx:if="{{result.kind === 'series'}}"><button wx:for="{{result.rows}}" wx:key="date" class="metric-row" data-index="{{index}}" bindtap="openSeriesDay" disabled="{{!item.canOpen}}"><text class="metric-date">{{item.date}}</text><view class="metric-reading"><text class="{{item.known ? 'metric-value' : 'metric-missing'}}">{{item.known ? item.displayValue : item.missingReason}}</text><view wx:if="{{item.canOpen}}" class="ss-icon ss-icon-arrow"></view></view></button></view>
    <view wx:if="{{result.kind === 'comparison'}}"><view class="comparison-result" wx:for="{{result.rows}}" wx:key="index"><text class="answer-label">{{item.label}} · {{item.unit}}</text><view class="comparison-values"><view><text class="answer-label">{{result.periodLabels[0] || '第一段'}}</text><text class="summary-value">{{item.leftText}}</text></view><view><text class="answer-label">{{result.periodLabels[1] || '第二段'}}</text><text class="summary-value">{{item.rightText}}</text></view></view><text class="comparison-delta" wx:if="{{item.deltaText}}">差值 {{item.deltaText}} {{item.unit}}</text><text class="answer-note" wx:if="{{item.leftRequestedDays}}">有效天数 {{item.leftKnownDays}}/{{item.leftRequestedDays}} 与 {{item.rightKnownDays}}/{{item.rightRequestedDays}}</text></view></view>
  </view>
  <view class="service-message" wx:if="{{moreError}}" role="alert"><text>后续内容未加载：{{moreError}}</text><button class="text-button" wx:if="{{retryAvailable}}" bindtap="retrySearch" disabled="{{moreBusy}}">重试下一页</button><button wx:else class="text-button" bindtap="submit">重新搜索</button></view>
  <button class="more-button" wx:if="{{nextCursor && !busy && !moreError}}" loading="{{moreBusy}}" disabled="{{moreBusy}}" bindtap="more">{{slow ? '仍在加载…' : '继续查看'}}</button>
  <view class="answer-actions" wx:if="{{actions.length && !busy && !emptyState}}"><button wx:for="{{actions}}" wx:key="id" class="text-button" data-id="{{item.id}}" bindtap="action">{{item.label}}</button></view>
  <text class="hint" wx:if="{{result && result.kind === 'list' && result.note && !busy && !emptyState}}">{{result.note}}</text>
  <view wx:if="{{result && result.kind !== 'list' && result.note && !busy && !emptyState}}"><button class="text-button metric-notes-toggle" bindtap="toggleNotes" aria-expanded="{{notesOpen}}">{{notesOpen ? '收起统计说明' : '统计说明'}}</button><text class="hint" wx:if="{{notesOpen}}">{{result.note}}</text></view>
  <view wx:if="{{previewLoading}}" class="group-state"><view class="status-spinner"></view><text>正在打开资料…</text></view>
  <view class="preview-mask" wx:if="{{preview}}" bindtap="closePreview" catchtouchmove="stopPropagation"></view>
  <view class="preview" wx:if="{{preview}}" role="dialog" aria-label="资料预览">
    <text class="search-baby">所属宝宝：{{babyName}}</text>
    <view class="preview-header"><view class="preview-heading"><text class="source-tag {{preview.source}}">{{preview.sourceText}}</text><text class="preview-title">{{preview.name}}</text></view><button class="icon-button" bindtap="closePreview" aria-label="关闭预览"><view class="ss-icon ss-icon-close"></view></button></view>
    <text class="preview-basis">{{preview.type === 'meal' ? preview.date + ' ' + preview.time + ' · 共 ' + preview.foodCount + ' 项' : preview.type === 'medication' ? '已记录的药物信息' : preview.type === 'recipe' ? '食谱配料' : preview.basisText}}</text>
    <scroll-view scroll-y="true" class="preview-body">
      <view wx:if="{{preview.hasNutrition}}" class="preview-nutrient" wx:for="{{preview.values}}" wx:key="key"><text>{{item.label}}</text><view class="nutrient-value-line"><text class="nutrient-value">{{item.value}}</text><text wx:if="{{item.isEstimate}}" class="nutrition-estimate-tag">AI 估算</text></view></view>
      <view wx:if="{{preview.type === 'medication'}}" class="preview-nutrient medication-detail" wx:for="{{preview.medicationDetails}}" wx:key="label"><text>{{item.label}}</text><text class="nutrient-value">{{item.value}}</text></view>
      <view wx:if="{{preview.ingredients.length}}" class="ingredients"><text wx:for="{{preview.ingredients}}" wx:key="index">{{item}}</text></view>
      <text wx:if="{{preview.type === 'meal' && preview.mealNote}}" class="hint">{{preview.mealNote}}</text>
    </scroll-view>
    <button wx:if="{{preview.source !== 'history'}}" class="primary preview-action" bindtap="openManagement">打开{{preview.type === 'medication' ? '药物' : preview.type === 'food' ? '食物' : preview.type === 'powder' ? '奶粉' : '食谱'}}管理</button>
  </view>

</view>
