<page-meta page-style="{{preview ? 'overflow: hidden;' : ''}}" />
<view class="search-page">
  <view class="search-header">
    <view class="search-toolbar">
      <view class="search-bar">
        <view class="ss-icon ss-icon-search" aria-hidden="true"></view>
        <input class="search-input" value="{{query}}" placeholder="搜索食物、药物、记录…" placeholder-class="search-placeholder" maxlength="300" confirm-type="search" focus="true" bindinput="onInput" bindconfirm="submit" aria-label="搜索内容" />
        <button wx:if="{{query}}" class="icon-button search-clear" bindtap="clearQuery" aria-label="清除搜索"><view class="ss-icon ss-icon-close" aria-hidden="true"></view></button>
        <button wx:if="{{scanAvailable}}" class="icon-button search-camera" bindtap="scan" aria-label="拍照识别"><view class="ss-icon ss-icon-camera" aria-hidden="true"><view class="ss-camera-lens"></view></view></button>
      </view>
      <button class="search-submit" bindtap="submit" loading="{{busy}}" disabled="{{busy || !searchEnabled}}">{{busy ? '' : '搜索'}}</button>
    </view>
    <scroll-view class="tabs" scroll-x="true" enhanced="true" show-scrollbar="false"><view class="tabs-track"><button wx:for="{{tabs}}" wx:key="id" class="tab {{tab === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onTab"><text>{{item.label}}</text><view wx:if="{{tab === item.id}}" class="tab-indicator"></view></button></view></scroll-view>
    <view class="search-filterbar" wx:if="{{hasSearched && !busy && result && result.kind === 'list' && !question}}">
      <picker wx:if="{{catalogResult}}" class="source-filter" range="{{sources}}" value="{{sourceIndex}}" bindchange="onSourceFilter"><view class="source-filter-value"><text>{{sources[sourceIndex]}}</text><text class="filter-caret">▾</text></view></picker>
      <view class="filter-spacer"></view><button class="filter-toggle {{filtersOpen ? 'active' : ''}}" bindtap="toggleFilters"><view class="ss-icon ss-icon-filter"><view class="ss-filter-middle"></view></view><text>{{filtersOpen ? '收起' : '筛选'}}</text></button>
    </view>
  </view>
  <view wx:if="{{capabilityError}}" class="service-message" role="alert"><text>{{capabilityError}}</text><button class="text-button" bindtap="retryCapabilities" loading="{{capabilitiesLoading}}" disabled="{{capabilitiesLoading}}">重试</button></view>

  <view class="filters" wx:if="{{filtersOpen}}">
    <view class="section-head"><text>筛选条件</text><button class="icon-button" bindtap="toggleFilters" aria-label="收起筛选"><view class="ss-icon ss-icon-close"></view></button></view>
    <view class="filter-line"><text class="filter-label">名称</text><input class="filter-name-input" value="{{filterKeyword}}" maxlength="100" placeholder="输入名称，可留空" bindinput="onFilterKeyword" /></view>
    <view class="filter-line"><text class="filter-label">搜索范围</text><picker range="{{modes}}" value="{{modeIndex}}" data-key="modeIndex" bindchange="onPicker"><view class="picker-value"><text>{{modes[modeIndex]}}</text><text class="picker-arrow">›</text></view></picker></view>
    <view class="filter-line" wx:if="{{modeIndex === 0}}"><text class="filter-label">资料来源</text><picker range="{{sources}}" value="{{sourceIndex}}" data-key="sourceIndex" bindchange="onPicker"><view class="picker-value"><text>{{sources[sourceIndex]}}</text><text class="picker-arrow">›</text></view></picker></view>
    <view class="filter-line" wx:if="{{modeIndex !== 0}}"><text class="filter-label">记录日期</text><picker range="{{periods}}" value="{{periodIndex}}" data-key="periodIndex" bindchange="onPicker"><view class="picker-value"><text>{{periods[periodIndex]}}</text><text class="picker-arrow">›</text></view></picker></view>
    <view class="date-range" wx:if="{{periodIndex === 5}}"><picker mode="date" value="{{startDate}}" data-key="startDate" bindchange="onDate"><view>{{startDate || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="onDate"><view>{{endDate || '结束日期'}}</view></picker></view>
    <view class="filter-line" wx:if="{{modeIndex === 0 && (tab === 'powder' || tab === 'all')}}"><text class="filter-label">奶粉基准</text><picker range="{{powderBases}}" value="{{powderIndex}}" data-key="powderIndex" bindchange="onPicker"><view class="picker-value"><text>{{powderBases[powderIndex]}}</text><text class="picker-arrow">›</text></view></picker></view>
    <view class="condition" wx:for="{{conditions}}" wx:key="index" wx:for-index="conditionIndex">
      <view class="condition-head"><text>营养条件 {{conditionIndex + 1}}</text><button class="text-button" data-index="{{conditionIndex}}" bindtap="removeCondition">移除</button></view>
      <view class="condition-basis"><text>每</text><input type="digit" value="{{item.basisQuantity}}" data-index="{{conditionIndex}}" data-key="basisQuantity" bindinput="onCondition" aria-label="比较基准数量" /><picker range="{{basisUnits}}" value="{{item.unitIndex}}" data-index="{{conditionIndex}}" data-key="unitIndex" bindchange="onCondition"><view>{{basisUnits[item.unitIndex]}} ▾</view></picker></view>
      <view class="condition-values"><picker class="nutrient-picker" range="{{fields}}" value="{{item.fieldIndex}}" data-index="{{conditionIndex}}" data-key="fieldIndex" bindchange="onCondition"><view>{{fields[item.fieldIndex]}} ▾</view></picker><picker class="operator-picker" range="{{operators}}" value="{{item.operatorIndex}}" data-index="{{conditionIndex}}" data-key="operatorIndex" bindchange="onCondition"><view>{{operators[item.operatorIndex]}} ▾</view></picker><input type="digit" value="{{item.value}}" placeholder="数值" data-index="{{conditionIndex}}" data-key="value" bindinput="onCondition" aria-label="营养比较值" /><text class="condition-unit">{{item.fieldIndex === 0 ? 'kcal' : item.fieldIndex === 5 ? 'mg' : 'g'}}</text></view>
    </view>
    <button class="add-condition" wx:if="{{modeIndex < 2 && tab !== 'medication' && tab !== 'recipe'}}" bindtap="addCondition" disabled="{{conditions.length >= 6}}">＋ 添加营养条件</button>
    <text class="hint" wx:if="{{conditions.length}}">多条条件需同时满足；缺少依据的营养不参与比较。</text>
    <button class="primary filter-apply" bindtap="applyFilters" loading="{{busy}}" disabled="{{busy || !searchEnabled}}">应用筛选</button>
  </view>



  <view class="history-range" wx:if="{{historyOptionsOpen}}">
    <view class="history-range-heading"><text>记录时间</text><picker range="{{periods}}" value="{{periodIndex}}" bindchange="onHistoryPeriod"><view class="history-period-picker">{{periods[periodIndex]}} <text class="filter-caret">▾</text></view></picker></view>
    <view class="period-shortcuts"><button class="period-shortcut" data-index="2" bindtap="onHistoryPeriod">近 7 天</button><button class="period-shortcut" data-index="0" bindtap="onHistoryPeriod">近 30 天</button><button class="period-shortcut" data-index="4" bindtap="onHistoryPeriod">全部历史</button><button class="period-shortcut" data-index="5" bindtap="onHistoryPeriod">自定义</button></view>
    <text class="history-range-caption">{{historyPeriodText}}</text><view wx:if="{{dateRangeOpen}}"><view class="date-range"><picker mode="date" value="{{startDate}}" data-key="startDate" bindchange="onDate"><view>{{startDate || '开始日期'}}</view></picker><text>至</text><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="onDate"><view>{{endDate || '结束日期'}}</view></picker></view><button class="primary" bindtap="applyHistoryPeriod">应用日期</button></view>
  </view>
  <view class="chips" wx:if="{{chips.length && !busy}}"><button wx:for="{{chips}}" wx:key="id" data-kind="{{item.kind}}" bindtap="onChip">{{item.label}}</button></view>
  <view class="group-state" wx:if="{{busy}}"><view class="status-spinner"></view><text>正在查询…</text></view>
  <view class="search-feedback" wx:if="{{question && !busy}}" role="alert">
    <text class="question-title">{{question.message}}</text>
    <view class="choice-options"><button wx:for="{{question.options}}" wx:key="id" data-id="{{item.id}}" bindtap="resolveChoice">{{item.label}}</button></view>
    <view class="threshold-entry" wx:if="{{question.input}}"><input type="digit" value="{{thresholdValue}}" placeholder="{{question.input.label}}" bindinput="onThreshold" aria-label="{{question.input.label}}" /><text>{{question.input.unit}}</text><button class="text-button" bindtap="resolveThreshold">查询</button></view>
  </view>
  <view class="search-feedback" wx:if="{{!busy && !question && (error || message && (!result || !result.items || !result.items.length))}}" role="alert"><text>{{error || message}}</text><view class="feedback-actions"><button wx:if="{{error || status === 'unavailable' || status === 'partial'}}" class="text-button" bindtap="submit">重试</button><button class="text-button" bindtap="toggleFilters">调整筛选</button></view></view>

  <view class="intro" wx:if="{{!hasSearched && !query}}">
    <view wx:if="{{recent.length}}" class="recent"><view class="section-head"><text>最近搜索</text><button class="text-button" bindtap="clearRecent">清空</button></view><view class="recent-queries"><button wx:for="{{recent}}" wx:key="*this" class="recent-query" data-query="{{item}}" bindtap="useQuery" bindlongpress="removeRecent">{{item}}</button></view></view>
    <view wx:else class="quick-queries"><button data-query="最近一周的天然蛋白系数" bindtap="useQuery">近一周天然蛋白系数</button><button data-query="蛋白低于10g的食物" bindtap="useQuery">蛋白低于 10g 的食物</button></view>
  </view>
  <view class="feature-list" wx:if="{{result && result.kind === 'feature' && !busy}}"><button wx:for="{{result.items}}" wx:key="id" class="feature-row" data-id="{{item.id}}" bindtap="feature"><text class="feature-name">{{item.name}}</text><view class="ss-icon ss-icon-arrow"></view></button></view>
  <view class="result-group" wx:if="{{result && result.kind === 'list' && !busy}}">
    <view class="result-row" wx:for="{{visibleItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openItem" role="button" hover-class="row-pressed">
      <image wx:if="{{item.thumbnailUrl}}" class="result-thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onResultImageError" />
      <view wx:else class="result-thumbnail result-placeholder" aria-hidden="true"><text>{{item.typeLabel}}</text></view>
      <view class="result-content">
        <view class="result-title-line"><text class="result-name">{{item.name}}</text><text wx:if="{{item.source !== 'history'}}" class="source-tag {{item.source}}">{{item.sourceText}}</text></view>
        <view class="field-answers" wx:if="{{item.answers.length}}"><view class="field-answer" wx:for="{{item.answers}}" wx:for-item="answer" wx:key="field"><text class="answer-label">{{answer.label}}</text><text class="answer-value {{answer.known ? '' : 'answer-missing'}}">{{answer.value}}</text><text class="answer-note" wx:if="{{answer.note}}">{{answer.note}}</text></view></view>
        <view class="result-nutrition" wx:elif="{{item.hasNutrition}}"><text class="energy-value">{{item.energyText}}</text><text class="result-basis"> / {{item.basisCaption}}</text></view>
        <view class="ingredient-caption" wx:elif="{{item.type === 'recipe'}}"><text wx:for="{{item.ingredients}}" wx:for-item="ingredient" wx:key="index">{{ingredient}}{{index + 1 < item.ingredients.length ? '、' : ''}}</text></view>
        <view class="ingredient-caption" wx:elif="{{item.type === 'medication'}}">{{item.medicationText || '未填写剂量和频率'}}</view>
        <view class="result-caption" wx:if="{{!item.answers.length && item.hasNutrition}}">蛋白质 {{item.proteinText}}</view>
        <view class="result-caption" wx:if="{{item.source === 'history'}}"><text>{{item.date}} {{item.time}}</text><text wx:if="{{item.actualQuantity > 0}}">实际食用 {{item.actualQuantity}} {{item.actualUnitText}}</text></view>
      </view><view class="ss-icon ss-icon-arrow result-open-arrow"></view>
    </view>
    <view class="group-state" wx:if="{{items.length && !visibleItems.length}}">当前分类没有结果，可切换分类查看。</view>
  </view>
  <view class="metric-results" wx:if="{{result && !busy && (result.kind === 'scalar' || result.kind === 'series' || result.kind === 'comparison')}}">
    <view class="metric-heading"><view class="metric-title-line"><text class="metric-title">{{result.label}}</text><text class="metric-unit">{{result.unit}}</text></view><text class="metric-period" wx:if="{{result.requestedDays}}">有效 {{result.knownDays}} / {{result.requestedDays}} 天</text></view>
    <view wx:if="{{result.kind === 'scalar'}}"><view class="summary-reading" wx:for="{{result.rows}}" wx:key="index"><text class="answer-label" wx:if="{{result.rows.length > 1}}">{{item.label}}</text><view><text class="summary-value {{item.known ? '' : 'answer-missing'}}">{{item.displayValue}}</text><text class="summary-unit">{{item.unit}}</text></view><text class="answer-note" wx:if="{{item.recordedDays}}">{{item.recordedDays}} 天有记录</text></view></view>
    <view wx:if="{{result.kind === 'series'}}"><button wx:for="{{result.rows}}" wx:key="date" class="metric-row" data-index="{{index}}" bindtap="openSeriesDay"><text class="metric-date">{{item.date}}</text><view class="metric-reading"><text class="{{item.known ? 'metric-value' : 'metric-missing'}}">{{item.known ? item.displayValue : item.missingReason}}</text><view class="ss-icon ss-icon-arrow"></view></view></button></view>
    <view wx:if="{{result.kind === 'comparison'}}"><view class="comparison-result" wx:for="{{result.rows}}" wx:key="index"><text class="answer-label">{{item.label}} · {{item.unit}}</text><view class="comparison-values"><view><text class="answer-label">{{result.periodLabels[0] || '第一段'}}</text><text class="summary-value">{{item.leftText}}</text></view><view><text class="answer-label">{{result.periodLabels[1] || '第二段'}}</text><text class="summary-value">{{item.rightText}}</text></view></view><text class="comparison-delta" wx:if="{{item.deltaText}}">差值 {{item.deltaText}} {{item.unit}}</text><text class="answer-note" wx:if="{{item.leftRequestedDays}}">有效天数 {{item.leftKnownDays}}/{{item.leftRequestedDays}} 与 {{item.rightKnownDays}}/{{item.rightRequestedDays}}</text></view></view>
  </view>
  <button class="more-button" wx:if="{{nextCursor && !busy}}" loading="{{moreBusy}}" disabled="{{moreBusy}}" bindtap="more">继续查看</button>
  <view class="answer-actions" wx:if="{{actions.length && !busy}}"><button wx:for="{{actions}}" wx:key="id" class="text-button" data-id="{{item.id}}" bindtap="action">{{item.label}}</button></view>
  <view wx:if="{{result && result.note && !busy}}"><button class="text-button metric-notes-toggle" bindtap="toggleNotes">{{notesOpen ? '收起依据' : '查看依据'}}</button><text class="hint" wx:if="{{notesOpen}}">{{result.note}}</text></view>
  <view wx:if="{{previewLoading}}" class="group-state"><view class="status-spinner"></view><text>正在打开资料…</text></view>
  <view class="preview-mask" wx:if="{{preview}}" bindtap="closePreview" catchtouchmove="stopPropagation"></view>
  <view class="preview" wx:if="{{preview}}" role="dialog" aria-label="资料预览">
    <view class="preview-header"><view class="preview-heading"><text class="source-tag {{preview.source}}">{{preview.sourceText}}</text><text class="preview-title">{{preview.name}}</text></view><button class="icon-button" bindtap="closePreview" aria-label="关闭预览"><view class="ss-icon ss-icon-close"></view></button></view>
    <text class="preview-basis">{{preview.type === 'medication' ? '已记录的药物信息' : preview.type === 'recipe' ? '食谱配料' : preview.basisText}}</text><text wx:if="{{preview.estimate}}" class="hint">包含已采用的 AI 估算值</text>
    <scroll-view scroll-y="true" class="preview-body">
      <view wx:if="{{preview.hasNutrition}}" class="preview-nutrient" wx:for="{{preview.values}}" wx:key="key"><text>{{item.label}}</text><text class="nutrient-value">{{item.value}}</text></view>
      <view wx:if="{{preview.type === 'medication'}}" class="preview-nutrient medication-detail" wx:for="{{preview.medicationDetails}}" wx:key="label"><text>{{item.label}}</text><text class="nutrient-value">{{item.value}}</text></view>
      <view wx:if="{{preview.ingredients.length}}" class="ingredients"><text wx:for="{{preview.ingredients}}" wx:key="index">{{item}}</text></view>
    </scroll-view>
    <button wx:if="{{preview.source !== 'history'}}" class="primary preview-action" bindtap="openManagement">打开{{preview.type === 'medication' ? '药物' : preview.type === 'food' ? '食物' : preview.type === 'powder' ? '奶粉' : '食谱'}}管理</button>
  </view>

</view>
