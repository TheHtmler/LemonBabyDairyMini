@import "../../styles/search-scan.wxss";
page { background: #fff9e6; color: #473a22; }
.search-page { padding: 0 24rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
/* 显式重置微信 v2 按钮的默认宽度，避免挤占分类、筛选栏和快捷词。 */
.search-page button { width: auto; min-width: 0; max-width: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font-size: 27rpx; font-weight: 400; line-height: 1.45; box-sizing: border-box; }
.search-page button::after { display: none; border: 0; }
.search-page button[disabled] { opacity: .5; }
.search-header { position: sticky; top: 0; z-index: 10; padding: 16rpx 0 0; background: #fff9e6; }
.search-toolbar { display: flex; align-items: center; gap: 12rpx; }
.search-bar { display: flex; align-items: center; flex: 1; min-width: 0; min-height: 88rpx; padding: 0 16rpx 0 24rpx; border-radius: 48rpx; background: #f2ecdd; box-sizing: border-box; }
.search-bar > .ss-icon { width: 36rpx; margin-right: 14rpx; }
.search-input { flex: 1; min-width: 0; height: 84rpx; color: #473a22; font-size: 30rpx; }
.search-placeholder { color: #a4967b; }
.search-page .search-submit { display: flex; align-items: center; justify-content: center; flex: 0 0 88rpx; min-width: 44px; min-height: 88rpx; padding: 8rpx 0; color: #9a6b18; font-size: 30rpx; font-weight: 600; }
.search-page .icon-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 80rpx; min-width: 44px; min-height: 80rpx; padding: 12rpx; }
.search-clear .ss-icon { color: #a29171; width: 30rpx; transform: scale(.8); }
.search-page .search-camera { width: 64rpx; min-width: 36px; min-height: 88rpx; padding: 12rpx 8rpx; }
.search-camera .ss-icon { transform: scale(.85); }
.search-page .filter-toggle { display: flex; align-items: center; justify-content: center; gap: 6rpx; flex-shrink: 0; min-width: 44px; min-height: 88rpx; padding: 0 8rpx; color: #8a7550; font-size: 24rpx; }
.filter-toggle .ss-icon { transform: scale(.8); }
.filter-toggle.active { font-weight: 600; }
.tabs { width: 100%; white-space: nowrap; }
.tabs-track { display: flex; align-items: center; width: 100%; padding-top: 8rpx; }
.search-page .tab { position: relative; display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 92rpx; padding: 12rpx 0 24rpx; color: #a3967b; font-size: 27rpx; white-space: nowrap; }
.search-page .tab.selected { color: #624e2d; font-weight: 600; }
.tab-indicator { position: absolute; bottom: 10rpx; left: 50%; width: 32rpx; height: 6rpx; border-radius: 4rpx; background: #e7b64b; transform: translateX(-50%); }
.search-filterbar { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; margin: 0 -24rpx; padding: 0 24rpx; border-bottom: 1rpx solid #eee5d1; background: #fff9e6; }
.filter-spacer { flex: 1; }
.search-page .history-toggle { display: flex; align-items: center; gap: 8rpx; min-height: 88rpx; color: #8b7650; font-size: 24rpx; }
.history-toggle.active { color: #755019; }
.source-filter { flex-shrink: 0; max-width: 220rpx; }
.source-filter-value { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; font-size: 26rpx; color: #786342; }
.source-filter-value > text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-caret { flex-shrink: 0; color: #b09d7c; font-size: 22rpx; }
.history-range { margin-top: 12rpx; padding: 12rpx 20rpx 18rpx; border-radius: 16rpx; background: #fffdf7; }
.history-range-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #8b7650; font-size: 24rpx; }
.history-period-picker { display: flex; align-items: center; gap: 10rpx; min-height: 56rpx; color: #725731; }
.period-shortcuts { display: flex; align-items: center; gap: 12rpx; }
.search-page .period-shortcut { flex: 1; min-width: 0; min-height: 72rpx; padding: 12rpx 4rpx; border-radius: 12rpx; color: #8b7650; font-size: 24rpx; background: #f5efdf; }
.search-page .period-shortcut.active { color: #755019; background: #ffe7a2; font-weight: 600; }
.history-range-caption { display: block; margin-top: 10rpx; color: #9a8866; font-size: 22rpx; line-height: 1.5; }
.history-date-editor .primary { width: 100%; margin-top: 6rpx; }
.service-message,.message { margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #fff0d5; color: #8a572c; font-size: 26rpx; line-height: 1.6; overflow-wrap: break-word; }
.search-feedback { margin-top: 0; padding: 28rpx 4rpx 16rpx; border-radius: 0; background: transparent; }
.feedback-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 28rpx; }
.search-page .feedback-actions .text-button { padding-left: 0; padding-right: 0; color: #996b1a; }
.service-message { display: flex; align-items: center; gap: 16rpx; }
.service-message > text { flex: 1; min-width: 0; }
.search-page .text-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-height: 76rpx; padding: 10rpx 12rpx; color: #85642a; font-size: 25rpx; }
.search-page .retry-link { min-width: 88rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 84rpx; font-size: 30rpx; font-weight: 600; }
.section-head > .text-button { flex: 0 0 auto; margin-left: auto; }
.found { flex-shrink: 0; font-size: 23rpx; font-weight: 400; color: #9a8660; }
.filters { margin-top: 20rpx; padding: 0 24rpx 24rpx; border: 1rpx solid #eee2c5; border-radius: 20rpx; background: #fffdf7; }
.filter-line { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; border-bottom: 1rpx solid #f0e8d6; font-size: 27rpx; }
.filter-label { flex-shrink: 0; color: #716044; }
.filter-line picker,.filter-name-input { flex: 1; min-width: 0; }
.filter-name-input { height: 88rpx; text-align: right; font-size: 27rpx; }
.picker-value { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; min-height: 88rpx; color: #876b3b; text-align: right; }
.picker-value > text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-arrow { flex-shrink: 0; color: #b3a07c; font-size: 32rpx; }
.date-range { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; font-size: 25rpx; }
.date-range picker { flex: 1; min-width: 0; padding: 20rpx 8rpx; border-radius: 12rpx; background: #f7f1df; text-align: center; }
.condition { padding: 12rpx 0 20rpx; border-bottom: 1rpx solid #ede3cc; }
.condition-head,.condition-basis,.condition-values { display: flex; align-items: center; gap: 12rpx; min-width: 0; font-size: 25rpx; }
.condition-head { justify-content: space-between; color: #806b46; }
.condition-basis { margin-bottom: 12rpx; }
.condition-basis > input { width: 108rpx; }
.condition-basis picker { min-width: 88rpx; padding: 20rpx 12rpx; }
.condition-values picker { padding: 20rpx 10rpx; border-radius: 10rpx; background: #f6f0df; text-align: center; }
.nutrient-picker { flex: 1.2; min-width: 0; }.operator-picker { flex: 1; min-width: 0; }
.condition-values input { flex: 1; width: 0; min-width: 76rpx; }.condition-unit { width: 48rpx; flex-shrink: 0; color: #9b8661; }
.condition input { height: 72rpx; padding: 0 12rpx; border: 1rpx solid #e6dbc2; border-radius: 10rpx; box-sizing: border-box; background: #fffdf7; text-align: center; }
.search-page .add-condition { display: flex; align-items: center; justify-content: flex-start; min-height: 88rpx; color: #8b692a; font-size: 26rpx; }
.hint { display: block; padding: 10rpx 0; color: #9a8866; font-size: 23rpx; line-height: 1.65; }
.search-page .primary { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 18rpx 24rpx; border-radius: 16rpx; background: #ffcb46; color: #594018; font-size: 29rpx; font-weight: 600; }
.search-page .filter-apply { margin-top: 12rpx !important; width: 100%; }
.suggestions { margin-top: 16rpx; padding: 0 20rpx; border-radius: 16rpx; background: #fffdf7; }
.suggestions button { display: flex; align-items: center; gap: 16rpx; width: 100%; min-height: 88rpx; border-bottom: 1rpx solid #eee5d0; text-align: left; }
.suggestions button:last-child { border-bottom: 0; }.suggestions .ss-icon { transform: scale(.75); }.suggestions button > text { flex: 1; min-width: 0; }.suggestions .suggestion-arrow { flex: none; color: #ad9870; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.chips button { display: inline-flex; align-items: center; padding: 10rpx 14rpx; border-radius: 10rpx; background: #f5edda; color: #876b3b; font-size: 23rpx; }
.intro { padding: 20rpx 4rpx 8rpx; }
.quick-queries,.recent-queries { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; }
.search-page .quick-queries button,.search-page .recent-query { flex: 0 1 auto; min-width: 0; max-width: 100%; min-height: 44px; padding: 12rpx 20rpx; border-radius: 14rpx; background: #f2ecdd; color: #806a44; font-size: 25rpx; line-height: 1.5; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent .section-head { min-height: 72rpx; color: #806e4d; font-size: 26rpx; font-weight: 500; }
.result-group,.feature-list { margin: 0 -24rpx; padding: 0 24rpx; background: #fffdf7; }
.result-group .section-head,.feature-list .section-head { min-height: 76rpx; font-size: 26rpx; font-weight: 500; color: #8b7650; }
.result-row { position: relative; display: flex; align-items: center; gap: 20rpx; min-height: 152rpx; padding: 22rpx 0; box-sizing: border-box; }
.result-row::after { content: ''; position: absolute; left: 96rpx; right: 0; bottom: 0; height: 1rpx; background: #ede7d9; }
.result-thumbnail { flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 50%; background: #f4efdf; }
.result-placeholder { display: flex; align-items: center; justify-content: center; color: #a29070; font-size: 24rpx; }
.result-content { flex: 1; min-width: 0; }
.result-title-line { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 12rpx; }
.result-title-line .result-name { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
.source-tag { display: inline-block; flex-shrink: 0; padding: 4rpx 12rpx; border-radius: 999rpx; background: #fff1cf; color: #b97800; font-size: 20rpx; font-weight: 700; line-height: 1.2; }
.source-tag.mine { background: #e5f6ec; color: #2e9e5b; }
.source-tag.system { background: #eef3ff; color: #4d6fb8; }
.result-name { display: block; color: #4f432e; font-size: 32rpx; font-weight: 600; line-height: 1.4; overflow-wrap: break-word; }
.result-nutrition { display: flex; flex-wrap: wrap; align-items: baseline; margin-top: 6rpx; font-size: 26rpx; line-height: 1.45; }
.energy-value { color: #b66b32; font-weight: 500; }
.result-basis { color: #a1957c; font-size: 25rpx; }
.result-open-arrow { width: 14rpx; height: 14rpx; margin-right: 6rpx; color: #b7a789; }
.result-caption { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx 14rpx; margin-top: 6rpx; color: #9a896b; font-size: 22rpx; line-height: 1.5; }.source-label { color: #a99a80; font-size: 22rpx; }
.ingredient-caption { margin-top: 6rpx; color: #907b55; font-size: 25rpx; line-height: 1.6; }
.field-answers { padding-top: 10rpx; }
.question-title { display: block; color: #624e2d; font-size: 30rpx; line-height: 1.6; font-weight: 600; }
.choice-options { display: flex; flex-wrap: wrap; gap: 16rpx; padding-top: 16rpx; }
.search-page .choice-options button { min-height: 88rpx; min-width: 88rpx; padding: 18rpx 24rpx; border: 1rpx solid #e9ddbf; border-radius: 14rpx; background: #fffdf7; color: #795c2b; text-align: left; overflow-wrap: anywhere; }
.threshold-entry { display: flex; align-items: center; gap: 16rpx; padding-top: 16rpx; }
.threshold-entry input { min-width: 0; flex: 1; height: 88rpx; padding: 0 20rpx; background: #fffdf7; border: 1rpx solid #e9ddbf; border-radius: 12rpx; font-size: 28rpx; }
.summary-reading { padding: 24rpx 0 32rpx; }
.summary-value { display: inline-block; max-width: 100%; color: #725324; font-size: 58rpx; line-height: 1.35; font-weight: 600; overflow-wrap: anywhere; }
.summary-unit { margin-left: 12rpx; font-size: 25rpx; color: #9a8866; }
.comparison-result { padding: 20rpx 0; }
.comparison-values { display: flex; align-items: baseline; gap: 32rpx; padding: 16rpx 0; }
.comparison-values > view { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.comparison-values .answer-label { overflow-wrap: anywhere; }
.comparison-values .summary-value { font-size: 44rpx; }
.comparison-delta { display: block; color: #795c2b; font-size: 27rpx; }
.answer-actions { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; }
.search-page .answer-actions .text-button { justify-content: flex-start; padding-left: 0; }
.field-answer { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4rpx 16rpx; padding: 8rpx 0; }
.answer-label { color: #9a8866; font-size: 23rpx; }
.answer-value { min-width: 0; max-width: 100%; color: #6f5126; font-size: 30rpx; font-weight: 600; overflow-wrap: anywhere; }
.answer-missing { font-size: 25rpx; font-weight: 400; color: #9a8866; }
.answer-note,.answer-period { display: block; width: 100%; color: #9a8866; font-size: 22rpx; line-height: 1.6; }
.search-page .feature-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; width: 100%; min-height: 92rpx; border-top: 1rpx solid #eee5d1; text-align: left; }.feature-name { flex: 1; min-width: 0; }.feature-row .ss-icon-arrow { width: 15rpx; height: 15rpx; color: #b09b75; margin-right: 6rpx; }
.group-state { display: flex; align-items: center; gap: 14rpx; padding: 24rpx 0; color: #9c8862; font-size: 25rpx; line-height: 1.65; }.group-error { margin-bottom: 16rpx; }.warning { padding-bottom: 0; }
.search-page .more-button { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 100%; min-height: 88rpx; color: #8d6c30; font-size: 25rpx; }.row-pressed { background: #fbf4e0; }
.status-spinner { width: 24rpx; height: 24rpx; flex-shrink: 0; border: 3rpx solid #e9ddbb; border-top-color: #aa8645; border-radius: 50%; animation: search-spin .8s linear infinite; box-sizing: border-box; }@keyframes search-spin { to { transform: rotate(360deg); } }
.metric-results { padding: 24rpx 4rpx; }
.metric-heading { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: 12rpx; }
.metric-title-line { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.metric-title { font-size: 32rpx; font-weight: 600; color: #5f4b2d; }
.metric-period { color: #9a8866; font-size: 24rpx; line-height: 1.6; }
.search-page .metric-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; width: 100%; min-height: 104rpx; padding: 18rpx 0; border-bottom: 1rpx solid #eee2c9; text-align: left; }
.metric-date { color: #8b7650; font-size: 27rpx; }
.metric-reading { display: flex; align-items: center; gap: 24rpx; min-width: 0; }
.metric-value { color: #765626; font-size: 36rpx; font-weight: 600; line-height: 1.5; }
.metric-unit { flex-shrink: 0; color: #9a8866; font-size: 23rpx; font-weight: 400; }
.metric-missing { color: #9a8866; font-size: 24rpx; }
.metric-reading .ss-icon-arrow { width: 14rpx; height: 14rpx; margin-right: 6rpx; color: #b7a789; }
.search-page .metric-notes-toggle { justify-content: flex-start; padding-left: 0; font-size: 23rpx; color: #9a8866; }
.medication-detail { align-items: flex-start; }
.medication-detail > text:first-child { flex-shrink: 0; }
.medication-detail .nutrient-value { min-width: 0; text-align: right; overflow-wrap: break-word; }
.preview-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(48,35,12,.32); z-index: 30; }
.preview { position: fixed; z-index: 31; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; max-height: 84vh; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fffdf7; box-sizing: border-box; }
.preview-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }.preview-heading { flex: 1; min-width: 0; }.preview-source { display: block; color: #9c8862; font-size: 23rpx; }.preview-title { display: block; margin-top: 10rpx; font-size: 34rpx; font-weight: 600; line-height: 1.45; overflow-wrap: break-word; }.preview-basis { display: block; margin: 14rpx 0 18rpx; color: #9c8862; font-size: 24rpx; }.preview-body { height: 46vh; flex-shrink: 1; min-height: 160rpx; }.preview-nutrient { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eee5d1; font-size: 28rpx; }.nutrient-value { font-weight: 500; color: #725c39; }.preview-action { flex-shrink: 0; margin-top: 22rpx !important; }.ingredients { font-size: 27rpx; line-height: 1.6; }.ingredients > text { display: block; padding: 18rpx 0; border-bottom: 1rpx solid #eee5d1; }.occurrence-heading { margin-top: 20rpx; }.search-page .occurrence-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; width: 100%; min-height: 100rpx; padding: 14rpx 0; border-bottom: 1rpx solid #eee5d1; text-align: left; }.occurrence-row > view:first-child { flex: 1; min-width: 0; }.occurrence-row .ss-icon-arrow { width: 15rpx; height: 15rpx; }
@media (max-width: 350px) { .search-page { padding-right: 20rpx; padding-left: 20rpx; }.search-bar { padding-left: 14rpx; }.search-bar > .ss-icon { margin-right: 8rpx; }.search-filterbar,.result-group,.feature-list { margin-left: -20rpx; margin-right: -20rpx; padding-left: 20rpx; padding-right: 20rpx; }.search-filterbar { gap: 8rpx; }.source-filter { max-width: 180rpx; }.result-thumbnail { width: 68rpx; height: 68rpx; }.result-row { gap: 16rpx; }.result-row::after { left: 84rpx; }.result-name { font-size: 31rpx; }.search-toolbar { gap: 8rpx; }.intro-title { font-size: 34rpx; }.condition-values { gap: 8rpx; }.condition-values picker { font-size: 24rpx; padding-right: 6rpx; padding-left: 6rpx; } }
@media (prefers-reduced-motion: reduce) { .status-spinner { animation: none; } }
