page { height: 100%; background: #171916; color: #fffdf5; }
.scan-page { position: relative; width: 100%; height: 100vh; overflow: hidden; background: #171916; }
.camera-preview { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }

/* 相机上方使用原生覆盖层，避免普通视图被取景画面遮挡。 */
.camera-nav { position: absolute; left: 0; z-index: 2; }
/* 与标题一样直接使用原生文本覆盖层，避开图片加载和嵌套弹性布局。 */
.camera-back-button { position: absolute; left: 0; width: 44px; height: 44px; margin: 0; padding: 0; color: #fffdf5; font-family: Arial, sans-serif; font-size: 28px; font-weight: 400; line-height: 42px; text-align: center; }
.nav-title { position: absolute; left: 44px; top: 0; height: 100%; font-size: 16px; font-weight: 500; color: #fffdf5; }
.package-slots { position: absolute; left: 20px; right: 20px; display: flex; justify-content: center; }
/* 角标与照片框并列放置，跨在圆角处时不会被照片框裁切。 */
.photo-slot-wrapper { position: relative; width: 45%; height: 59px; margin: 0 4px; }
.photo-slot { position: absolute; top: 11px; left: 0; right: 11px; display: flex; align-items: center; height: 48px; border: 1px solid rgba(255,255,255,.4); border-radius: 10px; background: rgba(23,25,22,.65); box-sizing: border-box; }
.photo-slot.active { border: 2px solid #ffcf55; }
.slot-image,.slot-placeholder { flex-shrink: 0; width: 36px; height: 36px; margin-left: 5px; border-radius: 5px; }
.slot-placeholder { color: #fffdf5; font-size: 24px; line-height: 36px; text-align: center; }
.slot-caption { flex: 1; min-width: 0; margin-left: 6px; color: #fffdf5; font-size: 12px; line-height: 20px; white-space: normal; }
.slot-remove { position: absolute; top: 0; right: 0; width: 44px; height: 44px; }
.slot-remove-icon { position: absolute; top: 0; right: 0; width: 22px; height: 22px; border-radius: 11px; background: rgba(0,0,0,.7); color: #ffffff; font-size: 20px; line-height: 20px; text-align: center; }
.photo-slot.filled .slot-caption { color: #ffdf80; }
.camera-hint { position: absolute; top: 24%; left: 8%; width: 84%; color: #fffdf5; font-size: 27rpx; line-height: 1.6; text-align: center; white-space: normal; }
/* 使用一个完整边框，四角共用圆角，避免原生覆盖层独立角标的形状差异。 */
.viewfinder { position: absolute; top: 30%; left: 10%; width: 80%; height: 34%; border: 2px solid rgba(255, 253, 245, .9); border-radius: 24rpx; box-sizing: border-box; }
.camera-status { position: absolute; left: 40rpx; right: 40rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: rgba(23, 25, 22, .7); color: #fffdf5; font-size: 25rpx; line-height: 1.5; text-align: center; white-space: normal; }

.camera-controls { position: absolute; left: 0; right: 0; bottom: 0; padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom)); background: rgba(23, 25, 22, .28); }
.recognition-tabs { display: flex; align-items: center; justify-content: center; margin-bottom: 34rpx; }
.recognition-tab { width: 168rpx; min-height: 44px; margin: 0 12rpx; border-radius: 16rpx; background: rgba(23, 25, 22, .42); color: #fffdf5; font-size: 30rpx; font-weight: 500; line-height: 44px; text-align: center; }
.recognition-tab.selected { background: #fffdf5; color: #373b31; font-weight: 600; }
.capture-actions { display: flex; align-items: center; justify-content: space-between; }
.side-action { display: flex; flex-direction: column; align-items: center; width: 120rpx; min-width: 44px; padding: 8rpx 0; }
.tool-circle { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 50%; background: rgba(23, 25, 22, .4); }
.action-label { margin-top: 12rpx; color: #fffdf5; font-size: 23rpx; line-height: 1.5; text-align: center; }
.album-icon { position: relative; width: 40rpx; height: 40rpx; overflow: hidden; border: 4rpx solid #fffdf5; border-radius: 10rpx; }
.album-sun { position: absolute; top: 7rpx; left: 7rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #fffdf5; }
.album-mountain { position: absolute; top: 24rpx; left: 13rpx; width: 30rpx; height: 30rpx; border: 4rpx solid #fffdf5; border-radius: 6rpx; transform: rotate(45deg); }
.help-icon { color: #fffdf5; font-size: 54rpx; font-weight: 500; line-height: 84rpx; text-align: center; }
.shutter { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 136rpx; height: 136rpx; margin-bottom: 30rpx; border: 5rpx solid #fffdf5; border-radius: 50%; }
.shutter-core { width: 112rpx; height: 112rpx; border-radius: 50%; background: #ffcf55; color: #44351b; font-size: 30rpx; font-weight: 600; line-height: 112rpx; text-align: center; }
.controls-disabled { opacity: .4; }

/* 只有权限、服务异常或保存结果需要说明时才展示状态面板。 */
.screen-state { position: absolute; left: 40rpx; right: 40rpx; bottom: calc(310rpx + env(safe-area-inset-bottom)); }
.screen-state.result-state { bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.state-scroll { height: 100%; }
.state-content { padding: 28rpx 0; text-align: center; }
.state-title,.state-description,.state-error { display: block; }
.state-title { color: #fffdf5; font-size: 36rpx; font-weight: 600; line-height: 1.5; }
.state-description { margin-top: 20rpx; color: #d7dacd; font-size: 28rpx; line-height: 1.8; overflow-wrap: break-word; }
.state-error { margin-top: 16rpx; color: #ffcf8a; font-size: 26rpx; line-height: 1.6; }
.scan-page .state-content button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; max-width: 480rpx; margin: 24rpx auto 0; padding: 22rpx 24rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; min-height: 44px; text-align: center; }
.scan-page button::after { border: 0; }
.scan-page button[disabled] { opacity: .45; }
.state-primary { background: #ffcf55; color: #44351b; font-weight: 600; }
.state-secondary { background: #353a30; color: #fffdf5; }
.state-link { background: transparent; color: #d7dacd; }
@media (max-height: 600px) {
  .camera-hint { top: 22%; }
  .viewfinder { top: 29%; height: 31%; }
  .camera-controls { padding-top: 20rpx; }
  .recognition-tabs { margin-bottom: 20rpx; }
  .shutter { width: 116rpx; height: 116rpx; }
  .shutter-core { width: 94rpx; height: 94rpx; line-height: 94rpx; }
  .screen-state { bottom: calc(280rpx + env(safe-area-inset-bottom)); }
}
