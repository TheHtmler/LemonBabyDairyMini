@import "../../styles/search-scan.wxss";
page { background: #fff9e6; color: #473a22; }
.scan-page { padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.scan-page button { margin: 0; padding: 0; border-radius: 0; background: transparent; color: inherit; font-size: 27rpx; line-height: 1.45; box-sizing: border-box; }.scan-page button::after { border: 0; }.scan-page button[disabled] { opacity: .45; }
.eyebrow,.title,.description,.footnote { display: block; }.eyebrow { color: #9a8866; font-size: 24rpx; line-height: 1.5; }.title { margin-top: 16rpx; font-size: 40rpx; font-weight: 600; line-height: 1.4; }.description { margin-top: 12rpx; color: #9a8866; font-size: 27rpx; line-height: 1.7; }
.scan-guide { margin-top: 32rpx; padding: 24rpx; border: 1rpx solid #eadfc5; border-radius: 22rpx; background: #fffdf7; }.guide-header { display: flex; align-items: center; gap: 20rpx; padding-bottom: 24rpx; }.guide-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 18rpx; background: #f8edcd; }.guide-icon .ss-icon { color: #987740; transform: scale(1.2); }.guide-heading { flex: 1; min-width: 0; }.guide-title,.guide-caption { display: block; }.guide-title { color: #78613b; font-size: 28rpx; font-weight: 500; line-height: 1.55; }.guide-caption { margin-top: 8rpx; color: #a18b64; font-size: 24rpx; line-height: 1.5; }
.guide-row { display: flex; align-items: flex-start; gap: 22rpx; padding: 18rpx 0; border-top: 1rpx solid #efe6d2; color: #9a8866; font-size: 25rpx; line-height: 1.65; }.guide-row:last-child { padding-bottom: 0; }.guide-label { flex: 0 0 112rpx; color: #806947; font-weight: 500; }.guide-row > text:last-child { flex: 1; min-width: 0; }
.service-state { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 20rpx; border-radius: 16rpx; background: #f4eddb; color: #8e7953; font-size: 25rpx; line-height: 1.6; }.error-state { background: #fff0d5; color: #9c6638; }.success-state { background: #eef2dc; color: #637c3c; }.state-copy { flex: 1; min-width: 0; }.state-copy > text { display: block; overflow-wrap: break-word; }.state-title { margin-bottom: 6rpx; font-weight: 600; font-size: 27rpx; }.scan-page .retry-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-width: 88rpx; min-height: 80rpx; padding: 12rpx; color: #8b672c; font-size: 26rpx; }
.state-spinner { width: 26rpx; height: 26rpx; flex-shrink: 0; border: 3rpx solid #eadcba; border-top-color: #aa8645; border-radius: 50%; box-sizing: border-box; animation: scan-spin .8s linear infinite; }@keyframes scan-spin { to { transform: rotate(360deg); } }
.scan-actions { display: flex; align-items: stretch; gap: 16rpx; margin-top: 28rpx; }.scan-page .primary,.scan-page .secondary { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 96rpx; gap: 12rpx; padding: 20rpx 16rpx; border-radius: 18rpx; font-size: 29rpx; font-weight: 500; white-space: nowrap; }.scan-page .primary { background: #ffcb46; color: #594018; }.scan-page .secondary { border: 1rpx solid #e8dbc0; background: #fffdf7; color: #826b46; }.scan-actions .ss-icon { color: inherit; transform: scale(.9); }.footnote { margin-top: 22rpx; color: #a18d69; font-size: 24rpx; line-height: 1.75; }
.pending-state { margin-top: 24rpx; color: #90784f; font-size: 26rpx; line-height: 1.6; }.scan-page .full-width { width: 100%; margin-top: 16rpx; }
.manual-section { margin-top: 36rpx; padding-top: 24rpx; border-top: 1rpx solid #eadfc5; }.manual-title { display: block; color: #9a8866; font-size: 25rpx; }.manual-actions { display: flex; gap: 24rpx; margin-top: 12rpx; }.manual-actions button { display: flex; align-items: center; justify-content: space-between; flex: 1; gap: 12rpx; min-height: 88rpx; color: #876c3b; font-size: 26rpx; text-align: left; }.manual-actions .ss-icon-arrow { width: 14rpx; height: 14rpx; color: #b09b75; margin-right: 6rpx; }
@media (max-width: 350px) { .scan-page { padding-left: 24rpx; padding-right: 24rpx; }.title { font-size: 38rpx; }.scan-guide { padding: 20rpx; }.scan-actions { gap: 12rpx; }.scan-page .primary,.scan-page .secondary { gap: 8rpx; font-size: 27rpx; padding-right: 10rpx; padding-left: 10rpx; }.guide-label { flex-basis: 108rpx; } }
@media (prefers-reduced-motion: reduce) { .state-spinner { animation: none; } }
