<view class="scan-page">
  <view class="scan-heading"><text class="eyebrow">{{babyName || '当前宝宝'}}的资料库</text><text class="title">拍下名称和营养表</text><text class="description">食物、奶粉都支持，识别后由你核对。</text></view>
  <view class="scan-guide">
    <view class="guide-header"><view class="guide-icon"><view class="ss-icon ss-icon-camera" aria-hidden="true"><view class="ss-camera-lens"></view></view></view><view class="guide-heading"><text class="guide-title">拍清晰一点，识别更准确</text><text class="guide-caption">避开反光，让文字完整入镜</text></view></view>
    <view class="guide-row"><text class="guide-label">食品包装</text><text>拍下产品名称和完整营养表</text></view>
    <view class="guide-row"><text class="guide-label">食物实物</text><text>拍清晰全貌，先识别食物名称</text></view>
  </view>

  <view class="service-state loading-state" wx:if="{{loading}}"><view class="state-spinner"></view><text>正在连接识别服务…</text></view>
  <view class="service-state error-state" wx:elif="{{error}}" role="alert"><view class="state-copy"><text class="state-title">{{available ? '请重试本次操作' : '暂时无法识别'}}</text><text>{{error}}</text></view><button class="retry-button" bindtap="retryAvailability" disabled="{{capturing}}">重试</button></view>
  <view class="service-state success-state" wx:if="{{saved}}"><view class="state-copy"><text class="state-title">已加入{{babyName}}的资料库</text><text>可以继续识别，也可以查看资料。</text></view><button class="retry-button" bindtap="openLibrary">查看</button></view>
  <view class="service-state" wx:if="{{existing}}"><view class="state-copy"><text class="state-title">资料库已有相同物品</text><text>查看并核对已有资料。</text></view><button class="retry-button" bindtap="openLibrary">查看</button></view>

  <view class="pending-state" wx:if="{{pending}}"><text>上次保存结果待确认，请先恢复状态。</text><button class="primary full-width" bindtap="recover" loading="{{recovering}}" disabled="{{recovering}}">恢复保存状态</button></view>
  <view class="scan-actions" wx:else>
    <button class="primary" bindtap="takePhoto" disabled="{{!available || loading || capturing}}"><view class="ss-icon ss-icon-camera" aria-hidden="true"><view class="ss-camera-lens"></view></view><text>拍照识别</text></button>
    <button class="secondary" bindtap="chooseAlbum" disabled="{{!available || loading || capturing}}"><view class="ss-icon ss-icon-album" aria-hidden="true"></view><text>从相册选择</text></button>
  </view>
  <text class="footnote">可补拍最多 3 张。识别结果不会自动保存，缺失营养可在保存前补齐。</text>

  <view class="manual-section" wx:if="{{!loading && !available}}"><text class="manual-title">也可以手动填写资料</text><view class="manual-actions"><button data-kind="food" bindtap="openManual"><text>打开食物库</text><view class="ss-icon ss-icon-arrow"></view></button><button data-kind="powder" bindtap="openManual"><text>打开奶粉库</text><view class="ss-icon ss-icon-arrow"></view></button></view></view>
  <nutrition-recognition id="scanner" mode="auto" purpose="preview" show-trigger="{{false}}" baby-uid="{{babyUid}}" baby-name="{{babyName}}" form-session-id="{{formSessionId}}" category-options="{{categories}}" powder-category-options="{{powderCategories}}" protein-options="{{proteinOptions}}" bind:saved="onSaved" bind:existing="onExisting" />
</view>
