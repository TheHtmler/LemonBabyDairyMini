/* pages/add-report/index.wxss */

.container {
  display: block;
  width: 100%;
  min-height: 100vh;
  align-items: stretch;
  padding: 0;
  background: #f6f8fb;
  box-sizing: border-box;
}

.content {
  width: 100%;
  padding: 20rpx 20rpx 240rpx;
  box-sizing: border-box;
}

.loading-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 420rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #d9dee7;
  border-top: 4rpx solid #2f6fed;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #76839a;
}

.report-meta-bar {
  margin-bottom: 20rpx;
  border: 1rpx solid #e1e6ed;
  border-radius: 14rpx;
  background: #ffffff;
  overflow: hidden;
}

.meta-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.meta-card--tappable:active {
  background: #f7faff;
}

.meta-label {
  flex-shrink: 0;
  width: 112rpx;
  font-size: 24rpx;
  color: #516072;
}

.meta-value {
  font-size: 26rpx;
  line-height: 1.4;
  color: #1f2d3d;
  font-variant-numeric: tabular-nums;
}

.meta-picker {
  display: block;
}

.meta-picker-content {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 14rpx;
  border-radius: 9rpx;
  background: #f9fbfd;
  border: 1rpx solid #dbe3ee;
  box-sizing: border-box;
}

.meta-chevron {
  font-size: 25rpx;
  color: #5376b4;
}

.institution-field {
  border-top: 1rpx solid #eef2f7;
}

.meta-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 14rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 9rpx;
  background: #f9fbfd;
  font-size: 24rpx;
  color: #1f2d3d;
  box-sizing: border-box;
}

.ocr-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border: 1rpx solid #f5e1a4;
}

.ocr-entry.recognizing {
  opacity: 0.7;
}

.ocr-entry-icon {
  font-size: 40rpx;
}

.ocr-entry-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ocr-entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #8a6d1f;
}

.ocr-entry-desc {
  font-size: 22rpx;
  color: #a3894a;
}

.indicator-list {
  margin-bottom: 24rpx;
}

.filled-progress {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e6ebf2;
  font-size: 24rpx;
  color: #516072;
}

.indicator-list {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid #e6ebf2;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(31, 45, 61, 0.04);
}

.indicator-row {
  padding: 16rpx 20rpx 18rpx;
  border-top: 1rpx solid #eef2f7;
}

.indicator-row:first-child {
  border-top: none;
}

.indicator-row.pending-ocr {
  background: #fffbf0;
  box-shadow: inset 4rpx 0 0 #f0b429;
}

.ocr-pending-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #92670f;
  background: #ffe9a8;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.ocr-pending-tag:active {
  opacity: 0.72;
}

.indicator-row-top {
  margin-bottom: 14rpx;
}

.indicator-meta {
  width: 100%;
}

.indicator-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.indicator-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.indicator-abbr {
  font-size: 22rpx;
  color: #7b8798;
}

.required-mark {
  font-size: 28rpx;
  color: #e5484d;
  font-weight: 700;
}

.compact-input-grid {
  display: grid;
  grid-template-columns: 2.1fr 1fr 1fr;
  gap: 8rpx;
  align-items: end;
}

.compact-input-grid.value-only {
  grid-template-columns: minmax(0, 1fr);
}

.compact-cell {
  min-width: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.compact-cell.value-cell {
  width: 100%;
}

.compact-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 28rpx;
  margin-bottom: 6rpx;
  box-sizing: border-box;
}

.compact-label {
  display: block;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #8a95a5;
}

.value-unit {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 28rpx;
  font-weight: 500;
  color: #7b8798;
}

.compact-input {
  width: 100%;
  height: 68rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid #dbe3ee;
  background: #f9fbfd;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #1f2d3d;
}

.optimal-range {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #eff5ff;
}

.optimal-label {
  font-size: 22rpx;
  color: #5376b4;
  margin-right: 8rpx;
}

.optimal-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #2f6fed;
}

.bottom-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 20rpx calc(env(safe-area-inset-bottom) + 14rpx);
  background: #ffffff;
  border-top: 1rpx solid #e6ebf2;
  box-sizing: border-box;
  z-index: 20;
  box-shadow: 0 -8rpx 24rpx rgba(31, 45, 61, 0.06);
}

.disclaimer {
  margin-bottom: 10rpx;
}

.disclaimer-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a95a5;
  text-align: center;
}

.save-section {
  display: flex;
  width: 100%;
}

.container button.save-button {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 18rpx;
  background: #2f6fed;
  box-shadow: 0 8rpx 18rpx rgba(47, 111, 237, 0.26);
}

.save-button[disabled] {
  background: #b7c3d6;
  box-shadow: none;
}

.save-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}
