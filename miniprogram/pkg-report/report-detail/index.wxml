<view class="detail-page">
  <view wx:if="{{loading}}" class="empty-state">正在加载报告…</view>
  <block wx:else>
    <view wx:if="{{loadError}}" class="error-banner"><text>{{loadError}}</text><button class="text-button" bindtap="loadReportData">重试</button></view>
    <block wx:if="{{reportData}}">
      <view class="report-heading">
        <text class="report-title">{{reportData.reportTypeName}}</text>
      </view>
      <view class="report-meta"><text>{{reportData.formattedDate}}</text><text wx:if="{{reportData.labName}}" class="lab-name">{{reportData.labName}}</text></view>
      <view class="detail-actions">
        <button class="primary-button" disabled="{{deleting}}" bindtap="onCompareReport">{{compareLabel}}</button>
        <view class="secondary-actions">
          <button class="outline-button" disabled="{{deleting}}" bindtap="onEditReport">编辑</button>
          <button class="outline-button" disabled="{{deleting}}" bindtap="onMoreActions">{{deleting ? '删除中…' : '更多'}}</button>
        </view>
      </view>
      <view class="detail-sheet">
        <view class="detail-tabs">
          <button class="detail-tab {{detailTab === 'full' ? 'active' : ''}}" data-tab="full" bindtap="switchDetailTab">{{showMissing ? '全部项目' : '已录入'}} {{showMissing ? reportSummary.totalCount : reportSummary.filledCount}}</button>
          <button class="detail-tab {{detailTab === 'focus' ? 'active' : ''}}" data-tab="focus" bindtap="switchDetailTab">仅看异常 <text class="abnormal-count">{{reportSummary.abnormalCount}}</text></button>
        </view>
        <view wx:if="{{!visibleRows.length}}" class="empty-state">
          <text>{{!reportSummary.filledCount ? '尚未录入检测值' : reportSummary.unknownCount ? '没有已判定的超范围指标，部分指标待核对' : '已录入指标在参考范围内'}}</text>
          <button wx:if="{{!reportSummary.filledCount}}" class="text-button" bindtap="onEditReport">补充检测值</button>
          <button wx:else class="text-button" data-tab="full" bindtap="switchDetailTab">查看已录入指标</button>
        </view>
        <view wx:else class="data-table">
          <view class="table-row table-head"><text class="name-col">检验项目 / 单位</text><text class="value-col">检测值</text><text class="range-col">参考范围</text></view>
          <view wx:for="{{visibleRows}}" wx:key="key" class="table-row">
            <view class="name-col"><text>{{item.name}}</text><text wx:if="{{item.secondaryText}}" class="secondary">{{item.secondaryText}}</text></view>
            <view class="value-col {{item.statusClass}}"><view class="value-line"><text class="number">{{item.valueText}}</text><text wx:if="{{item.marker}}" class="marker">{{item.marker}}</text></view><text wx:if="{{item.status === 'unknown'}}" class="secondary status-text">{{item.statusText}}</text></view>
            <view class="range-col"><text>{{item.rangeText || '未提供'}}</text><text wx:if="{{item.optimalRangeText}}" class="secondary">最优 {{item.optimalRangeText}}</text></view>
          </view>
        </view>
        <button wx:if="{{detailTab === 'full' && reportSummary.missingCount}}" class="missing-toggle" bindtap="toggleMissingIndicators">{{showMissing ? '收起' : '展开'}}未录入的 {{reportSummary.missingCount}} 项 {{showMissing ? '⌃' : '⌄'}}</button>
        <text class="note">↑ 偏高　↓ 偏低 · 按本份报告参考范围判断</text>
      </view>
      <text class="updated-at">更新于 {{reportData.formattedUpdatedAt}}</text>
    </block>
  </block>
</view>
