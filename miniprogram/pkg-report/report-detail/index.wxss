page { background: #faf6ed; color: #283b32; font-size: 26rpx; }
.detail-page { width: 100%; min-width: 0; padding: 8rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.detail-page view { box-sizing: border-box; }
/* 覆盖原生按钮宽度和自动边距，避免工具栏、页签被挤到页面中间。 */
.detail-page button[class] { width: auto; min-width: 0; max-width: 100%; margin: 0; padding: 0; box-sizing: border-box; font-size: inherit; font-weight: 400; line-height: 1.45; background: transparent; border-radius: 0; color: inherit; }
.detail-page button::after { border: 0; }
.detail-page button[disabled] { opacity: .45; }
.detail-page .report-heading { padding: 14rpx 0 10rpx; }
.detail-page .report-title { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 500; }
.detail-page .secondary-actions { display: flex; flex-shrink: 0; gap: 12rpx; }
.detail-page button.outline-button { min-width: 100rpx; min-height: 64rpx; padding: 14rpx 20rpx; border: 1rpx solid #a8bba1; border-radius: 10rpx; background: #fffdf8; color: #376c55; font-size: 23rpx; white-space: nowrap; }
.detail-page .outline-button:active { background: #e6edde; }
.detail-page button.text-button { color: #376c55; font-size: 23rpx; padding: 14rpx 6rpx; min-height: 64rpx; flex-shrink: 0; white-space: nowrap; }
.detail-page .report-meta { display: flex; justify-content: space-between; gap: 14rpx; font-size: 22rpx; color: #687564; }
.detail-page .report-meta > text:first-child { flex-shrink: 0; }
.detail-page .lab-name { min-width: 0; text-align: right; overflow-wrap: break-word; }
.detail-page .detail-actions { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; padding: 16rpx 0 20rpx; }
.detail-page button.primary-button { flex-shrink: 0; min-height: 64rpx; background: #f3cf64; color: #3c351c; font-size: 23rpx; padding: 15rpx 20rpx; border-radius: 10rpx; white-space: nowrap; }
.detail-page .detail-sheet { width: 100%; background: #fffdf8; padding: 0 10rpx; border-radius: 10rpx; }
.detail-page .detail-tabs { display: flex; border-bottom: 1rpx solid #dedfd5; }
.detail-page button.detail-tab { flex: 1 1 0%; padding: 16rpx 0; position: relative; color: #747d70; font-size: 25rpx; }
.detail-page .detail-tab.active { color: #283b32; font-weight: 500; }
.detail-page .detail-tab.active::before { content: ''; position: absolute; height: 4rpx; background: #376c55; left: 22%; right: 22%; bottom: -1rpx; border-radius: 3rpx; }
.detail-page .abnormal-count { font-size: 21rpx; color: #a54737; background: #f9eae2; border-radius: 5rpx; padding: 2rpx 7rpx; }
.detail-page .data-table { width: 100%; }
.detail-page .table-row { display: flex; align-items: center; width: 100%; min-height: 76rpx; border-bottom: 1rpx solid #e7e8de; }
.detail-page .table-row:last-child { border-bottom: 0; }
.detail-page .table-row > view, .detail-page .table-row > text { flex-shrink: 0; min-width: 0; padding: 12rpx 6rpx; box-sizing: border-box; overflow-wrap: break-word; word-break: break-all; }
.detail-page .table-head { color: #747d70; font-size: 21rpx; min-height: 52rpx; }
.detail-page .name-col { width: 40%; font-size: 23rpx; line-height: 1.4; }
.detail-page .table-head .name-col { font-size: 21rpx; }
.detail-page .value-col { width: 26%; text-align: right; }
.detail-page .range-col { width: 34%; text-align: right; font-size: 22rpx; font-variant-numeric: tabular-nums; }
.detail-page .secondary { display: block; font-size: 20rpx; line-height: 1.4; color: #747d70; margin-top: 3rpx; font-weight: 400; }
.detail-page .status-text { color: inherit; }
.detail-page .value-line { display: flex; justify-content: flex-end; align-items: baseline; min-width: 0; }
.detail-page .number { min-width: 0; font-size: 26rpx; line-height: 1.4; font-weight: 500; font-variant-numeric: tabular-nums; }
.detail-page .marker { flex-shrink: 0; margin-left: 4rpx; font-size: 20rpx; }
.detail-page .high, .detail-page .low, .detail-page .warn { color: #a54737; }
.detail-page .unknown, .detail-page .empty { color: #747d70; }
.detail-page button.missing-toggle { width: 100%; min-height: 64rpx; padding: 16rpx 4rpx; border-top: 1rpx solid #e7e8de; color: #376c55; font-size: 22rpx; }
.detail-page .note { display: block; padding: 14rpx 4rpx; color: #747d70; font-size: 21rpx; line-height: 1.5; }
.detail-page .updated-at { color: #747d70; font-size: 20rpx; display: block; text-align: center; padding: 16rpx 0; }
.detail-page .empty-state { display: flex; flex-direction: column; align-items: center; padding: 32rpx 12rpx; gap: 12rpx; font-size: 24rpx; text-align: center; }
.detail-page .error-banner { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; background: #f9eae2; color: #a54737; padding: 8rpx 12rpx; font-size: 23rpx; margin: 10rpx 0; }
