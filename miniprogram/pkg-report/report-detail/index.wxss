page { background: #faf6ed; color: #283b32; font-size: 26rpx; }
.detail-page { width: 100%; min-width: 0; padding: 8rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.detail-page view { box-sizing: border-box; }
/* 重置原生按钮尺寸，最小高度提供触控面积，文字由弹性布局双向居中。 */
.detail-page button[class] { display: flex; align-items: center; justify-content: center; height: auto; width: auto; min-width: 0; max-width: 100%; margin: 0; padding: 0; box-sizing: border-box; font-size: inherit; font-weight: 400; line-height: 1.3; background: transparent; border-radius: 0; color: inherit; }
.detail-page button::after { border: 0; }
.detail-page button[disabled] { opacity: .45; }
.detail-page .report-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 20rpx; padding: 14rpx 0 10rpx; }
.detail-page .report-title { flex: 1 1 220rpx; min-width: 0; font-size: 29rpx; font-weight: 500; overflow-wrap: break-word; }
.detail-page .baby-name { min-width: 0; max-width: 100%; font-size: 23rpx; color: #52664f; overflow-wrap: break-word; }
.detail-page .secondary-actions { display: flex; flex-shrink: 0; gap: 12rpx; }
.detail-page .report-export-canvas { position: fixed; left: -10000px; top: 0; width: 620px; height: 877px; pointer-events: none; }
.detail-page button.outline-button { min-width: 100rpx; min-height: 64rpx; padding: 14rpx 20rpx; border: 1rpx solid #a8bba1; border-radius: 10rpx; background: #fffdf8; color: #376c55; font-size: 23rpx; white-space: nowrap; }
.detail-page .outline-button:active { background: #e6edde; }
.detail-page button.text-button { color: #376c55; font-size: 23rpx; padding: 14rpx 6rpx; min-height: 64rpx; flex-shrink: 0; white-space: nowrap; }
.detail-page .report-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6rpx 14rpx; font-size: 22rpx; color: #596650; line-height: 1.5; }
.detail-page .report-meta > text:first-child { flex-shrink: 0; }
.detail-page .lab-name { min-width: 0; flex: 1 1 240rpx; text-align: right; overflow-wrap: break-word; }
.detail-page .detail-actions { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx; padding: 16rpx 0 20rpx; }
.detail-page button.primary-button { flex-shrink: 0; min-height: 64rpx; background: #f3cf64; color: #3c351c; font-size: 23rpx; padding: 15rpx 20rpx; border-radius: 10rpx; white-space: nowrap; }
.detail-page .detail-sheet { width: 100%; background: #fffdf8; padding: 0 10rpx; border-radius: 10rpx; }
.detail-page .detail-tabs { display: flex; border-bottom: 1rpx solid #dedfd5; }
.detail-page button.detail-tab { flex: 1 1 0%; min-height: 78rpx; padding: 20rpx 2rpx; position: relative; color: #5d6958; font-size: 24rpx; }
.detail-page .detail-tab.active { color: #283b32; font-weight: 500; }
.detail-page .detail-tab.active::before { content: ''; position: absolute; height: 4rpx; background: #376c55; left: 22%; right: 22%; bottom: -1rpx; border-radius: 3rpx; }
.detail-page .tab-count { font-size: 21rpx; border-radius: 5rpx; padding: 2rpx 6rpx; }
.detail-page .abnormal-count { color: #a54737; background: #f9eae2; }
.detail-page .review-count { color: #765b2f; background: #f3ead3; }
.detail-page .data-table { width: 100%; }
.detail-page .table-row { display: flex; align-items: center; width: 100%; min-height: 76rpx; padding-right: 24rpx; border-bottom: 1rpx solid #e7e8de; }
.detail-page .table-row:last-child { border-bottom: 0; }
.detail-page .table-row > view, .detail-page .table-row > text { flex-shrink: 0; min-width: 0; padding: 12rpx 6rpx; box-sizing: border-box; overflow-wrap: break-word; word-break: break-all; }
.detail-page .table-head { color: #747d70; font-size: 21rpx; min-height: 52rpx; }
.detail-page .indicator-row { position: relative; min-height: 84rpx; }
.detail-page .indicator-row::after { content: ''; position: absolute; top: 50%; right: 6rpx; width: 10rpx; height: 10rpx; border-top: 2rpx solid #8a9384; border-right: 2rpx solid #8a9384; transform: translateY(-50%) rotate(45deg); }
.detail-page .indicator-row-pressed, .detail-page .focused-row { background: #f4f0df; }
.detail-page .name-col { width: 40%; font-size: 23rpx; line-height: 1.4; }
.detail-page .table-head .name-col { font-size: 21rpx; }
.detail-page .value-col { width: 26%; text-align: right; }
.detail-page .range-col { width: 34%; text-align: right; font-size: 22rpx; font-variant-numeric: tabular-nums; }
.detail-page .secondary { display: block; font-size: 20rpx; line-height: 1.4; color: #626e5c; margin-top: 3rpx; font-weight: 400; }
.detail-page .value-line { display: flex; justify-content: flex-end; align-items: baseline; min-width: 0; }
.detail-page .number { min-width: 0; font-size: 26rpx; line-height: 1.4; font-weight: 500; font-variant-numeric: tabular-nums; }
.detail-page .marker { flex-shrink: 0; margin-left: 4rpx; font-size: 20rpx; }
.detail-page .high, .detail-page .low, .detail-page .warn { color: #a54737; }
.detail-page .unknown { color: #765b2f; }
.detail-page .empty { color: #626e5c; }
.detail-page button.missing-toggle { width: 100%; min-height: 64rpx; padding: 16rpx 4rpx; border-top: 1rpx solid #e7e8de; color: #376c55; font-size: 22rpx; }
.detail-page .toggle-chevron { flex-shrink: 0; width: 10rpx; height: 10rpx; margin: -5rpx 0 0 14rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); }
.detail-page .toggle-chevron.expanded { margin-top: 5rpx; transform: rotate(225deg); }
.detail-page .empty-state { display: flex; flex-direction: column; align-items: center; padding: 32rpx 12rpx; gap: 12rpx; font-size: 24rpx; text-align: center; }
.detail-page .error-banner { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; background: #f9eae2; color: #a54737; padding: 8rpx 12rpx; font-size: 23rpx; margin: 10rpx 0; }
/* 明细按需展开，表格保持紧凑；长原始结果在面板中完整换行。 */
.detail-page .indicator-mask { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: flex-end; background: rgba(30, 42, 32, .38); }
.detail-page .indicator-panel { width: 100%; max-height: 86vh; display: flex; flex-direction: column; background: #fffdf8; border-radius: 22rpx 22rpx 0 0; padding-bottom: env(safe-area-inset-bottom); }
.detail-page .panel-heading { flex-shrink: 0; display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding: 16rpx 24rpx 8rpx; border-bottom: 1rpx solid #e7e8de; }
.detail-page .panel-title-block { flex: 1; min-width: 0; padding: 14rpx 0; }
.detail-page .panel-title { display: block; font-size: 29rpx; font-weight: 500; line-height: 1.5; overflow-wrap: break-word; }
.detail-page button.panel-close { flex-shrink: 0; min-width: 88rpx; min-height: 88rpx; padding: 20rpx 10rpx; color: #376c55; font-size: 25rpx; }
.detail-page .panel-scroll { flex: 1 1 auto; min-height: 0; height: 40vh; }
.detail-page .panel-content { padding: 12rpx 24rpx 20rpx; }
.detail-page .fact-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e7e8de; font-size: 26rpx; line-height: 1.5; }
.detail-page .fact-label { flex: 0 0 176rpx; color: #596650; }
.detail-page .fact-value { flex: 1; min-width: 0; text-align: right; font-variant-numeric: tabular-nums; overflow-wrap: break-word; word-break: break-all; }
.detail-page .panel-explanation { display: block; padding: 12rpx 0; font-size: 23rpx; line-height: 1.6; color: #626e5c; }
.detail-page .review-explanation { display: block; padding: 14rpx 16rpx; margin: 12rpx 0 4rpx; font-size: 24rpx; line-height: 1.6; color: #765b2f; background: #f6efde; border-radius: 8rpx; }
.detail-page .panel-actions { flex-shrink: 0; padding: 12rpx 24rpx 20rpx; border-top: 1rpx solid #e7e8de; }
.detail-page .panel-actions button.primary-button { width: 100%; min-height: 88rpx; padding: 22rpx 20rpx; font-size: 26rpx; }
.detail-page .panel-close:active { background: #edf0e5; }
.detail-page .primary-button:active { background: #eac14f; }
.originals-link { margin: 8rpx 0 20rpx; padding: 8rpx 0; text-align: left; }
