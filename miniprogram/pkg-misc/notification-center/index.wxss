page {
  background: #f6f5f0;
}

.message-page {
  width: 100%;
  min-width: 0;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  color: #493d28;
}

.message-navigation {
  position: sticky;
  top: 0;
  z-index: 10;
  width: 100%;
  background: #fffdf7;
}

.message-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 28rpx 0;
}

.message-summary {
  min-width: 0;
  color: #8a7651;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 提高选择器优先级，覆盖原生按钮默认宽度与字重。 */
.message-toolbar button.feedback-button {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: auto;
  min-height: 88rpx;
  margin: 0 -12rpx 0 0;
  padding: 0 12rpx;
  background: transparent;
  color: #926700;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
}

.message-tabs {
  display: flex;
  align-items: stretch;
  padding: 0 16rpx;
  border-bottom: 1rpx solid #eee9de;
}

.message-tabs button.message-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 0;
  height: auto;
  min-width: 0;
  min-height: 110rpx;
  margin: 0;
  padding: 24rpx 12rpx 28rpx;
  border-radius: 0;
  background: transparent;
  color: #9a9282;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.5;
}

.message-tabs button.message-tab.selected {
  color: #493d28;
  font-weight: 700;
}

.message-tab.selected::before {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: calc(50% - 16rpx);
  width: 32rpx;
  height: 7rpx;
  border-radius: 8rpx;
  background: #ffbd25;
}

.tab-label {
  position: relative;
}

/* 四个分类时让角标参与排版，避免较长标签与数量相互覆盖。 */
.message-tabs.admin-tabs button.message-tab {
  padding-right: 6rpx;
  padding-left: 6rpx;
  font-size: 26rpx;
}

.admin-tabs .tab-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.count-badge {
  position: absolute;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #dc5c4d;
  color: #fffdf7;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 32rpx;
  text-align: center;
  white-space: nowrap;
}

.tab-badge {
  top: -18rpx;
  left: calc(100% - 4rpx);
}

.admin-tabs .tab-badge {
  position: static;
  flex-shrink: 0;
  min-width: 28rpx;
  height: 28rpx;
  margin-top: -16rpx;
  padding: 0 6rpx;
  font-size: 18rpx;
  line-height: 28rpx;
}

.message-content {
  width: 100%;
  padding: 24rpx 0;
  box-sizing: border-box;
}

.message-list {
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  background: #fffdf7;
}

.message-list button.message-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  max-width: none;
  height: auto;
  min-height: 166rpx;
  margin: 0;
  padding: 32rpx 28rpx;
  border-radius: 0;
  background: transparent;
  color: #493d28;
  text-align: left;
  font-weight: 400;
  line-height: 1.5;
}

.message-row::before {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  border-bottom: 1rpx solid #f0ece3;
}

.message-tab::after,
.message-row::after,
.feedback-button::after,
.retry-button::after {
  border: 0;
}

.message-avatar {
  position: relative;
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.notice-avatar {
  background: #fff0b6;
}

.feedback-avatar {
  background: #f3ebd5;
}

.notice-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.reply-icon {
  width: 46rpx;
  height: 46rpx;
}

.avatar-badge {
  top: -8rpx;
  right: -10rpx;
  box-shadow: 0 0 0 3rpx #fffdf7;
}

.message-main {
  flex: 1;
  min-width: 0;
}

.message-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.message-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #493d28;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-meta {
  flex-shrink: 0;
  color: #a39a87;
  font-size: 22rpx;
  font-weight: 400;
}

.message-preview {
  display: block;
  overflow: hidden;
  margin-top: 14rpx;
  color: #938a78;
  font-size: 26rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-arrow {
  flex-shrink: 0;
  color: #b2a78f;
  font-size: 36rpx;
}

.message-state {
  padding: 56rpx 28rpx;
  color: #8a7651;
  font-size: 27rpx;
  line-height: 1.7;
  text-align: center;
}

.empty-title,
.empty-hint {
  display: block;
}

.empty-hint {
  margin-top: 10rpx;
  color: #a39a87;
  font-size: 24rpx;
}

.message-error {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  background: #fbede5;
  color: #a54c36;
  font-size: 24rpx;
  line-height: 1.6;
}

.message-content > .message-error {
  margin-bottom: 24rpx;
}

.message-page button.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  background: transparent;
  color: #815c13;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.4;
}

.admin-list-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}

.admin-filters {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.admin-filters button.admin-filter,
.admin-list-toolbar button.admin-manage-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  height: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  background: transparent;
  color: #8a7651;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 1.4;
}

.admin-filters button.admin-filter.selected {
  background: #ffedb3;
  color: #63450b;
  font-weight: 600;
}

.admin-feedback-panel {
  width: 100%;
}

.admin-feedback-list {
  overflow: hidden;
  border-radius: 28rpx;
  background: #fffdf7;
}

.admin-feedback-list button.admin-feedback-item {
  display: block;
  width: 100%;
  max-width: none;
  height: auto;
  margin: 0;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0ece3;
  border-radius: 0;
  background: transparent;
  color: #493d28;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.6;
  text-align: left;
}

.admin-filter::after,
.admin-manage-button::after,
.admin-feedback-item::after {
  border: 0;
}

.admin-feedback-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.admin-feedback-sender {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-status {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fff0c3;
  color: #8a610b;
  font-size: 22rpx;
}

.admin-status.processed {
  background: #e9f2e7;
  color: #4b7350;
}

.admin-feedback-meta {
  display: block;
  margin-top: 10rpx;
  color: #938a78;
  font-size: 23rpx;
}

.admin-feedback-content,
.admin-reply-preview {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-top: 16rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.admin-reply-preview {
  color: #8a7651;
  font-size: 25rpx;
}

.admin-feedback-action {
  display: block;
  margin-top: 18rpx;
  color: #926700;
  font-size: 24rpx;
  text-align: right;
}

.admin-list-footer {
  padding: 28rpx;
  color: #938a78;
  font-size: 24rpx;
  text-align: center;
}

.message-page button.message-pressed {
  background: #fcf4df;
}
