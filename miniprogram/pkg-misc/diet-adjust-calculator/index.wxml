<view class="page">
  <view class="hero">
    <text class="eyebrow">饮食换算</text>
    <text class="hero-title">调比例，算出该吃多少</text>
    <text class="hero-copy">先保住蛋白或热量，再把奶匀一点给辅食。勾选要吃的，点算一算就行。</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-icon">🍋</text>
    <text>正在加载营养档案与食物库…</text>
  </view>

  <block wx:else>
    <view class="section-card">
      <text class="section-title">1. 今天要保住什么</text>
      <text wx:if="{{weight}}" class="section-note">体重 {{weight}} kg · 已按系数预填，可改</text>

      <view class="segmented">
        <view class="segment {{mode === 'protein' ? 'active' : ''}}" data-mode="protein" bindtap="chooseMode">保蛋白</view>
        <view class="segment {{mode === 'calorie' ? 'active' : ''}}" data-mode="calorie" bindtap="chooseMode">保热量</view>
      </view>

      <text class="field-label">{{mode === 'protein' ? '全天蛋白目标' : '全天热量目标'}}</text>
      <view class="input-shell">
        <input class="compact-input" type="digit" value="{{target}}" data-field="target" bindinput="updateField" placeholder="请输入目标" />
        <text class="unit">{{mode === 'protein' ? 'g' : 'kcal'}}</text>
      </view>

      <view wx:if="{{mode === 'protein'}}" class="sub-block">
        <text class="field-label">热量参考（给能量粉补热用）</text>
        <view class="input-shell">
          <input class="compact-input" type="digit" value="{{calorieTarget}}" data-field="calorieTarget" bindinput="updateField" placeholder="可选" />
          <text class="unit">kcal</text>
        </view>
      </view>

      <view class="link-row" bindtap="toggleMoreTargets">
        <text>{{showMoreTargets ? '收起更多目标' : '更多目标（脂肪 / 碳水 / 优质蛋白）'}}</text>
        <text class="link-arrow">{{showMoreTargets ? '▴' : '▾'}}</text>
      </view>

      <view wx:if="{{showMoreTargets}}" class="soft-grid">
        <view>
          <text class="field-label">脂肪</text>
          <view class="input-shell">
            <input class="compact-input" type="digit" value="{{softFat}}" data-field="softFat" bindinput="updateField" placeholder="可选" />
            <text class="unit">g</text>
          </view>
        </view>
        <view>
          <text class="field-label">碳水</text>
          <view class="input-shell">
            <input class="compact-input" type="digit" value="{{softCarbs}}" data-field="softCarbs" bindinput="updateField" placeholder="可选" />
            <text class="unit">g</text>
          </view>
        </view>
        <view class="soft-full">
          <text class="field-label">优质蛋白</text>
          <view class="input-shell">
            <input class="compact-input" type="digit" value="{{softPremiumProtein}}" data-field="softPremiumProtein" bindinput="updateField" placeholder="可选" />
            <text class="unit">g</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">2. 奶和辅食怎么分</text>
      <view class="slider-labels">
        <text>奶多</text>
        <text class="slider-mid">奶约 {{milkRatioPercent}}% · 辅食约 {{100 - milkRatioPercent}}%</text>
        <text>辅食多</text>
      </view>
      <slider
        class="ratio-slider"
        min="0"
        max="100"
        step="5"
        value="{{milkRatioPercent}}"
        activeColor="#efb600"
        backgroundColor="#f0e4c6"
        block-size="28"
        bindchanging="onMilkRatioChanging"
        bindchange="onMilkRatioChanging"
      />
    </view>

    <view class="section-card">
      <text class="section-title">3. 勾选今天要吃的</text>

      <text class="group-title">普奶</text>
      <view class="option-grid">
        <view
          wx:for="{{normalMilks}}"
          wx:key="key"
          class="option-chip {{item.selected ? 'selected' : ''}}"
          data-group="normalMilks"
          data-key="{{item.key}}"
          bindtap="toggleOption"
        >
          <text class="option-check">{{item.selected ? '✓' : '+'}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>

      <text class="group-title">特奶</text>
      <view wx:if="{{specialMilks.length}}" class="option-grid">
        <view
          wx:for="{{specialMilks}}"
          wx:key="key"
          class="option-chip {{item.selected ? 'selected' : ''}}"
          data-group="specialMilks"
          data-key="{{item.key}}"
          bindtap="toggleOption"
        >
          <text class="option-check">{{item.selected ? '✓' : '+'}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <text wx:else class="empty-copy">暂无特奶</text>

      <text class="group-title">能量粉 <text class="inline-hint">只补热量</text></text>
      <view wx:if="{{energyPowders.length}}" class="option-grid">
        <view
          wx:for="{{energyPowders}}"
          wx:key="key"
          class="option-chip {{item.selected ? 'selected' : ''}}"
          data-group="energyPowders"
          data-key="{{item.key}}"
          bindtap="toggleOption"
        >
          <text class="option-check">{{item.selected ? '✓' : '+'}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <text wx:else class="empty-copy">暂无能量粉</text>

      <view class="group-title-row">
        <text class="group-title">辅食</text>
        <text class="limit-tag">最多 5 种</text>
      </view>
      <scroll-view wx:if="{{foods.length}}" class="food-scroll" scroll-y>
        <view class="option-grid">
          <view
            wx:for="{{foods}}"
            wx:key="key"
            class="option-chip {{item.selected ? 'selected' : ''}}"
            data-group="foods"
            data-key="{{item.key}}"
            bindtap="toggleOption"
          >
            <text class="option-check">{{item.selected ? '✓' : '+'}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
      <text wx:else class="empty-copy">食物库暂无可用品项</text>
    </view>

    <button class="primary-button" bindtap="calculate">算一算</button>

    <block wx:if="{{hasResult}}">
      <view class="section-card">
        <text class="section-title">推荐量（可微调）</text>
        <view wx:for="{{resultItems}}" wx:key="key" class="result-row">
          <view class="result-meta">
            <text class="result-name">{{item.name}}</text>
            <text wx:if="{{item.energyNote}}" class="result-hint">{{item.energyNote}}</text>
            <text wx:elif="{{item.kind === 'formula_powder'}}" class="result-hint">约兑水 {{item.waterVolume}} ml</text>
          </view>
          <view class="result-input">
            <input type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="updateQuantity" />
            <text>{{item.displayUnit}}</text>
          </view>
        </view>
      </view>

      <view class="summary-card">
        <text class="summary-title">目标对照</text>
        <view class="summary-grid">
          <view class="metric">
            <text class="metric-value">{{achieved.protein}}</text>
            <text class="metric-label">蛋白 g</text>
            <text wx:if="{{comparisonTargets.protein}}" class="metric-sub">目标 {{comparisonTargets.protein}}</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.calories}}</text>
            <text class="metric-label">热量 kcal</text>
            <text wx:if="{{comparisonTargets.calories}}" class="metric-sub">目标 {{comparisonTargets.calories}}</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.fat}}</text>
            <text class="metric-label">脂肪 g</text>
            <text wx:if="{{comparisonTargets.fat}}" class="metric-sub">目标 {{comparisonTargets.fat}}</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.carbs}}</text>
            <text class="metric-label">碳水 g</text>
            <text wx:if="{{comparisonTargets.carbs}}" class="metric-sub">目标 {{comparisonTargets.carbs}}</text>
          </view>
        </view>
        <view class="premium-line">
          <text>优质蛋白</text>
          <text>{{achieved.premiumProtein}} g<text wx:if="{{comparisonTargets.premiumProtein}}"> / 目标 {{comparisonTargets.premiumProtein}}</text></text>
        </view>
        <view wx:if="{{hints.length}}" class="hint-list">
          <text wx:for="{{hints}}" wx:key="*this" class="hint-item">· {{item}}</text>
        </view>
      </view>

      <view class="section-card">
        <text class="section-title">应用到哪一天</text>
        <picker mode="date" value="{{applyDate}}" bindchange="chooseApplyDate">
          <view class="compact-picker">
            <text>{{applyDate}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view class="warning-card">
          <text class="warning-title">记之前请看一下</text>
          <text>会清掉这一天已有的喂奶和辅食，再按推荐量重新记上。其它记录不动。</text>
        </view>
        <button class="primary-button" loading="{{applying}}" disabled="{{applying}}" bindtap="confirmApply">记到这一天</button>
      </view>
    </block>
  </block>
</view>
