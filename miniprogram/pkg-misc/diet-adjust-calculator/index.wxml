<view class="page">
  <view class="hero">
    <text class="eyebrow">试验工具</text>
    <text class="hero-title">饮食调整换算</text>
    <text class="hero-copy">按目标反算普奶、特奶与辅食用量，确认后可覆盖应用到某一天。</text>
  </view>

  <view class="steps">
    <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="step-dot {{step >= item ? 'active' : ''}}">
      <text>{{item}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-icon">🍋</text>
    <text>正在加载营养档案与食物库…</text>
  </view>

  <block wx:elif="{{step === 1}}">
    <view class="section-card">
      <view class="section-heading">
        <view>
          <text class="section-kicker">STEP 1</text>
          <text class="section-title">预选组成</text>
        </view>
        <text class="section-note">至少选 1 项</text>
      </view>

      <text class="group-title">普奶</text>
      <view class="option-grid">
        <view
          wx:for="{{normalMilks}}"
          wx:key="key"
          class="option-chip {{item.selected ? 'selected' : ''}}"
          data-group="normalMilks"
          data-key="{{item.key}}"
          bindtap="toggleOption"
        >
          <text class="option-check">{{item.selected ? '✓' : '+'}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>

      <text class="group-title">特奶</text>
      <view wx:if="{{specialMilks.length}}" class="option-grid">
        <view
          wx:for="{{specialMilks}}"
          wx:key="key"
          class="option-chip {{item.selected ? 'selected' : ''}}"
          data-group="specialMilks"
          data-key="{{item.key}}"
          bindtap="toggleOption"
        >
          <text class="option-check">{{item.selected ? '✓' : '+'}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <text wx:else class="empty-copy">营养档案中暂无特奶</text>

      <view class="group-title-row">
        <text class="group-title">辅食</text>
        <text class="limit-tag">最多 3 种</text>
      </view>
      <scroll-view wx:if="{{foods.length}}" class="food-scroll" scroll-y>
        <view class="option-grid">
          <view
            wx:for="{{foods}}"
            wx:key="key"
            class="option-chip {{item.selected ? 'selected' : ''}}"
            data-group="foods"
            data-key="{{item.key}}"
            bindtap="toggleOption"
          >
            <text class="option-check">{{item.selected ? '✓' : '+'}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
      <text wx:else class="empty-copy">食物库暂无可用品项</text>
    </view>

    <button class="primary-button" bindtap="goToTargets">下一步：设定目标</button>
  </block>

  <block wx:elif="{{step === 2}}">
    <view class="section-card">
      <view class="section-heading">
        <view>
          <text class="section-kicker">STEP 2</text>
          <text class="section-title">目标与结构</text>
        </view>
        <text wx:if="{{weight}}" class="section-note">体重 {{weight}} kg</text>
      </view>

      <text class="field-label">目标模式</text>
      <view class="segmented">
        <view class="segment {{mode === 'protein' ? 'active' : ''}}" data-mode="protein" bindtap="chooseMode">总蛋白</view>
        <view class="segment {{mode === 'calorie' ? 'active' : ''}}" data-mode="calorie" bindtap="chooseMode">总热量</view>
      </view>

      <text class="field-label">全天目标</text>
      <view class="input-shell">
        <input class="compact-input" type="digit" value="{{target}}" data-field="target" bindinput="updateField" placeholder="请输入目标" />
        <text class="unit">{{mode === 'protein' ? 'g' : 'kcal'}}</text>
      </view>

      <view class="ratio-grid">
        <view>
          <text class="field-label">奶侧占比</text>
          <view class="input-shell">
            <input class="compact-input" type="digit" value="{{milkRatioPercent}}" data-field="milkRatioPercent" bindinput="updateField" />
            <text class="unit">%</text>
          </view>
        </view>
        <view>
          <text class="field-label">辅食侧占比</text>
          <view class="input-shell">
            <input class="compact-input" type="digit" value="{{foodRatioPercent}}" data-field="foodRatioPercent" bindinput="updateField" />
            <text class="unit">%</text>
          </view>
        </view>
      </view>

      <view wx:if="{{hasBothMilkGroups}}" class="sub-card">
        <text class="sub-card-title">奶侧内部比例</text>
        <view class="ratio-grid">
          <view>
            <text class="field-label">普奶</text>
            <view class="input-shell">
              <input class="compact-input" type="digit" value="{{normalMilkOfMilkPercent}}" data-field="normalMilkOfMilkPercent" bindinput="updateField" />
              <text class="unit">%</text>
            </view>
          </view>
          <view>
            <text class="field-label">特奶</text>
            <view class="input-shell">
              <input class="compact-input" type="digit" value="{{specialMilkOfMilkPercent}}" data-field="specialMilkOfMilkPercent" bindinput="updateField" />
              <text class="unit">%</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{selectedNormalMilks.length}}" class="share-group">
        <text class="group-title">普奶组内份额</text>
        <view wx:for="{{selectedNormalMilks}}" wx:key="key" class="share-row">
          <text class="share-name">{{item.name}}</text>
          <view class="share-input">
            <input type="digit" value="{{item.sharePercent}}" data-group="selectedNormalMilks" data-index="{{index}}" bindinput="updateShare" />
            <text>%</text>
          </view>
        </view>
      </view>

      <view wx:if="{{selectedSpecialMilks.length}}" class="share-group">
        <text class="group-title">特奶组内份额</text>
        <view wx:for="{{selectedSpecialMilks}}" wx:key="key" class="share-row">
          <text class="share-name">{{item.name}}</text>
          <view class="share-input">
            <input type="digit" value="{{item.sharePercent}}" data-group="selectedSpecialMilks" data-index="{{index}}" bindinput="updateShare" />
            <text>%</text>
          </view>
        </view>
      </view>

      <view wx:if="{{selectedFoods.length}}" class="share-group">
        <text class="group-title">辅食组内份额</text>
        <view wx:for="{{selectedFoods}}" wx:key="key" class="share-row">
          <text class="share-name">{{item.name}}</text>
          <view class="share-input">
            <input type="digit" value="{{item.sharePercent}}" data-group="selectedFoods" data-index="{{index}}" bindinput="updateShare" />
            <text>%</text>
          </view>
        </view>
      </view>
    </view>

    <view class="button-row">
      <button class="secondary-button" bindtap="backStep">上一步</button>
      <button class="primary-button" bindtap="calculate">智能换算</button>
    </view>
  </block>

  <block wx:elif="{{step === 3}}">
    <view class="section-card">
      <view class="section-heading">
        <view>
          <text class="section-kicker">STEP 3</text>
          <text class="section-title">推荐量</text>
        </view>
        <text class="section-note">可微调</text>
      </view>

      <view wx:for="{{resultItems}}" wx:key="key" class="result-row">
        <view class="result-meta">
          <text class="result-name">{{item.name}}</text>
          <text wx:if="{{item.kind === 'formula_powder'}}" class="result-hint">约兑水 {{item.waterVolume}} ml</text>
        </view>
        <view class="result-input">
          <input type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="updateQuantity" />
          <text>{{item.displayUnit}}</text>
        </view>
      </view>
    </view>

    <view class="summary-card">
      <text class="summary-title">当前达成估算</text>
      <view class="summary-grid">
        <view class="metric"><text class="metric-value">{{achieved.protein}}</text><text class="metric-label">蛋白 g</text></view>
        <view class="metric"><text class="metric-value">{{achieved.calories}}</text><text class="metric-label">热量 kcal</text></view>
        <view class="metric"><text class="metric-value">{{achieved.fat}}</text><text class="metric-label">脂肪 g</text></view>
        <view class="metric"><text class="metric-value">{{achieved.carbs}}</text><text class="metric-label">碳水 g</text></view>
      </view>
      <view class="premium-line"><text>优质蛋白估算</text><text>{{achieved.premiumProtein}} g</text></view>
    </view>

    <view class="button-row">
      <button class="secondary-button" bindtap="backStep">上一步</button>
      <button class="primary-button" bindtap="goToApply">继续应用</button>
    </view>
  </block>

  <block wx:elif="{{step === 4}}">
    <view class="section-card">
      <view class="section-heading">
        <view>
          <text class="section-kicker">STEP 4</text>
          <text class="section-title">应用到日期</text>
        </view>
      </view>

      <text class="field-label">选择日期</text>
      <picker mode="date" value="{{applyDate}}" bindchange="chooseApplyDate">
        <view class="compact-picker">
          <text>{{applyDate}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>

      <view class="warning-card">
        <text class="warning-title">覆盖提醒</text>
        <text>确认后会删除该日现有喂奶与辅食记录，再按当前推荐量写入；其他类型记录不受影响。</text>
      </view>
    </view>

    <view class="button-row">
      <button class="secondary-button" bindtap="backStep">上一步</button>
      <button class="primary-button" loading="{{applying}}" disabled="{{applying}}" bindtap="confirmApply">确认应用</button>
    </view>
  </block>
</view>
