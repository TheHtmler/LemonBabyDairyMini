<view class="page">
  <view class="hero">
    <text class="eyebrow">饮食换算</text>
    <text class="hero-title">调比例，算出该吃多少</text>
    <text class="hero-copy">保住蛋白或热量，把奶匀一点给辅食。搜索添加要吃的，点算一算就行。</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-icon">🍋</text>
    <text>正在加载营养档案与食物库…</text>
  </view>

  <block wx:else>
    <view class="section-card">
      <text class="section-title">1. 今天要保住什么</text>
      <text wx:if="{{weight}}" class="section-note">体重 {{weight}} kg · 已按系数预填，可改</text>

      <view class="segmented">
        <view class="segment {{mode === 'protein' ? 'active' : ''}}" data-mode="protein" bindtap="chooseMode">保蛋白</view>
        <view class="segment {{mode === 'calorie' ? 'active' : ''}}" data-mode="calorie" bindtap="chooseMode">保热量</view>
      </view>

      <text class="field-label">{{mode === 'protein' ? '全天蛋白目标' : '全天热量目标'}}</text>
      <view class="input-shell">
        <input class="compact-input" type="digit" value="{{target}}" data-field="target" bindinput="updateField" placeholder="请输入目标" />
        <text class="unit">{{mode === 'protein' ? 'g' : 'kcal'}}</text>
      </view>

      <view wx:if="{{mode === 'protein'}}" class="sub-block">
        <text class="field-label">热量参考（给能量粉补热用）</text>
        <view class="input-shell">
          <input class="compact-input" type="digit" value="{{calorieTarget}}" data-field="calorieTarget" bindinput="updateField" placeholder="可选" />
          <text class="unit">kcal</text>
        </view>
      </view>

      <view class="link-row" bindtap="toggleMoreTargets">
        <text>{{showMoreTargets ? '收起比例范围' : '更多目标（供能比 / 优质蛋白范围）'}}</text>
        <text class="link-arrow">{{showMoreTargets ? '▴' : '▾'}}</text>
      </view>

      <view wx:if="{{showMoreTargets}}" class="range-panel">
        <text class="range-tip">已按{{ageRangeLabel}}建议预填，可改；清空表示不考核</text>

        <text class="field-label">蛋白供能 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{proteinEnergyMin}}" data-field="proteinEnergyMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{proteinEnergyMax}}" data-field="proteinEnergyMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>

        <text class="field-label">脂肪供能 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{fatEnergyMin}}" data-field="fatEnergyMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{fatEnergyMax}}" data-field="fatEnergyMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>

        <text class="field-label">碳水供能 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{carbsEnergyMin}}" data-field="carbsEnergyMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{carbsEnergyMax}}" data-field="carbsEnergyMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>

        <text class="field-label">优质蛋白占总蛋白 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{premiumRatioMin}}" data-field="premiumRatioMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{premiumRatioMax}}" data-field="premiumRatioMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">2. 奶和辅食怎么分</text>
      <view class="slider-labels">
        <text>奶多</text>
        <text class="slider-mid">奶约 {{milkRatioPercent}}% · 辅食约 {{100 - milkRatioPercent}}%</text>
        <text>辅食多</text>
      </view>
      <slider
        class="ratio-slider"
        min="0"
        max="100"
        step="5"
        value="{{milkRatioPercent}}"
        activeColor="#efb600"
        backgroundColor="#f0e4c6"
        block-size="28"
        bindchanging="onMilkRatioChanging"
        bindchange="onMilkRatioChanging"
      />
    </view>

    <view class="section-card">
      <text class="section-title">3. 添加要吃的</text>

      <view class="select-block">
        <view class="select-head">
          <text class="group-title">普奶</text>
          <view class="add-btn" data-group="normalMilks" bindtap="openPicker">+ 添加</view>
        </view>
        <view wx:if="{{selectedNormalMilks.length}}" class="tag-list">
          <view wx:for="{{selectedNormalMilks}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="normalMilks" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
        </view>
        <text wx:else class="empty-copy">还没添加普奶</text>
      </view>

      <view class="select-block">
        <view class="select-head">
          <text class="group-title">特奶</text>
          <view class="add-btn" data-group="specialMilks" bindtap="openPicker">+ 添加</view>
        </view>
        <view wx:if="{{selectedSpecialMilks.length}}" class="tag-list">
          <view wx:for="{{selectedSpecialMilks}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="specialMilks" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
        </view>
        <text wx:else class="empty-copy">还没添加特奶</text>
      </view>

      <view class="select-block">
        <view class="select-head">
          <text class="group-title">能量粉 <text class="inline-hint">只补热量</text></text>
          <view class="add-btn" data-group="energyPowders" bindtap="openPicker">+ 添加</view>
        </view>
        <view wx:if="{{selectedEnergyPowders.length}}" class="tag-list">
          <view wx:for="{{selectedEnergyPowders}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="energyPowders" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
        </view>
        <text wx:else class="empty-copy">还没添加能量粉</text>
      </view>

      <view class="select-block">
        <view class="select-head">
          <text class="group-title">辅食</text>
          <view class="add-btn" data-group="foods" bindtap="openPicker">+ 添加</view>
        </view>
        <view wx:if="{{selectedFoods.length}}" class="tag-list">
          <view wx:for="{{selectedFoods}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="foods" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
        </view>
        <text wx:else class="empty-copy">还没添加辅食（最多 5 种）</text>
      </view>
    </view>

    <button class="primary-button" bindtap="calculate">算一算</button>

    <block wx:if="{{hasResult}}">
      <view class="section-card">
        <text class="section-title">推荐量（具体克重/毫升，可微调）</text>
        <view wx:for="{{resultItems}}" wx:key="key" class="result-row">
          <view class="result-meta">
            <text class="result-name">{{item.name}}</text>
            <text wx:if="{{item.energyNote}}" class="result-hint">{{item.energyNote}}</text>
            <text wx:elif="{{item.kind === 'formula_powder'}}" class="result-hint">约兑水 {{item.waterVolume}} ml</text>
          </view>
          <view class="result-input">
            <input type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="updateQuantity" />
            <text>{{item.displayUnit}}</text>
          </view>
        </view>
      </view>

      <view class="summary-card">
        <text class="summary-title">营养汇总</text>
        <view class="summary-grid">
          <view class="metric">
            <text class="metric-value">{{achieved.protein}}</text>
            <text class="metric-label">蛋白 g</text>
            <text wx:if="{{comparisonTargets.protein}}" class="metric-sub">目标 {{comparisonTargets.protein}}</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.calories}}</text>
            <text class="metric-label">热量 kcal</text>
            <text wx:if="{{comparisonTargets.calories}}" class="metric-sub">目标 {{comparisonTargets.calories}}</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.fat}}</text>
            <text class="metric-label">脂肪 g</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.carbs}}</text>
            <text class="metric-label">碳水 g</text>
          </view>
        </view>
        <view class="premium-line">
          <text>优质蛋白</text>
          <text>{{achieved.premiumProtein}} g</text>
        </view>

        <text class="summary-subtitle">比例对照</text>
        <view wx:for="{{macroRows}}" wx:key="key" class="ratio-row">
          <view class="ratio-main">
            <text class="ratio-label">{{item.label}}</text>
            <text class="ratio-value">{{item.value}}%</text>
          </view>
          <view class="ratio-side">
            <text class="ratio-range">建议 {{item.rangeText}}</text>
            <text class="ratio-status status-{{item.status}}">{{item.statusText}}</text>
          </view>
        </view>

        <view wx:if="{{hints.length}}" class="hint-list">
          <text wx:for="{{hints}}" wx:key="*this" class="hint-item">· {{item}}</text>
        </view>
      </view>

      <view class="section-card">
        <text class="section-title">应用到哪一天</text>
        <picker mode="date" value="{{applyDate}}" bindchange="chooseApplyDate">
          <view class="compact-picker">
            <text>{{applyDate}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view class="warning-card">
          <text class="warning-title">记之前请看一下</text>
          <text>会清掉这一天已有的喂奶和辅食，再按推荐量重新记上。其它记录不动。</text>
        </view>
        <button class="primary-button" loading="{{applying}}" disabled="{{applying}}" bindtap="confirmApply">记到这一天</button>
      </view>
    </block>
  </block>

  <view wx:if="{{showPicker}}" class="picker-mask" bindtap="closePicker">
    <view class="picker-sheet" catchtap="noop">
      <view class="picker-header">
        <text class="picker-title">{{pickerTitle}}</text>
        <text class="picker-close" bindtap="closePicker">关闭</text>
      </view>
      <view class="picker-search">
        <input
          class="compact-input"
          value="{{pickerKeyword}}"
          bindinput="onPickerSearch"
          placeholder="输入名称搜索"
          confirm-type="search"
        />
      </view>
      <scroll-view class="picker-list" scroll-y>
        <view
          wx:for="{{pickerOptions}}"
          wx:key="key"
          class="picker-item {{item.alreadySelected ? 'disabled' : ''}}"
          data-key="{{item.key}}"
          bindtap="pickCatalogItem"
        >
          <text class="picker-item-name">{{item.name}}</text>
          <text class="picker-item-action">{{item.alreadySelected ? '已添加' : '添加'}}</text>
        </view>
        <view wx:if="{{!pickerOptions.length}}" class="picker-empty">{{pickerEmpty}}</view>
      </scroll-view>
    </view>
  </view>
</view>
