<view class="page">
  <view class="hero">
    <text class="eyebrow">饮食换算</text>
    <text class="hero-title">调比例，算出该吃多少</text>
    <text class="hero-copy">蛋白和热量都可勾选，指定一个为主；用滑条分奶和辅食，选好要吃的再点算一算。</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-icon">🍋</text>
    <text>正在加载营养档案与食物库…</text>
  </view>

  <block wx:else>
    <view class="section-card">
      <text class="section-title">1. 今天要保住什么</text>
      <text wx:if="{{weight}}" class="section-note">体重 {{weight}} kg · 已按系数预填，可改；至少启用一个，并指定「为主」</text>

      <view class="select-block">
        <view class="select-head">
          <view
            class="tag-chip {{useProteinTarget ? '' : 'disabled'}}"
            data-mode="protein"
            bindtap="toggleTargetEnable"
          >
            <text>{{useProteinTarget ? '✓ ' : ''}}蛋白目标</text>
          </view>
          <view wx:if="{{useProteinTarget && primaryMode === 'protein'}}" class="limit-tag">为主</view>
          <view
            wx:elif="{{useProteinTarget}}"
            class="add-btn"
            data-mode="protein"
            bindtap="setPrimaryMode"
          >设为主</view>
        </view>
        <view
          wx:if="{{useProteinTarget}}"
          class="sub-block"
          data-mode="protein"
          bindtap="onTargetCardTap"
        >
          <text class="field-label">全天蛋白目标</text>
          <view class="input-shell" catchtap="noop">
            <input
              class="compact-input"
              type="digit"
              value="{{proteinTarget}}"
              data-field="proteinTarget"
              bindinput="updateField"
              placeholder="请输入蛋白目标"
            />
            <text class="unit">g</text>
          </view>
        </view>
      </view>

      <view class="select-block">
        <view class="select-head">
          <view
            class="tag-chip {{useCalorieTarget ? '' : 'disabled'}}"
            data-mode="calorie"
            bindtap="toggleTargetEnable"
          >
            <text>{{useCalorieTarget ? '✓ ' : ''}}热量目标</text>
          </view>
          <view wx:if="{{useCalorieTarget && primaryMode === 'calorie'}}" class="limit-tag">为主</view>
          <view
            wx:elif="{{useCalorieTarget}}"
            class="add-btn"
            data-mode="calorie"
            bindtap="setPrimaryMode"
          >设为主</view>
        </view>
        <view
          wx:if="{{useCalorieTarget}}"
          class="sub-block"
          data-mode="calorie"
          bindtap="onTargetCardTap"
        >
          <text class="field-label">全天热量目标</text>
          <view class="input-shell" catchtap="noop">
            <input
              class="compact-input"
              type="digit"
              value="{{calorieTarget}}"
              data-field="calorieTarget"
              bindinput="updateField"
              placeholder="请输入热量目标"
            />
            <text class="unit">kcal</text>
          </view>
        </view>
      </view>

      <view class="link-row" bindtap="toggleMoreTargets">
        <text>{{showMoreTargets ? '收起比例范围' : '更多目标（供能比 / 优质蛋白范围）'}}</text>
        <text class="link-arrow">{{showMoreTargets ? '▴' : '▾'}}</text>
      </view>

      <view wx:if="{{showMoreTargets}}" class="range-panel">
        <text class="range-tip">已按{{ageRangeLabel}}建议预填，可改；清空表示不考核</text>

        <text class="field-label">蛋白供能 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{proteinEnergyMin}}" data-field="proteinEnergyMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{proteinEnergyMax}}" data-field="proteinEnergyMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>

        <text class="field-label">脂肪供能 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{fatEnergyMin}}" data-field="fatEnergyMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{fatEnergyMax}}" data-field="fatEnergyMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>

        <text class="field-label">碳水供能 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{carbsEnergyMin}}" data-field="carbsEnergyMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{carbsEnergyMax}}" data-field="carbsEnergyMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>

        <text class="field-label">优质蛋白占总蛋白 %</text>
        <view class="range-row">
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{premiumRatioMin}}" data-field="premiumRatioMin" bindinput="updateField" placeholder="下限" />
          </view>
          <text class="range-sep">～</text>
          <view class="input-shell range-input">
            <input class="compact-input" type="digit" value="{{premiumRatioMax}}" data-field="premiumRatioMax" bindinput="updateField" placeholder="上限" />
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">2. 奶和辅食怎么分</text>
      <view class="slider-labels">
        <text>奶多</text>
        <text class="slider-mid">奶约 {{milkRatioPercent}}% · 辅食约 {{100 - milkRatioPercent}}%</text>
        <text>辅食多</text>
      </view>
      <slider
        class="ratio-slider"
        min="0"
        max="100"
        step="5"
        value="{{milkRatioPercent}}"
        activeColor="#efb600"
        backgroundColor="#f0e4c6"
        block-size="28"
        bindchanging="onMilkRatioChanging"
        bindchange="onMilkRatioChanging"
      />
    </view>

    <view class="section-card">
      <text class="section-title">3. 添加要吃的</text>

      <view class="select-block">
        <view class="select-head">
          <text class="group-title">奶</text>
          <view class="add-btn" bindtap="openAddMilkPanel">添加奶</view>
        </view>
        <view
          wx:if="{{selectedNormalMilks.length || selectedSpecialMilks.length || selectedEnergyPowders.length}}"
          class="tag-list"
        >
          <view wx:for="{{selectedNormalMilks}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="normalMilks" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
          <view wx:for="{{selectedSpecialMilks}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="specialMilks" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
          <view wx:for="{{selectedEnergyPowders}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="energyPowders" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
        </view>
        <text wx:else class="empty-copy">还没添加奶（普奶 / 特奶 / 能量粉）</text>
      </view>

      <view class="select-block">
        <view class="select-head">
          <text class="group-title">辅食</text>
          <view class="add-btn" bindtap="openFoodPicker">添加食物</view>
        </view>
        <view wx:if="{{selectedFoods.length}}" class="tag-list">
          <view wx:for="{{selectedFoods}}" wx:key="key" class="tag-chip">
            <text>{{item.name}}</text>
            <text class="tag-remove" data-group="foods" data-key="{{item.key}}" bindtap="removeSelected">×</text>
          </view>
        </view>
        <text wx:else class="empty-copy">还没添加辅食</text>
      </view>
    </view>

    <button class="primary-button" bindtap="calculate">算一算</button>

    <block wx:if="{{hasResult}}">
      <view class="section-card">
        <text class="section-title">推荐量（具体克重/毫升，可微调）</text>
        <view wx:for="{{resultItems}}" wx:key="key" class="result-row">
          <view class="result-meta">
            <text class="result-name">{{item.name}}</text>
            <text wx:if="{{item.energyNote}}" class="result-hint">{{item.energyNote}}</text>
            <text wx:elif="{{item.kind === 'formula_powder'}}" class="result-hint">约兑水 {{item.waterVolume}} ml</text>
            <text wx:if="{{item.nutrition}}" class="result-hint">
              蛋白 {{item.nutrition.protein}}g · 热量 {{item.nutrition.calories}}kcal · 脂肪 {{item.nutrition.fat}}g · 碳水 {{item.nutrition.carbs}}g
              <text wx:if="{{item.nutrition.premiumProtein}}"> · 优质蛋白 {{item.nutrition.premiumProtein}}g</text>
            </text>
          </view>
          <view class="result-input">
            <input type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="updateQuantity" />
            <text>{{item.displayUnit}}</text>
          </view>
        </view>
      </view>

      <view class="summary-card">
        <text class="summary-title">营养汇总</text>
        <view class="summary-grid">
          <view class="metric">
            <text class="metric-value">{{achieved.protein}}</text>
            <text class="metric-label">蛋白 g</text>
            <text wx:if="{{comparisonTargets.protein}}" class="metric-sub">目标 {{comparisonTargets.protein}}</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.calories}}</text>
            <text class="metric-label">热量 kcal</text>
            <text wx:if="{{comparisonTargets.calories}}" class="metric-sub">目标 {{comparisonTargets.calories}}</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.fat}}</text>
            <text class="metric-label">脂肪 g</text>
          </view>
          <view class="metric">
            <text class="metric-value">{{achieved.carbs}}</text>
            <text class="metric-label">碳水 g</text>
          </view>
        </view>
        <view class="premium-line">
          <text>优质蛋白</text>
          <text>{{achieved.premiumProtein}} g</text>
        </view>

        <text class="summary-subtitle">比例对照</text>
        <view wx:for="{{macroRows}}" wx:key="key" class="ratio-row">
          <view class="ratio-main">
            <text class="ratio-label">{{item.label}}</text>
            <text class="ratio-value">{{item.value}}%</text>
          </view>
          <view class="ratio-side">
            <text class="ratio-range">建议 {{item.rangeText}}</text>
            <text class="ratio-status status-{{item.status}}">{{item.statusText}}</text>
          </view>
        </view>

        <view wx:if="{{hints.length}}" class="hint-list">
          <text wx:for="{{hints}}" wx:key="*this" class="hint-item">· {{item}}</text>
        </view>
      </view>

      <view class="section-card">
        <text class="section-title">应用到哪一天</text>
        <picker mode="date" value="{{applyDate}}" bindchange="chooseApplyDate">
          <view class="compact-picker">
            <text>{{applyDate}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view class="warning-card">
          <text class="warning-title">记之前请看一下</text>
          <text>会清掉这一天已有的喂奶和辅食，再按推荐量重新记上。其它记录不动。</text>
        </view>
        <button class="primary-button" loading="{{applying}}" disabled="{{applying}}" bindtap="confirmApply">记到这一天</button>
      </view>
    </block>
  </block>

  <view wx:if="{{showAddMilkPanel}}" class="add-milk-dialog-mask" catchtap="cancelAddMilkPanel">
    <view class="add-milk-dialog-panel" catchtap="noop">
      <view class="add-milk-dialog-header">
        <view class="panel-title-wrap">
          <text class="section-eyebrow">添加奶</text>
          <text class="section-title add-milk-dialog-title">选奶粉</text>
          <text class="add-milk-hint">可选多个不同奶粉</text>
        </view>
        <view class="add-milk-dialog-corner">
          <view class="add-milk-dialog-close" bindtap="cancelAddMilkPanel">×</view>
          <view class="add-milk-dialog-manage" bindtap="goToManagePowders">去配奶粉</view>
        </view>
      </view>
      <view class="add-milk-library-tabs">
        <view
          wx:for="{{addMilkLibraryTabs}}"
          wx:key="scope"
          class="add-milk-library-tab {{addMilkActiveScope === item.scope ? 'active' : ''}}"
          data-scope="{{item.scope}}"
          bindtap="switchAddMilkScope"
        >
          {{item.label}}
        </view>
      </view>
      <view class="add-milk-picker-layout">
        <scroll-view class="add-milk-category-sidebar" scroll-y enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{addMilkCategories}}"
            wx:key="value"
            class="add-milk-category-nav-item {{addMilkActiveCategory === item.value ? 'active' : ''}}"
            data-category="{{item.value}}"
            bindtap="switchAddMilkCategory"
          >
            <text class="add-milk-category-nav-label">{{item.label}}</text>
          </view>
          <view class="add-milk-category-empty" wx:if="{{addMilkCategories.length === 0}}">暂无分类</view>
        </scroll-view>
        <scroll-view class="add-milk-options-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="add-milk-options-empty" wx:if="{{addMilkOptions.length === 0}}">
            <text>{{addMilkActiveScope === 'system' ? '暂无系统奶粉' : '还没有奶粉，点右上角「去配奶粉」添加'}}</text>
          </view>
          <view class="add-milk-options">
            <view
              wx:for="{{addMilkOptions}}"
              wx:key="key"
              class="add-milk-option {{item.selected ? 'selected' : ''}}"
              data-key="{{item.key}}"
              data-index="{{index}}"
              bindtap="toggleAddMilkOption"
            >
              <view class="add-milk-option-source add-milk-option-source-{{index}}">
                <text class="category-badge {{item.categoryBadgeClass}}" style="{{item.categoryBadgeStyle}}">{{item.categoryShortLabel}}</text>
                <image
                  wx:if="{{item.displayImage}}"
                  class="add-milk-option-image"
                  src="{{item.displayImage}}"
                  mode="aspectFill"
                  lazy-load="{{true}}"
                  data-url="{{item.displayImage}}"
                  catchtap="previewAddMilkImage"
                />
                <view class="add-milk-option-copy">
                  <text class="add-milk-option-title">{{item.label}}</text>
                  <text class="add-milk-option-subtitle">{{item.subLabel}}</text>
                </view>
              </view>
              <view class="add-milk-option-add {{item.selected ? 'active' : ''}}">{{item.selected ? '✓' : '+'}}</view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view class="add-milk-cart-detail-mask" wx:if="{{addMilkCartExpanded && addMilkCart.length > 0}}" catchtap="collapseAddMilkCart"></view>
      <view class="add-milk-cart-detail {{addMilkCartExpanded && addMilkCart.length > 0 ? 'visible' : ''}}">
        <view class="add-milk-cart-detail-header">
          <text class="add-milk-cart-detail-title">已选的奶</text>
          <text class="add-milk-cart-detail-count">{{addMilkCart.length}} 种</text>
        </view>
        <scroll-view class="add-milk-cart-detail-list" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="add-milk-cart-detail-item" wx:for="{{addMilkCart}}" wx:key="key">
            <text class="category-badge {{item.categoryBadgeClass}}" style="{{item.categoryBadgeStyle}}">{{item.categoryShortLabel}}</text>
            <image
              wx:if="{{item.displayImage}}"
              class="add-milk-cart-detail-image"
              src="{{item.displayImage}}"
              mode="aspectFill"
              data-url="{{item.displayImage}}"
              catchtap="previewAddMilkImage"
            />
            <text class="add-milk-cart-detail-name">{{item.label}}</text>
            <view class="add-milk-cart-detail-remove" data-key="{{item.key}}" catchtap="removeAddMilkCartItem">移除</view>
          </view>
        </scroll-view>
      </view>
      <view class="add-milk-cart-bar">
        <view class="add-milk-cart-main" bindtap="toggleAddMilkCartExpanded">
          <view class="add-milk-cart-anchor">
            <text class="add-milk-cart-icon">🍼</text>
            <text class="add-milk-cart-badge" wx:if="{{addMilkCart.length > 0}}">{{addMilkCart.length}}</text>
          </view>
          <view class="add-milk-cart-copy">
            <text class="add-milk-cart-title" wx:if="{{addMilkCart.length > 0}}">已选 {{addMilkCart.length}} 种奶</text>
            <text class="add-milk-cart-title" wx:else>已选的奶</text>
            <text class="add-milk-cart-subtitle" wx:if="{{addMilkCart.length > 0}}">{{addMilkCartExpanded ? '收起明细' : '点击查看明细'}}</text>
            <text class="add-milk-cart-subtitle" wx:else>点奶右侧的 + 添加到这里</text>
          </view>
        </view>
        <view class="add-milk-cart-confirm" catchtap="confirmAddMilkPanel">确定</view>
      </view>
    </view>
  </view>
</view>
