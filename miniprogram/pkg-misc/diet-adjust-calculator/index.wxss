page {
  min-height: 100%;
  background: #fff9e9;
  color: #3f3725;
}

.page {
  padding: 28rpx 28rpx 52rpx;
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  border: 2rpx solid #f2c94c;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #fff0a8 0%, #ffe168 100%);
  box-shadow: 0 12rpx 28rpx rgba(185, 137, 0, 0.12);
}

.hero::after {
  content: "🍋";
  position: absolute;
  right: 18rpx;
  bottom: -18rpx;
  font-size: 112rpx;
  opacity: 0.22;
  transform: rotate(-12deg);
}

.eyebrow,
.hero-title,
.hero-copy,
.section-kicker,
.section-title,
.group-title,
.field-label,
.summary-title,
.metric-value,
.metric-label,
.warning-title {
  display: block;
}

.eyebrow {
  color: #876100;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.hero-copy {
  width: 82%;
  margin-top: 14rpx;
  color: #705a1e;
  font-size: 25rpx;
  line-height: 1.6;
}

.state-card,
.section-card,
.summary-card {
  border: 2rpx solid #f0e4c6;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(102, 78, 19, 0.07);
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 80rpx 30rpx;
  color: #8f815f;
}

.state-icon {
  font-size: 70rpx;
}

.section-card,
.summary-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.section-kicker {
  color: #d49a00;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.section-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.section-note {
  display: block;
  margin-top: 10rpx;
  color: #8a6500;
  font-size: 22rpx;
}

.limit-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3c8;
  color: #8a6500;
  font-size: 21rpx;
}

.sub-block {
  margin-top: 8rpx;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  color: #8a6500;
  font-size: 24rpx;
  font-weight: 600;
}

.link-arrow {
  font-size: 28rpx;
}

.soft-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 8rpx;
}

.soft-full {
  grid-column: 1 / -1;
}

.slider-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #796d53;
  font-size: 22rpx;
}

.slider-mid {
  flex: 1;
  color: #5c4500;
  font-weight: 700;
  text-align: center;
}

.ratio-slider {
  margin: 12rpx 0 0;
}

.inline-hint {
  margin-left: 8rpx;
  color: #9d8e6c;
  font-size: 22rpx;
  font-weight: 500;
}

.metric-sub {
  display: block;
  margin-top: 6rpx;
  color: #e8ddb6;
  font-size: 20rpx;
  opacity: 0.9;
}

.hint-list {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
}

.hint-item {
  display: block;
  margin-top: 8rpx;
  color: #ffe9a8;
  font-size: 22rpx;
  line-height: 1.5;
}

.range-panel {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fff8df;
}

.range-tip {
  display: block;
  margin-bottom: 8rpx;
  color: #8a6500;
  font-size: 22rpx;
  line-height: 1.5;
}

.range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.range-input {
  flex: 1;
}

.range-sep {
  color: #9b8c69;
  font-size: 26rpx;
}

.select-block {
  margin-top: 18rpx;
  padding-top: 8rpx;
  border-top: 2rpx dashed #ecdfbd;
}

.select-block:first-of-type {
  border-top: 0;
  margin-top: 8rpx;
}

.select-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-head .group-title {
  margin: 12rpx 0;
}

.add-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff0aa;
  color: #755500;
  font-size: 22rpx;
  font-weight: 700;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0aa;
  color: #5c4500;
  font-size: 24rpx;
  font-weight: 600;
}

.tag-remove {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  color: #8a6500;
  font-size: 28rpx;
  line-height: 34rpx;
  text-align: center;
}

.summary-subtitle {
  display: block;
  margin-top: 24rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.ratio-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.1);
}

.ratio-main,
.ratio-side {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ratio-side {
  align-items: flex-end;
}

.ratio-label {
  font-size: 23rpx;
  color: #e8ddb6;
}

.ratio-value {
  font-size: 30rpx;
  font-weight: 800;
}

.ratio-range {
  font-size: 20rpx;
  color: #e8ddb6;
}

.ratio-status {
  font-size: 22rpx;
  font-weight: 700;
}

.status-in {
  color: #b8f5c4;
}

.status-low,
.status-high {
  color: #ffd28a;
}

.status-skip {
  color: #e8ddb6;
}

.picker-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(40, 30, 8, 0.45);
}

.picker-sheet {
  width: 100%;
  max-height: 75vh;
  padding: 28rpx 28rpx 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #fffdf6;
  box-sizing: border-box;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #3f3725;
}

.picker-close {
  color: #8a6500;
  font-size: 26rpx;
  font-weight: 600;
}

.picker-search {
  margin-bottom: 16rpx;
  border: 2rpx solid #eadfbe;
  border-radius: 16rpx;
  background: #fffcf5;
  overflow: hidden;
}

.picker-search .compact-input {
  height: 76rpx;
}

.picker-list {
  max-height: 52vh;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 2rpx solid #f3ecda;
}

.picker-item.disabled {
  opacity: 0.55;
}

.picker-item-name {
  flex: 1;
  min-width: 0;
  color: #3f3725;
  font-size: 28rpx;
  font-weight: 600;
}

.picker-item-action {
  color: #8a6500;
  font-size: 24rpx;
  font-weight: 700;
}

.picker-empty {
  padding: 60rpx 20rpx;
  color: #a29575;
  font-size: 24rpx;
  text-align: center;
}

.group-title {
  margin: 28rpx 0 16rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.group-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.group-title-row .group-title {
  margin-bottom: 16rpx;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-chip {
  display: flex;
  align-items: center;
  max-width: 100%;
  padding: 16rpx 20rpx;
  border: 2rpx solid #ebe1c7;
  border-radius: 18rpx;
  background: #fffcf4;
  color: #71664d;
  font-size: 25rpx;
  box-sizing: border-box;
}

.option-chip.selected {
  border-color: #eab100;
  background: #fff0aa;
  color: #5c4500;
  font-weight: 700;
}

.option-check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
}

.food-scroll {
  max-height: 430rpx;
}

.empty-copy {
  display: block;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #faf7ef;
  color: #a29575;
  font-size: 24rpx;
  text-align: center;
}

.field-label {
  margin: 24rpx 0 12rpx;
  color: #796d53;
  font-size: 24rpx;
  font-weight: 600;
}

.segmented {
  display: flex;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f5f0e4;
}

.segment {
  flex: 1;
  padding: 16rpx;
  border-radius: 14rpx;
  color: #8e8267;
  font-size: 25rpx;
  text-align: center;
}

.segment.active {
  background: #fff;
  color: #755500;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(88, 67, 15, 0.1);
}

.input-shell,
.compact-picker,
.share-input,
.result-input {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  border: 2rpx solid #eadfbe;
  border-radius: 16rpx;
  background: #fffcf5;
  box-sizing: border-box;
}

.compact-input,
.share-input input,
.result-input input {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.unit,
.share-input text,
.result-input text {
  padding-right: 20rpx;
  color: #9b8c69;
  font-size: 23rpx;
}

.ratio-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.sub-card {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff8df;
}

.sub-card-title {
  font-size: 25rpx;
  font-weight: 700;
}

.share-group {
  margin-top: 30rpx;
  padding-top: 2rpx;
  border-top: 2rpx dashed #ecdfbd;
}

.share-row,
.result-row,
.premium-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
}

.share-name,
.result-meta {
  flex: 1;
  min-width: 0;
}

.share-input {
  width: 190rpx;
}

.result-row {
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f3ecda;
}

.result-row:last-child {
  border-bottom: 0;
}

.result-name,
.result-hint {
  display: block;
}

.result-name {
  font-size: 27rpx;
  font-weight: 700;
}

.result-hint {
  margin-top: 7rpx;
  color: #9d8e6c;
  font-size: 21rpx;
}

.result-input {
  width: 220rpx;
}

.summary-card {
  margin-top: 22rpx;
  background: linear-gradient(145deg, #534612 0%, #79631a 100%);
  color: #fff9de;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.metric {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.1);
}

.metric-value {
  font-size: 34rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 4rpx;
  color: #e8ddb6;
  font-size: 21rpx;
}

.premium-line {
  margin-top: 18rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
}

.compact-picker {
  justify-content: space-between;
  width: 100%;
  padding: 0 22rpx;
  font-size: 27rpx;
}

.picker-arrow {
  color: #d09a00;
  font-size: 40rpx;
}

.warning-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border: 2rpx solid #f2cc68;
  border-radius: 18rpx;
  background: #fff7d7;
  color: #796020;
  font-size: 24rpx;
  line-height: 1.65;
}

.warning-title {
  margin-bottom: 6rpx;
  color: #7d5900;
  font-weight: 700;
}

.button-row {
  display: grid;
  grid-template-columns: 0.72fr 1.28fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  box-sizing: border-box;
}

.button-row .primary-button,
.button-row .secondary-button {
  margin-top: 0;
}

.primary-button {
  background: linear-gradient(135deg, #ffd33d 0%, #ffb900 100%);
  color: #4a3700;
  box-shadow: 0 10rpx 22rpx rgba(222, 161, 0, 0.2);
}

.secondary-button {
  border: 2rpx solid #e5d8b8;
  background: #fff;
  color: #75694e;
}

.primary-button::after,
.secondary-button::after {
  border: none;
}

.primary-button[disabled] {
  opacity: 0.62;
}
.category-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid transparent;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 700;
}

.add-milk-dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx 18rpx;
  box-sizing: border-box;
  background: rgba(55, 40, 17, 0.36);
}

.add-milk-dialog-panel {
  position: relative;
  width: 100%;
  max-width: 720rpx;
  /* 固定高度：切 Tab / 分类时选项数量变化不再引起面板高度跳动 */
  height: 76vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 24rpx 22rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fffdf7 0%, #fff7e7 100%);
  box-shadow: 0 18rpx 42rpx rgba(70, 49, 16, 0.18);
  box-sizing: border-box;
  animation: addMilkDialogIn 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.add-milk-dialog-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  flex-shrink: 0;
  margin-bottom: 18rpx;
}

.add-milk-dialog-title {
  font-size: 28rpx;
}

.add-milk-dialog-corner {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.add-milk-dialog-close {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(214, 173, 92, 0.16);
  color: #9a6f17;
  font-size: 40rpx;
  line-height: 1;
}

.add-milk-dialog-close:active {
  background: rgba(214, 173, 92, 0.3);
}

.add-milk-dialog-manage {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  color: #6b4e16;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffe39a 0%, #ffd271 100%);
  border: 1rpx solid rgba(214, 173, 92, 0.4);
  box-shadow: 0 6rpx 16rpx rgba(123, 84, 23, 0.14);
}

.add-milk-dialog-manage:active {
  background: linear-gradient(135deg, #ffdc86 0%, #ffc955 100%);
}

.add-milk-hint {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.4;
  color: #8d7344;
}

.add-milk-library-tabs {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-bottom: 16rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(214, 173, 92, 0.12);
}

.add-milk-library-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #8a7c60;
}

.add-milk-library-tab.active {
  background: #ffffff;
  color: #5f3900;
  box-shadow: 0 4rpx 10rpx rgba(214, 173, 92, 0.24);
}

/* 库 Tab 下方左右分栏：左分类侧栏 + 右选项列表，布局与食物选择页一致 */
.add-milk-picker-layout {
  flex: 1;
  min-height: 0;
  display: flex;
  gap: 14rpx;
}

.add-milk-category-sidebar {
  width: 168rpx;
  flex-shrink: 0;
  height: 100%;
  background: #FFF7E3;
  border-radius: 20rpx;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.add-milk-category-nav-item {
  position: relative;
  padding: 18rpx 12rpx 18rpx 22rpx;
  color: #8A7C60;
  font-size: 24rpx;
  line-height: 1.35;
}

.add-milk-category-nav-item.active {
  background: #ffffff;
  color: #8A4B00;
  font-weight: 700;
}

.add-milk-category-nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 8rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #FFB800;
}

.add-milk-category-nav-label {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.add-milk-category-empty {
  padding: 24rpx 16rpx;
  color: #A08E73;
  font-size: 23rpx;
}

.add-milk-options-scroll {
  flex: 1;
  min-width: 0;
  height: 100%;
}

.add-milk-options-empty {
  padding: 48rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a7c60;
}

.add-milk-options {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.add-milk-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 248, 228, 0.68);
  border: 1rpx solid rgba(214, 173, 92, 0.1);
}

.add-milk-option-source {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.add-milk-option.selected {
  background: rgba(255, 239, 188, 0.92);
  border-color: rgba(214, 173, 92, 0.28);
}

.add-milk-option-image {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #fff7e3;
  border: 1rpx solid rgba(214, 173, 92, 0.18);
}

.add-milk-option-image {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #f6efdd;
}

.add-milk-option-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.add-milk-option-title {
  font-size: 23rpx;
  color: #402d0d;
  font-weight: 600;
}

.add-milk-option-subtitle {
  font-size: 18rpx;
  color: #8d7344;
}

.add-milk-option-add {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f6efdd;
  color: #8d7344;
  font-size: 36rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-milk-option-add.active {
  background: #FFB800;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 弹窗底部购物车条：加号选中的奶先进这里，点「确定」同步到奶单 */
.add-milk-cart-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: #2C261A;
  box-shadow: 0 8rpx 20rpx rgba(60, 42, 12, 0.22);
}

.add-milk-cart-anchor {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 213, 106, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-milk-cart-icon {
  font-size: 34rpx;
  line-height: 1;
}

.add-milk-cart-badge {
  position: absolute;
  right: -6rpx;
  top: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #FF6B57;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.add-milk-cart-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.add-milk-cart-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.add-milk-cart-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffe9b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-milk-cart-subtitle {
  font-size: 20rpx;
  color: rgba(255, 233, 184, 0.62);
}

/* 点购物车展开的已选明细，浮在购物车条上方，交互与食物选择页一致 */
.add-milk-cart-detail-mask {
  position: absolute;
  inset: 0;
  z-index: 4;
  border-radius: 28rpx;
  background: rgba(55, 40, 17, 0.18);
}

.add-milk-cart-detail {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 136rpx;
  z-index: 5;
  max-height: 52%;
  display: none;
  flex-direction: column;
  padding: 20rpx 20rpx 12rpx;
  border-radius: 22rpx;
  background: #fffdf7;
  box-shadow: 0 12rpx 30rpx rgba(70, 49, 16, 0.2);
  box-sizing: border-box;
}

.add-milk-cart-detail.visible {
  display: flex;
}

.add-milk-cart-detail-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.add-milk-cart-detail-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #5f3900;
}

.add-milk-cart-detail-count {
  font-size: 22rpx;
  color: #8a7c60;
}

.add-milk-cart-detail-list {
  flex: 1;
  min-height: 0;
}

.add-milk-cart-detail-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(214, 173, 92, 0.14);
}

.add-milk-cart-detail-item:last-child {
  border-bottom: none;
}

.add-milk-cart-detail-image {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #f6efdd;
}

.add-milk-cart-detail-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #402d0d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-milk-cart-detail-remove {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 87, 0.12);
  color: #d9553f;
  font-size: 22rpx;
}

.add-milk-cart-confirm {
  flex-shrink: 0;
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
  background: #FFB800;
  color: #3d2c00;
  font-size: 26rpx;
  font-weight: 700;
}

@keyframes addMilkDialogIn {
  0% {
    opacity: 0;
    transform: translate3d(0, 28rpx, 0);
  }
  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

.panel-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.section-eyebrow {
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 1.5rpx;
  color: #c18b28;
}
