<view class="quota-settings-page">
  <view wx:if="{{hasAccess}}" class="page-shell">
    <view class="rules">
      <text>设置所有账号的每日识别上限，每个账号分别计数。</text>
      <text>管理员配置优先生效，未配置时使用云函数兜底值。</text>
    </view>
    <view wx:for="{{quotas}}" wx:key="key" class="config-card">
      <text class="section-title">{{item.title}}</text>
      <text class="description">{{item.description}}</text>
      <text class="current-limit" wx:if="{{item.ready}}">{{item.currentLimit === 0 ? '当前已暂停新识别' : '当前每账号每天 ' + item.currentLimit + ' 次'}}</text>
      <text class="description" wx:elif="{{item.loading}}" aria-live="polite">正在读取当前配置…</text>
      <view class="input-row">
        <input class="limit-input" type="number" value="{{item.limitInput}}" maxlength="5" data-key="{{item.key}}"
          placeholder="输入次数" aria-label="{{item.title}}每账号每日次数"
          bindinput="onLimitInput" bindconfirm="onSaveConfig" disabled="{{item.loading || item.saving || !item.ready}}" />
        <text class="input-unit">次 / 天</text>
      </view>
      <text class="field-error" wx:if="{{item.fieldError}}" aria-live="polite">{{item.fieldError}}</text>
      <text class="field-hint">可填 0～10000；0 表示暂停此类新的识别。</text>
      <text class="field-hint" wx:if="{{item.ready}}">{{item.configured ? '已采用管理员配置' : '当前采用云函数兜底值，保存后以此配置为准'}}</text>
      <view class="error-card" wx:if="{{item.errorText}}">
        <text class="field-error" aria-live="polite">{{item.errorText}}</text>
        <button class="reload-button" wx:if="{{item.canReload}}" data-key="{{item.key}}" bindtap="reloadConfig" disabled="{{item.loading || item.saving}}">重新加载配置</button>
      </view>
      <button class="save-button" data-key="{{item.key}}" bindtap="onSaveConfig" loading="{{item.saving}}" disabled="{{item.loading || item.saving || !item.canSave}}">
        {{item.saving ? '保存中…' : '保存' + item.title + '上限'}}
      </button>
    </view>
    <view class="rules">
      <text>每天 00:00（北京时间）重置。修改上限不清空当天已用次数。</text>
      <text>保存后，新的识别请求直接采用新上限。</text>
    </view>
  </view>
  <view wx:elif="{{loading}}" class="empty-card"><text>正在加载…</text></view>
  <view wx:else class="empty-card">
    <text class="section-title">{{errorText || '无权限访问'}}</text>
    <text class="description">该配置仅管理员可修改。</text>
  </view>
</view>
