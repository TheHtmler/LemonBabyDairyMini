.detail-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); background: #FFF7DC; }
.card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #F4EAD0; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.type-badge, .status-badge { padding: 8rpx 16rpx; border-radius: 10rpx; font-size: 24rpx; }
.type-badge { background: #FFF3C4; color: #845300; }
.status-badge { background: #F2F2F2; color: #666; }
.status-badge.processed { background: #E7F6E9; color: #24733E; }
.time { display: block; margin-top: 20rpx; color: #8A7C60; font-size: 24rpx; line-height: 1.6; }
.section-title { display: block; margin: 24rpx 0 18rpx; color: #5F3900; font-size: 32rpx; font-weight: 700; }
.body-text { display: block; white-space: pre-wrap; word-break: break-all; color: #333; font-size: 30rpx; line-height: 1.8; }
.editor-card .section-title { margin-top: 0; }
.admin-meta { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #EEE9DF; color: #8A7C60; font-size: 24rpx; line-height: 1.8; word-break: break-all; }
.admin-meta text { display: block; }
.editor-hint { display: block; margin-bottom: 20rpx; color: #8A7C60; font-size: 25rpx; line-height: 1.6; }
.reply-input { box-sizing: border-box; width: 100%; min-height: 320rpx; padding: 22rpx; background: #FFFDF5; border: 2rpx solid #F1D68A; border-radius: 16rpx; color: #333; font-size: 29rpx; line-height: 1.7; }
.word-count { display: block; margin: 12rpx 0 20rpx; text-align: right; color: #8A7C60; font-size: 24rpx; }
.detail-page button.primary-button, .detail-page button.secondary-button { width: 100%; height: auto; box-sizing: border-box; margin-top: 20rpx; padding: 20rpx 12rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; color: #5F3900; font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.detail-page button.primary-button { background: #FFBF16; }
.detail-page button.secondary-button { background: #FFFDF5; border: 2rpx solid #FFCB38; }
.primary-button::after, .secondary-button::after, .text-button::after { border: 0; }
.detail-page button.primary-button[disabled], .detail-page button.secondary-button[disabled] { background: #F4E9CA; color: #A79878; }
.page-hint { padding: 20rpx; text-align: center; color: #8A7C60; font-size: 25rpx; }
.error-card { color: #9D4036; font-size: 28rpx; line-height: 1.6; }
.save-error { padding: 18rpx; background: #FFF0E9; border-radius: 12rpx; color: #A63728; font-size: 26rpx; line-height: 1.6; }
.detail-page button.text-button { display: flex; align-items: center; justify-content: center; width: auto; height: auto; min-height: 88rpx; margin: 0; padding: 12rpx 8rpx; background: transparent; color: #8A5B20; font-size: 25rpx; font-weight: 400; line-height: 1.5; }
.thread-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.thread-heading .section-title { margin: 0; font-size: 29rpx; }
.thread-entry { display: flex; flex-direction: column; align-items: flex-start; margin: 28rpx 0; }
.thread-entry.from-me { align-items: flex-end; }
.entry-author { display: block; margin-bottom: 12rpx; color: #8A7C60; font-size: 23rpx; line-height: 1.6; }
.entry-bubble { box-sizing: border-box; max-width: 92%; min-width: 120rpx; padding: 24rpx; border: 1rpx solid #E9DFC6; border-radius: 4rpx 22rpx 22rpx; background: #FFFDF7; }
.from-me .entry-bubble { border-radius: 22rpx 4rpx 22rpx 22rpx; background: #FFF0B8; border-color: #EED891; }
.entry-bubble .body-text { font-size: 28rpx; line-height: 1.7; }
.entry-quote, .composer-quote { margin-bottom: 18rpx; padding: 16rpx; border-radius: 12rpx; background: rgba(117, 94, 38, 0.07); }
.quote-label { display: block; color: #8A7C60; font-size: 22rpx; line-height: 1.6; }
.quote-content { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 3; -webkit-box-orient: vertical; margin-top: 8rpx; color: #776A51; font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.detail-page button.quote-action { padding-left: 0; padding-right: 0; font-size: 23rpx; }
.detail-page button.history-button { margin: 0 0 24rpx; }
