.detail-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); background: #FFF7DC; }
.card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #F4EAD0; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.type-badge, .status-badge { padding: 8rpx 16rpx; border-radius: 10rpx; font-size: 24rpx; }
.type-badge { background: #FFF3C4; color: #845300; }
.status-badge { background: #F2F2F2; color: #666; }
.status-badge.processed { background: #E7F6E9; color: #24733E; }
.time { display: block; margin-top: 20rpx; color: #8A7C60; font-size: 24rpx; line-height: 1.6; }
.section-title { display: block; margin: 24rpx 0 18rpx; color: #5F3900; font-size: 32rpx; font-weight: 700; }
.body-text { display: block; white-space: pre-wrap; word-break: break-all; color: #333; font-size: 30rpx; line-height: 1.8; }
.reply-card { background: #FFF3CB; border-color: #FFE397; }
.reply-title, .editor-card .section-title { margin-top: 0; }
.waiting-card { color: #8A7C60; font-size: 28rpx; line-height: 1.7; }
.waiting-card .section-title { margin-top: 0; }
.admin-meta { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #EEE9DF; color: #8A7C60; font-size: 24rpx; line-height: 1.8; word-break: break-all; }
.admin-meta text { display: block; }
.editor-hint { display: block; margin-bottom: 20rpx; color: #8A7C60; font-size: 25rpx; line-height: 1.6; }
.reply-input { box-sizing: border-box; width: 100%; min-height: 320rpx; padding: 22rpx; background: #FFFDF5; border: 2rpx solid #F1D68A; border-radius: 16rpx; color: #333; font-size: 29rpx; line-height: 1.7; }
.word-count { display: block; margin: 12rpx 0 20rpx; text-align: right; color: #8A7C60; font-size: 24rpx; }
.primary-button, .secondary-button { margin-top: 20rpx; padding: 20rpx 12rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; color: #5F3900; font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.primary-button { background: #FFBF16; }
.secondary-button { background: #FFFDF5; border: 2rpx solid #FFCB38; }
.primary-button::after, .secondary-button::after, .text-button::after { border: 0; }
.primary-button[disabled], .secondary-button[disabled] { background: #F4E9CA; color: #A79878; }
.page-hint { padding: 20rpx; text-align: center; color: #8A7C60; font-size: 25rpx; }
.error-card { color: #9D4036; font-size: 28rpx; line-height: 1.6; }
.save-error { padding: 18rpx; background: #FFF0E9; border-radius: 12rpx; color: #A63728; font-size: 26rpx; line-height: 1.6; }
.text-button { background: transparent; color: #8A5B20; font-size: 26rpx; margin-top: 16rpx; }
