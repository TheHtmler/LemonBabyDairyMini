page { height: 100%; overflow: hidden; background: #F4F5F3; }
.detail-page { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; color: #282B25; background: #F4F5F3; }
.conversation-header { flex-shrink: 0; padding: 0 28rpx; background: #FEFEFC; border-bottom: 1rpx solid #E8EAE5; }
.thread-toolbar { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; gap: 16rpx; }
.thread-heading { display: flex; align-items: center; flex: 1; min-width: 0; gap: 16rpx; }
.thread-type { flex-shrink: 0; font-size: 28rpx; font-weight: 600; }
.status-picker { flex-shrink: 0; }
.thread-status { display: flex; align-items: center; gap: 8rpx; min-height: 80rpx; padding: 0 8rpx; color: #9A7B28; font-size: 22rpx; }
.status-chevron { width: 8rpx; height: 8rpx; margin: -4rpx 2rpx 0 4rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); }
.thread-status.status-saving { opacity: 0.6; }
.status-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #CDA83D; }
.thread-status.processed { color: #64815E; }
.processed .status-dot { background: #7D9A72; }
.thread-actions { display: flex; align-items: center; flex-shrink: 0; gap: 2rpx; }
.privacy-caption { display: block; padding-bottom: 18rpx; margin-top: -8rpx; color: #93978D; font-size: 21rpx; line-height: 1.5; }
.conversation-scroll { flex: 1; min-height: 0; height: 0; width: 100%; }
.conversation-content { padding: 12rpx 28rpx 20rpx; }
.message-group { padding-bottom: 18rpx; }
.message-time { display: block; padding: 16rpx 0 24rpx; text-align: center; color: #9B9F95; font-size: 21rpx; line-height: 1.5; }
.message-row { display: flex; align-items: flex-start; justify-content: flex-start; }
.message-row.from-me { justify-content: flex-end; }
/* 使用单层内容容器，让短消息自然收拢，长消息在最大宽度内换行。 */
.message-main { display: block; flex: 0 1 auto; min-width: 0; max-width: 84%; }
.message-author { display: flex; align-items: center; gap: 12rpx; margin: 0 4rpx 10rpx; color: #8A9083; font-size: 21rpx; line-height: 1.5; }
.from-me .message-author { justify-content: flex-end; }
.new-label { color: #B67529; }
.message-bubble { box-sizing: border-box; padding: 18rpx 24rpx; border-radius: 6rpx 20rpx 20rpx; background: #FEFEFC; }
.from-me .message-bubble { background: #FFE794; border-radius: 20rpx 6rpx 20rpx 20rpx; }
.body-text { display: block; color: #282B25; font-size: 29rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere; }
.entry-quote { margin-bottom: 14rpx; padding: 12rpx 16rpx; border-radius: 8rpx; background: rgba(74, 79, 62, 0.06); }
.quote-label { display: block; color: #737A6A; font-size: 21rpx; line-height: 1.5; }
.quote-content { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 4rpx; color: #878D7F; font-size: 24rpx; line-height: 1.5; white-space: pre-wrap; word-break: break-all; }
.received-note { margin: 12rpx 24rpx 20rpx; color: #92998A; font-size: 23rpx; line-height: 1.7; text-align: center; }
.received-title { display: block; margin-bottom: 4rpx; }
.conversation-end { height: 8rpx; }
.composer { flex-shrink: 0; padding: 18rpx 24rpx calc(8rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #E5E8E0; background: #F8F9F6; }
.keyboard-open .composer { padding-bottom: 6rpx; }
.composer-row { display: flex; align-items: flex-end; gap: 16rpx; }
.input-shell { flex: 1; width: 0; min-width: 0; overflow: hidden; border-radius: 16rpx; background: #FEFEFC; }
.reply-input { display: block; width: 100%; min-height: 80rpx; max-height: 180rpx; box-sizing: border-box; padding: 18rpx 22rpx; color: #282B25; font-size: 28rpx; line-height: 44rpx; }
.input-placeholder { color: #A1A69A; }
.composer-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 52rpx; }
.composer-hint { flex: 1; color: #999F91; font-size: 20rpx; line-height: 1.5; }
.word-count { flex-shrink: 0; margin-left: auto; color: #999F91; font-size: 20rpx; }
.word-count.near-limit { color: #AE7841; }
.process-options { flex: 1; min-width: 0; }
.process-option { display: flex; align-items: center; min-height: 60rpx; color: #818A76; font-size: 22rpx; }
.process-option checkbox { transform: scale(0.7); transform-origin: left center; margin-right: -10rpx; }
.composer-quote { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; padding: 12rpx 16rpx; border-radius: 10rpx; background: #ECEFE6; }
.composer-quote-copy { flex: 1; min-width: 0; }
.composer-quote .quote-content { -webkit-line-clamp: 1; }
.inline-error { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 28rpx; background: #F9ECE5; color: #A25D40; font-size: 24rpx; line-height: 1.6; }
.inline-error > text { flex: 1; }
.save-error { max-height: 110rpx; overflow-y: auto; margin-bottom: 12rpx; color: #A25D40; font-size: 23rpx; line-height: 1.6; word-break: break-all; }
.admin-meta { max-height: 240rpx; overflow-y: auto; margin: 0 0 20rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #F1F3EC; color: #7C8570; font-size: 23rpx; line-height: 1.8; word-break: break-all; }
.admin-meta text { display: block; }
.page-state { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 64rpx 48rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 24rpx; background: #FFE794; color: #5C4F23; font-size: 32rpx; }
.state-title { display: block; margin-top: 28rpx; color: #535C46; font-size: 32rpx; font-weight: 600; }
.state-description { display: block; margin-top: 16rpx; color: #8D9582; font-size: 26rpx; line-height: 1.8; text-align: center; }
/* 显式覆盖小程序按钮默认尺寸，避免发送按钮挤占输入栏。 */
.detail-page button { width: auto; min-width: 0; margin: 0; padding: 0; box-sizing: border-box; }
.detail-page button::after { border: 0; }
.detail-page button.primary-button { display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 18rpx 28rpx; border-radius: 14rpx; background: #F3CB49; color: #493D17; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.detail-page button.send-button { flex: 0 0 104rpx; width: 104rpx; min-width: 104rpx; max-width: 104rpx; height: 80rpx; padding: 0; }
.detail-page button.state-button { min-width: 260rpx; margin-top: 36rpx; }
.detail-page button.text-button { display: flex; align-items: center; justify-content: center; min-height: 72rpx; padding: 10rpx 16rpx; background: transparent; color: #858F77; font-size: 24rpx; font-weight: 400; line-height: 1.5; }
.detail-page button.toolbar-button { flex: 0 0 76rpx; width: 76rpx; min-width: 76rpx; max-width: 76rpx; height: 80rpx; padding: 0; }
.detail-page button.toolbar-button.active { color: #495B38; }
.detail-page button.quote-action { justify-content: flex-start; min-height: 56rpx; margin-left: -8rpx; padding: 6rpx 12rpx; color: #929B85; font-size: 21rpx; }
.detail-page button.conflict-button { justify-content: flex-start; padding-left: 0; color: #A25D40; }
.detail-page button.history-button { margin: 0 auto 12rpx; }
.detail-page button.notice-button { margin: 0 auto; }
.detail-page button.primary-button[disabled] { background: #E9ECE3; color: #AFB6A5; }
.detail-page button.text-button[disabled] { color: #B0B8A5; }
