<view class="feedback-page">
  <view class="feedback-tabs">
    <view class="feedback-tab {{activeTab === 'submit' ? 'selected' : ''}}" data-tab="submit" bindtap="onTabTap">提交反馈</view>
    <view class="feedback-tab {{activeTab === 'mine' ? 'selected' : ''}}" data-tab="mine" bindtap="onTabTap">
      我的反馈<view wx:if="{{unreadCount > 0}}" class="unread-dot" />
    </view>
  </view>
  <view hidden="{{activeTab !== 'submit'}}">
  <view class="hero-card">
    <text class="hero-title">告诉我们你的想法</text>
    <text class="hero-subtitle">围绕同一个问题查看处理进度、补充情况，并继续追问。</text>
  </view>

  <view class="section-card">
    <view class="section-header">
      <text class="section-title">反馈类型</text>
      <text class="section-meta">先选一个最接近的分类</text>
    </view>
    <view class="type-chip-group">
      <view
        class="type-chip {{selectedType === item ? 'active' : ''}}"
        wx:for="{{feedbackTypes}}"
        wx:key="*this"
        data-type="{{item}}"
        bindtap="onTypeTap"
      >
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <text class="section-title">反馈内容</text>
      <text class="section-meta">{{content.length}} 字</text>
    </view>
    <textarea
      class="feedback-textarea"
      maxlength="500"
      placeholder="例如：哪里不好用、希望增加什么能力、遇到了什么问题"
      value="{{content}}"
      bindinput="onContentInput"
    />
  </view>

  <view class="submit-bar">
    <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitFeedback">
      提交反馈
    </button>
  </view>
  </view>

  <view hidden="{{activeTab !== 'mine'}}">
    <view wx:if="{{unreadCount > 0}}" class="unread-banner">有 {{unreadCount}} 条反馈收到新回复</view>
    <view wx:for="{{feedbackItems}}" wx:key="_id" class="section-card feedback-item" data-id="{{item._id}}" bindtap="openFeedback">
      <view class="feedback-item-head">
        <text class="type-label">{{item.type}}</text>
        <text class="status-label {{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="item-time">{{item.displayTime}}</text>
      <text class="item-content clamp-two">{{item.content}}</text>
      <view class="reply-preview">
        <view wx:if="{{item.replyContent}}" class="reply-preview-title">
          <text>最新管理员回复</text>
          <view wx:if="{{item.hasUnreadReply}}" class="new-reply"><view class="unread-dot" /><text>新回复</text></view>
          <text wx:else class="read-label">已回复</text>
        </view>
        <text class="reply-summary clamp-two">{{item.replyContent || '暂无管理员回复'}}</text>
      </view>
      <view class="detail-link">查看记录与继续追问 ›</view>
    </view>
    <view wx:if="{{listError}}" class="section-card list-state">
      <text>{{listError}}</text>
      <button class="retry-button" bindtap="retryList">重新加载</button>
    </view>
    <view wx:elif="{{listLoaded && !feedbackItems.length && !listLoading}}" class="section-card list-state">
      <text>你还没有提交过反馈</text>
      <button class="retry-button" bindtap="goToSubmit">去提交反馈</button>
    </view>
    <view wx:if="{{listLoading}}" class="list-footer">正在加载反馈…</view>
    <view wx:elif="{{listLoaded && feedbackItems.length && !nextCursor && !listError}}" class="list-footer">已显示全部反馈</view>
  </view>
</view>
