.notice-settings-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7dc 0%, #fff2c8 100%);
}

.page-shell {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.config-card,
.empty-card {
  padding: 24rpx;
  background: #fffdf8;
  border: 2rpx solid rgba(255, 184, 0, 0.12);
  border-radius: 24rpx;
}

.section-title,
.field-label,
.status-text,
.error-text {
  display: block;
}

.section-title {
  margin-bottom: 14rpx;
  color: #5f3900;
  font-size: 29rpx;
  font-weight: 700;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.switch-copy .section-title {
  margin-bottom: 6rpx;
}

.field-label {
  margin: 18rpx 0 8rpx;
  color: #5f3900;
  font-size: 25rpx;
  font-weight: 600;
}

.title-input,
.message-textarea,
.date-picker {
  width: 100%;
  padding: 14rpx;
  border: 2rpx solid rgba(201, 136, 23, 0.18);
  border-radius: 16rpx;
  background: #fffaf0;
  box-sizing: border-box;
  color: #2c1d09;
  font-size: 28rpx;
  line-height: 1.55;
}

.title-input,
.date-picker {
  min-height: 72rpx;
}

.date-picker,
.history-toolbar,
.form-actions,
.entry-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker,
.history-toolbar {
  justify-content: space-between;
}

.history-toolbar {
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.history-toolbar .section-title {
  margin-bottom: 0;
}

.field-placeholder {
  color: #775e38;
}

.message-textarea {
  height: 280rpx;
}

.field-hint,
.status-text,
.history-date {
  display: block;
  color: #775e38;
  font-size: 24rpx;
  line-height: 1.5;
}

.field-hint,
.error-text {
  margin-top: 10rpx;
}

.error-text {
  color: #a6392b;
  font-size: 25rpx;
  line-height: 1.5;
}

.form-actions {
  margin-top: 24rpx;
}

.form-actions button {
  flex: 1;
}

.save-button,
.secondary-button,
.new-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #ffca5c;
  color: #3d290c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.secondary-button,
.new-button {
  background: #fff3ce;
  border: 1rpx solid #ead6a4;
}

.history-toolbar > button.new-button {
  flex: 0 0 auto;
  width: auto;
  min-height: 74rpx;
  margin: 0 0 0 auto;
  padding: 0 18rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.history-group + .history-group {
  margin-top: 24rpx;
}

.history-group > .history-date {
  margin-bottom: 8rpx;
  font-weight: 700;
}

.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 0;
  border-top: 1rpx solid #eee3cc;
}

.history-copy {
  flex: 1 1 0;
  min-width: 0;
}

.text-button,
.entry-button {
  min-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.4;
}

.history-title,
.history-content {
  display: block;
  color: #493d28;
  word-break: break-word;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.history-content {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.entry-actions {
  flex: 0 0 auto;
  gap: 4rpx;
}

.entry-actions > button.entry-button {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  color: #825200;
  font-weight: 500;
  font-size: 25rpx;
  white-space: nowrap;
}

.entry-actions > button.entry-delete {
  color: #a6392b;
}

.latest-version {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #fff4d6;
}

.latest-version .field-label {
  margin-top: 0;
}

.text-button {
  flex-shrink: 0;
  color: #825200;
  font-size: 25rpx;
}

.text-button {
  margin: 10rpx 0 0;
}

.save-button::after,
.secondary-button::after,
.new-button::after,
.entry-button::after,
.text-button::after {
  border: none;
}

.empty-card {
  padding: 64rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #5f3900;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #775e38;
  font-size: 24rpx;
}
