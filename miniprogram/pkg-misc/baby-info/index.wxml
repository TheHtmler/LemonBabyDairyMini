<view class="container">
  <view class="header">
    <text class="title">{{createMode ? '添加宝宝' : (firstLogin ? '完善宝宝信息' : '宝宝信息管理')}}</text>
    <text class="subtitle">{{createMode ? '可从已有宝宝导入食物、食谱和奶粉，各宝宝数据互不影响' : (firstLogin ? '首次使用需要完善以下信息' : '您可以随时更新宝宝的成长数据')}}</text>
  </view>
  
  <view class="form-container">
    <!-- 基本信息 -->
    <view class="form-group">
      <view class="form-title">基本信息</view>
      
      <!-- 头像展示（点击可更换，与「我的」页一致；仅信息所有者可改） -->
      <view class="avatar-section">
        <view class="item-label">宝宝头像</view>
        <view class="avatar-wrapper" bindtap="onAvatarClick">
          <image class="avatar" src="{{babyInfo.avatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
          <view class="avatar-edit-icon" wx:if="{{isOwner}}">换头像</view>
        </view>
      </view>
      
      <view class="form-item">
        <view class="item-label">宝宝昵称<text class="required">*</text></view>
        <input 
          class="input" 
          placeholder="请输入宝宝的昵称" 
          value="{{babyInfo.name}}" 
          bindinput="onInput" 
          data-field="name"
          disabled="{{!isOwner}}"
        />
      </view>
      
      <view class="form-item">
        <view class="item-label">性别</view>
        <picker 
          mode="selector" 
          range="{{genders}}" 
          value="{{genderIndex}}" 
          bindchange="onGenderChange"
          disabled="{{!isOwner}}"
        >
          <view class="picker">
            {{genders[genderIndex]}}
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>
      
      <view class="form-item">
        <view class="item-label">出生日期<text class="required">*</text></view>
        <picker 
          mode="date" 
          value="{{babyInfo.birthday}}" 
          bindchange="onBirthdayChange"
          disabled="{{!isOwner}}"
        >
          <view class="picker">
            {{babyInfo.birthday || '请选择出生日期'}}
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>
    
    <!-- 生长信息 -->
    <view class="form-group">
      <view class="form-title">生长信息</view>
      
      <view class="form-item">
        <view class="item-label">体重(kg)<text class="required">*</text></view>
        <input 
          class="input" 
          type="digit" 
          placeholder="请输入体重" 
          value="{{babyInfo.weight}}" 
          bindinput="onInput" 
          data-field="weight"
          disabled="{{!isOwner}}"
        />
      </view>
      
      <view class="form-item">
        <view class="item-label">身高(cm)</view>
        <input 
          class="input" 
          type="digit" 
          placeholder="请输入身高" 
          value="{{babyInfo.height}}" 
          bindinput="onInput" 
          data-field="height"
          disabled="{{!isOwner}}"
        />
      </view>
    </view>
    
    <!-- 健康信息 -->
    <view class="form-group">
      <view class="form-title">健康信息</view>
      
      <view class="form-item">
        <view class="item-label">疾病类型</view>
        <picker 
          mode="selector" 
          range="{{conditions}}" 
          value="{{conditionIndex}}" 
          bindchange="onConditionChange"
          disabled="{{!isOwner}}"
        >
          <view class="picker">
            {{conditions[conditionIndex]}}
            <text class="arrow">▼</text>
          </view>
        </picker>
      </view>
      
      <view class="form-item textarea-item">
        <view class="item-label">其他备注</view>
        <textarea 
          class="textarea" 
          placeholder="可以填写宝宝的其他健康信息" 
          value="{{babyInfo.notes}}" 
          bindinput="onInput" 
          data-field="notes"
          maxlength="200"
          disabled="{{!isOwner}}"
        ></textarea>
      </view>
    </view>

    <!-- 联系方式（创建者必填） -->
    <!-- 邀请码信息（仅创建者可见）-->
    <view class="form-group" wx:if="{{userRole === 'creator' && showInviteCode}}">
      <view class="form-title">邀请码信息</view>
      
      <view class="invite-card">
        <view class="invite-header">
          <view class="invite-icon">🎯</view>
          <view class="invite-title">分享邀请码</view>
        </view>
        
        <view class="invite-code-display">
          <text class="invite-code-text">{{babyInfo.inviteCode}}</text>
          <button class="copy-btn" data-text="{{babyInfo.inviteCode}}" bindtap="onCopyInviteCode">复制</button>
        </view>
        
        <view class="invite-actions">
          <button class="share-btn" bindtap="onShareInviteCode">微信分享</button>
          <button class="refresh-btn" bindtap="onRefreshInviteCode">刷新邀请码</button>
        </view>
        
        <view class="invite-tip">
          <text>• 邀请码有效期30天</text>
          <text>• 家人可通过此邀请码加入宝宝记录</text>
          <text>• 可随时刷新生成新的邀请码</text>
        </view>
      </view>
    </view>

    <!-- 从其他宝宝导入数据（存在其他可访问宝宝时显示；一次性复制，复制后数据隔离） -->
    <view class="form-group" wx:if="{{importSources.length > 0}}">
      <view class="form-title">从其他宝宝导入数据（可选）</view>
      <view class="import-card">
        <view class="import-tip">把来源宝宝的库数据一次性复制到{{createMode ? '新宝宝' : '当前宝宝'}}，复制后各宝宝数据独立、互不影响。</view>
        <view class="form-item">
          <view class="item-label">来源宝宝</view>
          <picker mode="selector" range="{{importSourceNames}}" value="{{importSourceIndex}}" bindchange="onImportSourceChange">
            <view class="picker">
              {{importSourceNames[importSourceIndex]}}
              <text class="arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="import-types">
          <view class="import-type {{importTypes.foods ? 'checked' : ''}}" data-type="foods" bindtap="onToggleImportType">食物库</view>
          <view class="import-type {{importTypes.recipes ? 'checked' : ''}}" data-type="recipes" bindtap="onToggleImportType">食谱</view>
          <view class="import-type {{importTypes.powders ? 'checked' : ''}}" data-type="powders" bindtap="onToggleImportType">奶粉档案</view>
          <view class="import-type {{importTypes.categories ? 'checked' : ''}}" data-type="categories" bindtap="onToggleImportType">食物分类</view>
          <view class="import-type {{importTypes.nutrition ? 'checked' : ''}}" data-type="nutrition" bindtap="onToggleImportType">配奶营养参数</view>
        </view>
        <view class="import-hint" wx:if="{{importTypes.nutrition}}">配奶营养参数仅含母乳成分，不含天然蛋白系数（因宝宝而异），导入后请到配奶设置确认。</view>
        <view class="import-hint" wx:if="{{createMode}}">保存并创建新宝宝后，将自动导入勾选的数据。</view>
        <button class="import-now-btn" wx:if="{{!createMode}}" bindtap="onImportNow" disabled="{{importing}}">{{importing ? '导入中...' : '立即导入'}}</button>
      </view>
    </view>
  </view>
  
  <view class="footer">
    <view class="tips">
      <text class="required">*</text> 为必填项
    </view>
    <button 
      class="save-btn {{isFormValid ? 'active' : ''}} {{isFormSubmitting || (!isOwner)}}" 
      disabled="{{!isFormValid || isFormSubmitting || (!isOwner)}}" 
      bindtap="saveBabyInfo"
    >
      {{firstLogin ? '完成' : '保存'}}
    </button>
  </view>
</view>

<avatar-cropper
  visible="{{showAvatarCropper}}"
  imageSrc="{{avatarCropSrc}}"
  cropSize="{{300}}"
  uploading="{{uploadingAvatar}}"
  bind:close="hideAvatarCropper"
  bind:confirm="onAvatarCropped"
/>
