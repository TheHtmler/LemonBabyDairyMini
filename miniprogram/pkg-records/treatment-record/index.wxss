.page {
  min-height: 100vh;
  padding: 8rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #FFFDF8;
}

.meta {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 16rpx 0 28rpx;
  border-bottom: 1rpx solid rgba(44, 36, 22, 0.08);
  margin-bottom: 28rpx;
}

.meta picker {
  flex: 1;
  min-width: 0;
}

.meta-picker {
  min-height: 72rpx;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #FFF9EC;
  border: 2rpx solid rgba(255, 184, 0, 0.22);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meta-picker-label {
  font-size: 22rpx;
  color: #8A7B5C;
  flex-shrink: 0;
}

.meta-picker-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #2C2416;
}

.meta-picker.is-placeholder .meta-picker-value {
  color: #B9A57A;
  font-weight: 500;
}

.meta-picker-caret {
  font-size: 22rpx;
  color: #A67C00;
  font-weight: 700;
  flex-shrink: 0;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.list-label {
  font-size: 24rpx;
  color: #8A7B5C;
}

.list-toggle {
  font-size: 24rpx;
  color: #A67C00;
  font-weight: 700;
  padding: 8rpx 4rpx;
}

.group {
  margin-bottom: 16rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(44, 36, 22, 0.08);
}

.group.collapsed {
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.group.open {
  padding: 28rpx;
  border-color: rgba(255, 184, 0, 0.45);
  box-shadow: 0 12rpx 36rpx rgba(255, 184, 0, 0.12);
}

.idx {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #FFF9EC;
  color: #9A7A20;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.idx.active {
  background: linear-gradient(180deg, #FFD24A, #FFB800);
  color: #4A3200;
}

.summary {
  flex: 1;
  min-width: 0;
}

.summary-main {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C2416;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A7B5C;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  color: #8A7B5C;
  font-size: 32rpx;
  line-height: 1;
}

.open-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -8rpx -8rpx 24rpx;
  padding: 8rpx;
}

.open-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #2C2416;
}

.open-chev {
  font-size: 24rpx;
  font-weight: 600;
  color: #8A7B5C;
}

.danger {
  font-size: 26rpx;
  color: #C75B4A;
  font-weight: 600;
}

.rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name-wrap {
  flex: 1.4;
  min-width: 0;
}

.name-wrap picker,
.unit-wrap picker {
  display: block;
  width: 100%;
}

.name-box,
.name-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #FFF9EC;
  color: #2C2416;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.name-input {
  font-weight: 600;
}

.name-box.placeholder {
  color: #B9A57A;
  font-weight: 500;
}

.amount-input {
  width: 120rpx;
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #FFF9EC;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #2C2416;
}

.unit-wrap {
  width: 96rpx;
  flex-shrink: 0;
}

.unit-box {
  width: 96rpx;
  height: 72rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #FFF1C2;
  border: 2rpx solid rgba(255, 184, 0, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #8A6500;
}

.x-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C4B396;
  font-size: 34rpx;
  line-height: 1;
}

.empty-panel {
  padding: 24rpx 16rpx 8rpx;
  border-radius: 18rpx;
  background: #FFF9EC;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.empty-hint {
  color: #B09A6A;
  font-size: 24rpx;
}

.empty-add-btn {
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFD24A, #FFB800);
  color: #4A3200;
  font-size: 26rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.add-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.add-chip {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(44, 36, 22, 0.12);
  background: transparent;
  font-size: 22rpx;
  font-weight: 600;
  color: #8A7B5C;
  display: inline-flex;
  align-items: center;
}

.add-group {
  margin-top: 8rpx;
  height: 80rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(44, 36, 22, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #8A7B5C;
  background: transparent;
}

.notes-block {
  margin-top: 28rpx;
}

.notes-label {
  font-size: 24rpx;
  color: #8A7B5C;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.notes-area {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #FFF9EC;
  border: none;
  color: #2C2416;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.calc-note {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FFF9EC;
  color: #8A7B5C;
  font-size: 22rpx;
  line-height: 1.5;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0), #FFFDF8 28%);
  z-index: 30;
}

.footer-hint {
  text-align: center;
  font-size: 22rpx;
  color: #8A7B5C;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.footer-btns {
  display: flex;
  gap: 16rpx;
}

.primary-action,
.ghost-action {
  height: 88rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-action {
  flex: 1;
  width: 100%;
  background: linear-gradient(180deg, #FFD24A, #FFB800);
  color: #4A3200;
  box-shadow: 0 12rpx 28rpx rgba(255, 184, 0, 0.35);
}

.ghost-action {
  width: 160rpx;
  flex-shrink: 0;
  background: #FFFFFF;
  color: #C75B4A;
  border: 2rpx solid rgba(199, 91, 74, 0.18);
  font-weight: 700;
  font-size: 28rpx;
}
