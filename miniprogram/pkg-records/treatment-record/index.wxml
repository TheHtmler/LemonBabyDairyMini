<view class="page">
  <view class="meta">
    <picker mode="date" value="{{dateKey}}" bindchange="onDateChange">
      <view class="meta-picker">
        <text class="meta-picker-label">日期</text>
        <text class="meta-picker-value">{{dateDisplay}}</text>
        <text class="meta-picker-caret">▾</text>
      </view>
    </picker>
    <picker mode="time" value="{{form.startTime || '12:00'}}" bindchange="onStartTimeChange">
      <view class="meta-picker {{form.startTime ? '' : 'is-placeholder'}}">
        <text class="meta-picker-label">时间</text>
        <text class="meta-picker-value">{{form.startTime || '未填'}}</text>
        <text class="meta-picker-caret">▾</text>
      </view>
    </picker>
  </view>

  <view class="list-head">
    <text class="list-label">共 {{form.groups.length}} 组</text>
    <text class="list-toggle" bindtap="toggleAllGroups">{{allGroupsExpanded ? '全部折叠' : '全部展开'}}</text>
  </view>

  <block wx:for="{{form.groups}}" wx:key="id" wx:for-index="groupIndex">
    <!-- 展开 -->
    <view class="group open" wx:if="{{item.expanded}}">
      <view class="open-head" bindtap="toggleGroupExpanded" data-group-index="{{groupIndex}}">
        <view class="open-title">
          <view class="idx active">{{groupIndex + 1}}</view>
          <text>第 {{groupIndex + 1}} 组</text>
          <text class="chev open-chev">▾</text>
        </view>
        <text class="danger" catchtap="removeTreatmentGroup" data-group-index="{{groupIndex}}">删除</text>
      </view>

      <view class="rows" wx:if="{{item.items.length > 0}}">
        <view class="row" wx:for="{{item.items}}" wx:key="id" wx:for-item="ingredient" wx:for-index="itemIndex">
          <view class="name-wrap">
            <block wx:if="{{ingredient.category === 'custom'}}">
              <input
                class="name-input"
                value="{{ingredient.name}}"
                placeholder="自定义药物"
                bindinput="onItemInput"
                data-group-index="{{groupIndex}}"
                data-item-index="{{itemIndex}}"
                data-field="name"
              />
            </block>
            <block wx:else>
              <picker
                range="{{categoryOptions}}"
                range-key="label"
                value="{{ingredient.categoryIndex >= 0 ? ingredient.categoryIndex : 0}}"
                bindchange="onItemCategoryChange"
                data-group-index="{{groupIndex}}"
                data-item-index="{{itemIndex}}"
              >
                <view class="name-box {{ingredient.category ? '' : 'placeholder'}}">{{ingredient.name || '选择药物'}} ▾</view>
              </picker>
            </block>
          </view>

          <input
            class="amount-input"
            type="digit"
            value="{{ingredient.amount}}"
            placeholder="剂量"
            bindinput="onItemInput"
            data-group-index="{{groupIndex}}"
            data-item-index="{{itemIndex}}"
            data-field="amount"
          />

          <view class="unit-wrap">
            <picker
              range="{{unitOptions}}"
              value="{{ingredient.unitIndex || 0}}"
              bindchange="onItemUnitChange"
              data-group-index="{{groupIndex}}"
              data-item-index="{{itemIndex}}"
            >
              <view class="unit-box">{{ingredient.unit || 'ml'}} ▾</view>
            </picker>
          </view>

          <view
            class="x-btn"
            catchtap="removeTreatmentItem"
            data-group-index="{{groupIndex}}"
            data-item-index="{{itemIndex}}"
          >×</view>
        </view>
      </view>

      <view class="empty-panel" wx:if="{{item.items.length === 0}}">
        <text class="empty-hint">本组还没有药物</text>
        <view
          class="empty-add-btn"
          bindtap="onQuickAdd"
          data-group-index="{{groupIndex}}"
          data-category="dextrose_10"
        >+ 添加</view>
      </view>

      <view class="add-row">
        <view
          class="add-chip"
          wx:for="{{quickAddOptions}}"
          wx:key="value"
          wx:for-item="option"
          bindtap="onQuickAdd"
          data-group-index="{{groupIndex}}"
          data-category="{{option.value}}"
        >+ {{option.shortLabel}}</view>
      </view>
    </view>

    <!-- 收起：不用 wx:else，避免和组内空态 if/else 冲突 -->
    <view
      class="group collapsed"
      wx:if="{{!item.expanded}}"
      bindtap="toggleGroupExpanded"
      data-group-index="{{groupIndex}}"
    >
      <view class="idx">{{groupIndex + 1}}</view>
      <view class="summary">
        <view class="summary-main">{{item.summaryMain}}</view>
        <view class="summary-sub">{{item.summarySub}}</view>
      </view>
      <text class="chev">›</text>
    </view>
  </block>

  <view class="add-group" bindtap="addTreatmentGroup">+ 添加一组</view>

  <view class="notes-block">
    <view class="notes-label">备注</view>
    <textarea
      class="notes-area"
      value="{{form.notes}}"
      placeholder="选填本次治疗说明"
      bindinput="onNotesInput"
    />
  </view>

  <nutrition-target-preview
    preview="{{targetPreview}}"
    title="热量目标提醒"
    subtitle="治疗项不计入天然/特殊蛋白，仅提示热量影响"
    showProtein="{{false}}"
    setup-mode="calorie"
    bind:targetssaved="handleNutritionTargetsSaved"
  />

  <view class="calc-note">
    <text>葡萄糖热量按肠外营养口径估算：1 g 葡萄糖约 3.4 kcal。</text>
  </view>

  <view class="footer-actions">
    <view class="footer-hint">液体 {{summary.fluidVolume || 0}} ml · 热量 {{summary.totalCalories || 0}} kcal</view>
    <view class="footer-btns">
      <view class="ghost-action" wx:if="{{isEdit}}" bindtap="deleteRecord">删除</view>
      <view class="primary-action" bindtap="saveRecord">保存</view>
    </view>
  </view>
</view>
