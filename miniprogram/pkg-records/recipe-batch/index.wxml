<view class="page">
  <view class="loading-state" wx:if="{{loading}}">正在打开这道菜...</view>

  <block wx:elif="{{recipeId}}">
    <view class="intro-card">
      <text class="intro-title">{{recipeName}}</text>
      <text class="intro-meta">{{draftIngredients.length}}种食物</text>
    </view>

    <view class="soft-card">
      <view class="ingredient-edit-list">
        <view
          class="ingredient-edit-row {{item.quantityMissing ? 'missing' : ''}}"
          id="ingredient-block-{{ingredientIndex}}"
          wx:for="{{draftIngredients}}"
          wx:key="index"
          wx:for-index="ingredientIndex"
        >
          <view class="ingredient-edit-line">
            <text class="ingredient-name">{{item.foodName}}</text>
            <input
              class="qty-input {{item.quantityMissing ? 'missing' : ''}}"
              type="digit"
              value="{{item.quantity}}"
              placeholder="必填"
              placeholder-class="qty-placeholder"
              focus="{{focusedQuantityIndex === ingredientIndex}}"
              data-index="{{ingredientIndex}}"
              bindinput="onIngredientQuantityInput"
              bindblur="onIngredientQuantityBlur"
              confirm-type="done"
            />
            <text class="unit-text">{{item.unit}}</text>
          </view>
        </view>
      </view>

      <view class="qty-action-panel" wx:if="{{showQtyActions}}">
        <view class="qty-action-row">
          <text class="qty-action-label">快捷操作：</text>
          <text
            class="qty-action-chip"
            wx:if="{{hasDefaultQuantities}}"
            bindtap="applyDefaultQuantities"
          >默认份量</text>
          <text
            class="qty-action-chip"
            wx:if="{{hasLastQuantities}}"
            bindtap="applyLastQuantities"
          >上次份量</text>
          <text class="qty-action-chip danger" bindtap="clearAllQuantities">清空</text>
        </view>
      </view>
    </view>

    <view class="nutrition-preview">
      <view class="nutrition-preview-head">
        <text class="nutrition-preview-title">这次一共</text>
        <text class="nutrition-preview-meta">约 {{batchPreview.totalWeightG}}g</text>
      </view>
      <view class="summary-grid">
        <view class="summary-item">
          <text class="summary-value">{{batchPreview.totalCalories}}</text>
          <text class="summary-label">热量</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{batchPreview.totalProtein}}</text>
          <text class="summary-label">蛋白</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{batchPreview.totalCarbs}}</text>
          <text class="summary-label">碳水</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{batchPreview.totalFat}}</text>
          <text class="summary-label">脂肪</text>
        </view>
      </view>
      <view class="nutrition-preview-premium" wx:if="{{batchPreview.showPremiumProtein}}">
        <text class="nutrition-preview-premium-text">含优质蛋白 {{batchPreview.premiumProteinText}}g · {{batchPreview.premiumRatio}}%</text>
      </view>
    </view>

    <view class="soft-card intake-card">
      <view class="intake-panel">
        <view class="intake-panel-head">
          <text class="intake-panel-label">吃了多少</text>
          <view class="mode-tabs compact">
            <view
              class="mode-tab {{intakeMode === 'grams' ? 'active' : ''}} {{batchPreview.canUseGramsIntake ? '' : 'disabled'}}"
              data-mode="grams"
              bindtap="switchIntakeMode"
            >克数</view>
            <view
              class="mode-tab {{intakeMode === 'percent' ? 'active' : ''}}"
              data-mode="percent"
              bindtap="switchIntakeMode"
            >百分比</view>
          </view>
        </view>
        <view class="intake-value-row" id="intake-value-row">
          <input
            class="qty-input intake-input {{intakeValueMissing ? 'missing' : ''}}"
            type="digit"
            value="{{intakeValue}}"
            placeholder="必填"
            placeholder-class="qty-placeholder"
            focus="{{focusedIntake}}"
            bindinput="onIntakeValueInput"
            bindblur="onIntakeValueBlur"
            confirm-type="done"
          />
          <text class="unit-text">{{intakeMode === 'grams' ? 'g' : '%'}}</text>
        </view>
        <text class="intake-tip" wx:if="{{intakePreview.tip}}">{{intakePreview.tip}}</text>
      </view>

      <view class="intake-detail" wx:if="{{intakePreview.visible}}">
        <view class="summary-grid">
          <view class="summary-item">
            <text class="summary-value">{{intakePreview.calories}}</text>
            <text class="summary-label">热量</text>
          </view>
          <view class="summary-item">
            <text class="summary-value">{{intakePreview.protein}}</text>
            <text class="summary-label">总蛋白</text>
          </view>
          <view class="summary-item">
            <text class="summary-value">{{intakePreview.carbs}}</text>
            <text class="summary-label">碳水</text>
          </view>
          <view class="summary-item">
            <text class="summary-value">{{intakePreview.fat}}</text>
            <text class="summary-label">脂肪</text>
          </view>
        </view>
        <view class="intake-detail-note" wx:if="{{intakePreview.showPremium}}">
          <text>含优质蛋白 {{intakePreview.premiumValue}}g · {{intakePreview.premiumRatio}}%</text>
        </view>
      </view>
    </view>

    <view class="save-preview-stack" wx:if="{{intakeTargetPreview}}">
      <nutrition-target-preview
        preview="{{intakeTargetPreview}}"
        title="保存前看看"
        subtitle="已记录 + 本次"
        bind:targetssaved="handleNutritionTargetsSaved"
      />
    </view>
    <view class="scroll-space"></view>
  </block>

  <view class="footer-actions" wx:if="{{!loading && recipeId}}">
    <button class="confirm-btn" bindtap="confirmSelection">{{isEditMode ? '更新本顿食谱' : '加入本顿'}}</button>
  </view>
</view>
