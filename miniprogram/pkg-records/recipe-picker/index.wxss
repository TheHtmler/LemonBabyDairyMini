page {
  background: #fef8ec;
  color: #3f3424;
  height: 100%;
}

.page {
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding: 0;
  background: #fef8ec;
}

.list-shell {
  height: 100%;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.list-sticky {
  flex-shrink: 0;
  z-index: 5;
  background: #fef8ec;
}

.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.list-scroll-pad {
  height: 24rpx;
}

.loading-state {
  padding: 48rpx 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  text-align: center;
  color: #a08b5c;
  font-size: 28rpx;
}

.intro-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 12rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 12% 20%, rgba(255, 231, 156, 0.55), transparent 42%),
    #ffffff;
  border: 1rpx solid rgba(255, 184, 0, 0.16);
  box-shadow: 0 8rpx 20rpx rgba(255, 184, 0, 0.08);
}

.intro-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #fff4d2;
  text-align: center;
  line-height: 76rpx;
  font-size: 38rpx;
  box-shadow: inset 0 -4rpx 0 rgba(255, 184, 0, 0.12);
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #fff5d9;
  border: 1rpx solid rgba(255, 184, 0, 0.28);
}

.intro-action-hover {
  background: #ffe9a8;
}

.intro-action-text {
  color: #a86400;
  font-size: 22rpx;
  font-weight: 750;
}

.intro-action-arrow {
  color: #c47b00;
  font-size: 28rpx;
  line-height: 1;
  margin-top: -2rpx;
}

.intro-title,
.intro-desc,
.recipe-name,
.recipe-ingredients,
.empty-title,
.empty-desc {
  display: block;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #332600;
}

.intro-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8b6d35;
}

.search-panel {
  margin-bottom: 10rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 184, 0, 0.16);
  box-sizing: border-box;
}

.search-icon {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #c47b00;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 28rpx;
  color: #3f3424;
}

.search-clear {
  flex-shrink: 0;
  color: #ff9b00;
  font-size: 24rpx;
}

.search-summary {
  margin-top: 10rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #9a8b6e;
  line-height: 1.4;
}

.empty-card {
  margin-top: 12rpx;
  padding: 52rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 184, 0, 0.12);
  text-align: center;
}

.empty-emoji {
  display: block;
  font-size: 52rpx;
}

.empty-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 750;
  color: #332600;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8b6d35;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recipe-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 184, 0, 0.1);
  box-shadow: 0 6rpx 16rpx rgba(255, 184, 0, 0.06);
  box-sizing: border-box;
}

.recipe-card-hover {
  background: #fffaf0;
}

.recipe-avatar {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #fff1bd;
  color: #8a5a00;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 68rpx;
  text-align: center;
}

.recipe-card.tone-b .recipe-avatar {
  background: #ffe4b8;
}

.recipe-card.tone-c .recipe-avatar {
  background: #fff6c8;
}

.recipe-body {
  flex: 1;
  min-width: 0;
}

.recipe-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.recipe-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 750;
  color: #332600;
}

.recipe-meta {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff5d9;
  color: #9f7630;
  font-size: 20rpx;
  font-weight: 700;
}

.recipe-ingredients {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: #8b6d35;
}

.pick-btn {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #ffb800;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(255, 184, 0, 0.2);
}

.empty-btn {
  margin-top: 28rpx;
}

.primary-btn {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 18rpx;
  box-sizing: border-box;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  background: #ffb800;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(255, 184, 0, 0.22);
}

.primary-btn::after {
  border: none;
}
