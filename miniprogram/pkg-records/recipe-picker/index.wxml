<view class="page">
  <view class="list-shell">
    <view class="list-sticky">
      <view class="intro-card">
        <view class="intro-icon">🍽️</view>
        <view class="intro-copy">
          <text class="intro-title">选择食谱</text>
          <text class="intro-desc">点选用后填写这次用量。</text>
        </view>
        <view class="intro-action" bindtap="goToRecipeManagement" hover-class="intro-action-hover">
          <text class="intro-action-text">食谱管理</text>
          <text class="intro-action-arrow">›</text>
        </view>
      </view>

      <view class="search-panel" wx:if="{{!loading && recipeCount > 0}}">
        <view class="search-input-wrap">
          <text class="search-icon">搜索</text>
          <input
            class="search-input"
            type="text"
            value="{{searchQuery}}"
            placeholder="菜名或原料，如番茄、鸡蛋"
            confirm-type="search"
            bindinput="onSearchInput"
          />
          <text class="search-clear" wx:if="{{searchQuery}}" bindtap="clearSearch">清空</text>
        </view>
        <view class="search-summary">
          <text wx:if="{{searchQuery}}">找到 {{filteredCount}} 道</text>
          <text wx:else>共 {{recipeCount}} 道 · 点选用后填写用量</text>
        </view>
      </view>
    </view>

    <scroll-view class="list-scroll" scroll-y="true" enhanced show-scrollbar="{{false}}">
      <view class="loading-state" wx:if="{{loading}}">正在加载食谱...</view>

      <view class="empty-card" wx:elif="{{recipeCount === 0}}">
        <text class="empty-emoji">🍋</text>
        <text class="empty-title">还没有可用食谱</text>
        <text class="empty-desc">{{emptyHint || '先建一道常做的菜，回来就能直接选用。'}}</text>
        <button class="primary-btn empty-btn" data-mode="create" bindtap="goToRecipeManagement">去新建食谱</button>
      </view>

      <block wx:elif="{{recipeCount > 0}}">
        <view class="empty-card" wx:if="{{filteredCount === 0}}">
          <text class="empty-title">没有匹配结果</text>
          <text class="empty-desc">可以试试原料名，比如「鸡蛋」；或去食谱管理新建。</text>
        </view>

        <view class="recipe-list" wx:else>
          <view
            class="recipe-card {{item.tone}}"
            wx:for="{{filteredRecipes}}"
            wx:key="_id"
            data-id="{{item._id}}"
            hover-class="recipe-card-hover"
            hover-stay-time="80"
            bindtap="selectRecipe"
          >
            <view class="recipe-avatar">{{item.nameInitial}}</view>
            <view class="recipe-body">
              <view class="recipe-top">
                <text class="recipe-name">{{item.name}}</text>
                <text class="recipe-meta">{{item.ingredientCount}} 种原料</text>
              </view>
              <text class="recipe-ingredients">{{item.ingredientLine}}</text>
            </view>
            <text class="pick-btn">选用</text>
          </view>
        </view>
      </block>
      <view class="list-scroll-pad"></view>
    </scroll-view>
  </view>
</view>
