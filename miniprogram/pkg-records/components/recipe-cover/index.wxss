:host { display: block; flex-shrink: 0; }
.recipe-cover { position: relative; display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; overflow: hidden; border-radius: 18rpx; color: #704513; background: #ffedbb; font-size: 31rpx; font-weight: 700; }
.recipe-cover.large { width: 144rpx; height: 144rpx; border-radius: 22rpx; font-size: 47rpx; }
.cover-image { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; opacity: 0; }
.cover-image.ready { opacity: 1; }
.preview-label { position: absolute; right: 6rpx; bottom: 6rpx; padding: 4rpx 9rpx; border-radius: 10rpx; color: #fff6e7; background: rgba(49, 31, 14, .82); font-size: 20rpx; line-height: 1.35; font-weight: 500; }
