.growth-container {
  padding: 20rpx 16rpx 60rpx;
  background: #fff5d6;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4c3a00;
}

.page-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #8a6b00;
  font-size: 24rpx;
}

.chart-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 10rpx 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 184, 0, 0.15);
}

.chart-header {
  margin-bottom: 12rpx;
  padding: 0 6rpx;
}

.chart-title {
  font-size: 26rpx;
  color: #3b2d00;
  font-weight: 600;
}

.chart-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9b7a00;
}

.chart-wrapper {
  height: 1000rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-inner {
  width: 100%;
  height: 1000rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 0 16rpx;
}

.action-btn {
  flex: 1;
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: #ffb800;
  color: #fff;
}

.action-btn.ghost {
  background: #fffaf0;
  color: #8a6b00;
  border: 2rpx solid #ffe1a3;
}

.form-card,
.list-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 184, 0, 0.12);
}

.form-title,
.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3b2d00;
}

.form-title {
  margin-bottom: 20rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.list-count {
  font-size: 22rpx;
  color: #9b7a00;
}

.form-item {
  margin-bottom: 18rpx;
}

.measure-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.measure-grid .form-item {
  margin-bottom: 18rpx;
}

.field-label {
  display: block;
  font-size: 22rpx;
  color: #7a5b00;
  margin-bottom: 10rpx;
}

.compact-picker,
.compact-input {
  width: 100%;
  min-height: 72rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 184, 0, 0.18);
  border-radius: 16rpx;
  background: #FFF9EA;
  color: #302400;
  font-size: 28rpx;
  line-height: 1.3;
}

.compact-picker {
  display: flex;
  align-items: center;
}

.compact-picker.placeholder {
  color: #9A875C;
}

.form-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.month-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 4rpx 0 18rpx;
  padding: 8rpx 4rpx;
}

.month-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FFF3D6;
  color: #8a6b00;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.month-nav-btn-hover {
  background: rgba(255, 184, 0, 0.28);
}

.month-nav-btn.disabled {
  opacity: 0.35;
}

.month-switcher-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #3b2d00;
}

.list-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 48rpx 12rpx;
}

.list-loading-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ffb800;
  animation: list-loading-pulse 1s ease-in-out infinite;
}

.list-loading-text {
  font-size: 24rpx;
  color: #9b7a00;
}

@keyframes list-loading-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

.empty-list {
  padding: 36rpx 12rpx 28rpx;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 26rpx;
  color: #7a5b00;
  font-weight: 600;
}

.empty-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b08a2a;
}

.measure-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.measure-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  background: #FFF9EA;
  border: 1rpx solid rgba(255, 184, 0, 0.16);
}

.measure-item-hover {
  background: rgba(255, 184, 0, 0.12);
}

.measure-item-main {
  flex: 1;
  min-width: 0;
}

.measure-item-date-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.measure-item-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #3b2d00;
  line-height: 1.2;
}

.measure-item-age {
  font-size: 22rpx;
  color: #9b7a00;
}

.measure-item-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.measure-chip {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #B07D00;
  background: #FFF3D6;
}

.measure-chip.alt {
  color: #2E9E6B;
  background: #E7F7EF;
}

.measure-chip.head {
  color: #4A6FD9;
  background: #EAF0FF;
}

.measure-item-notes {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a6b00;
  line-height: 1.4;
}

.measure-item-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #d0b25a;
  line-height: 1;
}
