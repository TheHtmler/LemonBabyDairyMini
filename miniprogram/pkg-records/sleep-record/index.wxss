.page {
  min-height: 100vh;
  padding: 16rpx 16rpx calc(250rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% 5%, rgba(255, 221, 112, 0.24), transparent 24%),
    linear-gradient(180deg, #FFF8E8 0%, #FFFDF7 100%);
}

.hero-card,
.card {
  background: #FFFFFF;
  border: 1rpx solid rgba(255, 184, 0, 0.13);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 184, 0, 0.08);
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
  padding: 22rpx;
  background:
    radial-gradient(circle at 15% 12%, rgba(255, 234, 166, 0.5), transparent 34%),
    linear-gradient(135deg, #FFF1C2, #FFFFFF);
}

.moon-mark {
  position: relative;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #FFF8D8, #FFE182);
  box-shadow: inset 0 -4rpx 0 rgba(218, 157, 0, 0.12);
}

.moon-shape {
  position: absolute;
  top: 16rpx;
  left: 19rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #FFBC21;
}

.moon-shape::after {
  content: "";
  position: absolute;
  top: -5rpx;
  left: 12rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #FFF3C5;
}

.star {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #D99500;
}

.star-one {
  top: 18rpx;
  right: 12rpx;
}

.star-two {
  right: 19rpx;
  bottom: 15rpx;
  width: 4rpx;
  height: 4rpx;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hero-title,
.section-title {
  color: #332600;
  font-weight: 800;
}

.hero-title {
  font-size: 32rpx;
  line-height: 1.2;
}

.hero-subtitle,
.section-tip,
.field-label {
  color: #7C6B45;
  font-size: 21rpx;
}

.card {
  margin-bottom: 14rpx;
  padding: 18rpx;
}

.compact-field {
  min-width: 0;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.field-label,
.field-label-row {
  min-height: 30rpx;
  margin-bottom: 8rpx;
}

.field-label {
  display: block;
}

.field-label-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.field-label-row .field-label {
  min-height: 0;
  margin-bottom: 0;
}

.required {
  color: #E16852;
}

.clear-control {
  color: #B47A00;
  font-size: 21rpx;
  font-weight: 700;
}

.compact-picker,
.compact-value,
.compact-input,
.notes-area {
  width: 100%;
  min-height: 62rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 184, 0, 0.14);
  border-radius: 16rpx;
  background: #FFF9EA;
  color: #302400;
  font-size: 23rpx;
}

.compact-picker,
.compact-value {
  display: flex;
  align-items: center;
}

.compact-picker.placeholder {
  color: #9A875C;
}

.fixed-date {
  color: #6F5B2D;
  letter-spacing: 1rpx;
}

.ongoing-tip {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 214, 86, 0.16);
  color: #7B6328;
  font-size: 21rpx;
  line-height: 1.45;
}

.section-title {
  font-size: 27rpx;
}

.section-tip {
  margin-top: 6rpx;
}

.notes-area {
  min-height: 132rpx;
  max-height: 240rpx;
  margin-top: 14rpx;
  line-height: 1.5;
}

.footer-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 253, 247, 0.98);
  box-shadow: 0 -6rpx 18rpx rgba(71, 51, 0, 0.08);
}

.primary-actions {
  display: grid;
  grid-template-columns: 0.72fr 1.28fr;
  gap: 12rpx;
}

button {
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: none;
}

button::after {
  border: none;
}

.save-btn,
.cancel-btn,
.delete-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.save-btn {
  background: linear-gradient(135deg, #FFD45A 0%, #FFB800 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 22rpx rgba(255, 184, 0, 0.22);
}

.cancel-btn {
  background: #FFF5D6;
  color: #74591E;
}

.delete-btn {
  height: 62rpx;
  line-height: 62rpx;
  background: #FFF1ED;
  color: #C95642;
  font-size: 24rpx;
}

button[disabled] {
  opacity: 0.58;
}
