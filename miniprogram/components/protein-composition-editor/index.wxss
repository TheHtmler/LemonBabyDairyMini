@import "../../styles/form-picker.wxss";
.pc-editor { display: block; width: 100%; min-width: 0; margin: 8rpx 0 28rpx; box-sizing: border-box; color: #3f382b; font-size: 26rpx; }
.pc-header { display: flex; align-items: center; justify-content: space-between; min-height: 56rpx; }
.pc-title { font-size: 28rpx; line-height: 1.5; font-weight: 600; }
.pc-basis { margin-left: 12rpx; color: #927a50; font-size: 23rpx; line-height: 1.5; }

/* 双类规则覆盖原生按钮尺寸，表单与根节点弹窗使用同一重置。 */
.pc-editor .pc-btn, .pc-library-layer .pc-btn { position: relative; display: flex; align-items: center; justify-content: center; width: auto; min-width: 0; max-width: 100%; height: 80rpx; min-height: 0; margin: 0; padding: 0 20rpx; box-sizing: border-box; border: 0; border-radius: 12rpx; background: transparent; color: #6f5427; font-size: 26rpx; font-weight: 500; line-height: 1.4; text-align: center; white-space: normal; }
.pc-btn::after { display: none; border: 0; }
.pc-btn-disabled { opacity: .42; }
.pc-pressed { opacity: .65; }

/* 三个数据列保持同一行，行尾操作与表头占位保持等宽。 */
.pc-table { margin-top: 10rpx; }
.pc-table-head, .pc-table-row { display: flex; align-items: flex-start; width: 100%; box-sizing: border-box; }
.pc-table-head { padding: 10rpx 0; color: #88714b; font-size: 22rpx; line-height: 1.4; }
.pc-table-row { align-items: center; padding: 8rpx 0; border-bottom: 1rpx solid #eee5d4; }
.pc-col-name { display: block; flex: .9; min-width: 0; }
.pc-col-amount { display: block; flex: 1.5; min-width: 0; margin-left: 8rpx; }
.pc-col-protein { display: block; flex: 1.2; min-width: 0; margin-left: 8rpx; }
.pc-col-action { display: block; flex: 0 0 56rpx; width: 56rpx; margin-left: 8rpx; }
.pc-control { display: flex; align-items: center; width: 100%; min-width: 0; height: 80rpx; box-sizing: border-box; border: 1rpx solid #e5dfd2; border-radius: 10rpx; background: #fff; }
.pc-control-disabled { background: #f6f3ed; opacity: .7; }
.pc-input-body { flex: 1; min-width: 0; width: 0; }
.pc-input { display: block; width: 100%; min-width: 0; height: 76rpx; min-height: 0; margin: 0; padding: 0 10rpx; box-sizing: border-box; border: 0; border-radius: 0; background: transparent; color: #3d362b; font-size: 25rpx; line-height: normal; text-align: left; }
.pc-name-input { font-size: 25rpx; }
.pc-number-input { padding-right: 4rpx; padding-left: 6rpx; }
.pc-placeholder { color: #b7ad9c; font-size: 23rpx; }
.pc-table-row .pc-control { height: 68rpx; }
.pc-table-row .pc-input { height: 64rpx; padding: 0 6rpx; font-size: 24rpx; }
.pc-table-row .pc-number-input { padding: 0 4rpx; }
.pc-amount-prefix { display: block; flex: 0 0 36rpx; width: 36rpx; color: #927b53; font-size: 22rpx; line-height: 64rpx; text-align: center; }
.pc-unit-picker { display: block; flex: 0 0 56rpx; width: 56rpx; height: 64rpx; min-width: 0; }
.pc-picker-face { width: 100%; height: 64rpx; padding: 0 4rpx; color: #79623c; }
.pc-picker-label { min-width: 0; font-size: 22rpx; line-height: 1.4; }
.pc-table-row .form-picker-icon { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; margin-left: 2rpx; }
.pc-table-row .form-picker-chevron { width: 8rpx; height: 8rpx; }
.pc-suffix { flex: 0 0 28rpx; width: 28rpx; color: #927b53; font-size: 23rpx; line-height: 1.4; text-align: center; }
.pc-table-row .pc-suffix { flex: 0 0 24rpx; width: 24rpx; font-size: 22rpx; }
.pc-btn.pc-remove { display: flex; flex: 0 0 56rpx; width: 56rpx; height: 68rpx; margin: 0 0 0 8rpx; padding: 0; color: #a17b5a; font-size: 22rpx; line-height: 1.4; white-space: nowrap; }

.pc-actions { display: flex; align-items: stretch; margin-top: 16rpx; }
.pc-btn.pc-action-button { display: block; flex: 1; width: 0; height: 80rpx; padding: 0; font-size: 26rpx; font-weight: 500; line-height: 78rpx; text-align: center; }
.pc-action-label { display: block; width: 100%; height: 78rpx; margin: 0; padding: 0; font-size: 26rpx; font-weight: 500; line-height: 78rpx; text-align: center; white-space: nowrap; }
.pc-btn.pc-add-library { border: 1rpx solid #edcf88; background: #fff0cc; color: #8c620e; }
.pc-btn.pc-add-manual { margin-left: 12rpx; border: 1rpx solid #e5ddcc; background: #fffefa; color: #806b45; }
.pc-preview { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 18rpx 0 4rpx; border-top: 1rpx solid #e7dcc4; }
.pc-preview-label { flex: 1; min-width: 0; color: #8f7950; font-size: 24rpx; line-height: 1.5; }
.pc-preview-value { flex-shrink: 0; margin-left: 12rpx; color: #8a5f0b; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.pc-error { margin-top: 16rpx; }
.pc-error-copy { display: block; color: #bb6247; font-size: 24rpx; line-height: 1.6; word-break: break-all; }

/* 选择器脱离表单滚动区，提供独立的搜索、分页和关闭交互。 */
.pc-library-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 11020; }
.pc-library-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(33, 26, 15, .35); }
.pc-library-sheet { position: absolute; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; height: 70vh; padding: 0 24rpx 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 28rpx 28rpx 0 0; background: #fffdf7; }
.pc-library-header { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 22rpx 0 20rpx; }
.pc-library-heading { flex: 1; min-width: 0; }
.pc-library-title { display: block; color: #5d4c2f; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.pc-library-subtitle { display: block; margin-top: 4rpx; color: #9b8660; font-size: 23rpx; line-height: 1.5; }
.pc-library-close { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; color: #9b8660; font-size: 40rpx; line-height: 1; }
.pc-tabs { display: flex; flex-shrink: 0; padding: 4rpx; box-sizing: border-box; border-radius: 12rpx; background: #f3efe4; }
.pc-btn.pc-tab { display: flex; flex: 1; width: 0; height: 64rpx; padding: 0 12rpx; border-radius: 10rpx; color: #9c8c70; font-size: 24rpx; }
.pc-btn.pc-tab-second { margin-left: 4rpx; }
.pc-tab.pc-tab-selected { background: #fffefa; color: #76551d; font-weight: 600; }
.pc-search-control { flex-shrink: 0; margin-top: 16rpx; }
.pc-search-input { padding: 0 18rpx; font-size: 27rpx; }
.pc-library-results { display: flex; flex-direction: column; flex: 1; min-height: 0; margin-top: 12rpx; }
.pc-candidate-list { display: block; flex: 1; width: 100%; height: 0; min-height: 0; }
.pc-btn.pc-candidate { display: flex; flex-direction: row; align-items: center; justify-content: space-between; width: 100%; max-width: 100%; height: 112rpx; margin: 0; padding: 12rpx 4rpx; overflow: hidden; border-bottom: 1rpx solid #f0eadf; border-radius: 0; text-align: left; }
.pc-candidate-copy { flex: 1; width: 0; min-width: 0; }
.pc-candidate-name { display: block; overflow: hidden; color: #4e4432; font-size: 26rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.pc-candidate-detail { display: block; margin-top: 4rpx; color: #a18d68; font-size: 22rpx; line-height: 1.5; white-space: nowrap; }
.pc-candidate-add { display: block; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; margin-left: 12rpx; color: #b58a32; font-size: 32rpx; line-height: 48rpx; text-align: center; }
.pc-library-state { flex: 1; padding: 40rpx 4rpx; text-align: center; }
.pc-library-empty { padding: 48rpx 4rpx; text-align: center; }
.pc-state-copy { display: block; color: #8a795d; font-size: 25rpx; line-height: 1.6; }
.pc-state-hint { display: block; margin-top: 10rpx; color: #a18b66; font-size: 23rpx; line-height: 1.5; }
.pc-btn.pc-retry { display: flex; width: 100%; height: 64rpx; margin-top: 12rpx; color: #9a6e1e; font-size: 24rpx; }
.pc-btn.pc-more { display: flex; width: 100%; height: 72rpx; margin-top: 8rpx; color: #9a6e1e; font-size: 24rpx; }
