<view class="sync-group" wx:if="{{sources.length > 0 || showEmptyHint}}">
  <view class="sync-title" wx:if="{{showTitle}}">从其他宝宝同步数据</view>
  <view class="sync-card" wx:if="{{sources.length > 0}}">
    <view class="sync-tip">把来源宝宝的库数据一次性复制到{{targetLabel}}，复制后各宝宝数据独立、互不影响。</view>
    <view class="sync-item">
      <view class="sync-label">来源宝宝</view>
      <picker mode="selector" range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="onSourceChange">
        <view class="sync-picker">
          {{sourceNames[sourceIndex]}}
          <text class="sync-arrow">▼</text>
        </view>
      </picker>
    </view>
    <view class="sync-types">
      <view class="sync-type {{types.foods ? 'checked' : ''}}" data-type="foods" bindtap="onToggleType">食物库</view>
      <view class="sync-type {{types.recipes ? 'checked' : ''}}" data-type="recipes" bindtap="onToggleType">食谱</view>
      <view class="sync-type {{types.powders ? 'checked' : ''}}" data-type="powders" bindtap="onToggleType">奶粉档案</view>
      <view class="sync-type {{types.categories ? 'checked' : ''}}" data-type="categories" bindtap="onToggleType">食物分类</view>
      <view class="sync-type {{types.nutrition ? 'checked' : ''}}" data-type="nutrition" bindtap="onToggleType">配奶营养参数</view>
    </view>
    <view class="sync-label sync-strategy-label">已有同名数据时</view>
    <view class="sync-types">
      <view class="sync-type {{strategy === 'skip' ? 'checked' : ''}}" data-strategy="skip" bindtap="onStrategyChange">只补充新数据</view>
      <view class="sync-type {{strategy === 'overwrite' ? 'checked' : ''}}" data-strategy="overwrite" bindtap="onStrategyChange">覆盖为来源宝宝的版本</view>
    </view>
    <view class="sync-hint" wx:if="{{strategy === 'overwrite'}}">覆盖会更新{{targetLabel}}已有条目的内容，但不会删除多出来的数据。</view>
    <view class="sync-hint" wx:if="{{types.nutrition}}">配奶营养参数仅含母乳成分，不含天然蛋白系数（因宝宝而异），同步后请到配奶设置确认。</view>
    <view class="sync-hint" wx:if="{{!showRunButton}}">保存并创建新宝宝后，将自动同步勾选的数据。</view>
    <button class="sync-run-btn" wx:if="{{showRunButton}}" bindtap="runImport" disabled="{{importing}}">{{importing ? '同步中...' : '立即同步'}}</button>
  </view>
  <view class="sync-card" wx:else>
    <view class="sync-tip">暂无可同步的来源宝宝。添加或加入另一个宝宝后，可在这里同步食物库、食谱和奶粉档案。</view>
  </view>
</view>
