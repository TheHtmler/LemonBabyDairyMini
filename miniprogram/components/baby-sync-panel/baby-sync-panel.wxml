<view class="sync-group {{plain ? 'plain' : ''}}" wx:if="{{sources.length > 0 || showEmptyHint}}">
  <view class="sync-title" wx:if="{{showTitle}}">从其他宝宝同步数据</view>
  <!-- 加载中：避免先闪「暂无可同步」空态再变成选项 -->
  <view class="sync-loading" wx:if="{{loading}}">
    <view class="sync-loading-spinner"></view>
    <text class="sync-loading-text">正在加载来源宝宝...</text>
  </view>
  <block wx:elif="{{sources.length > 0}}">
    <view class="sync-tip" wx:if="{{!plain}}">把来源宝宝的库数据一次性复制到{{targetLabel}}，复制后各宝宝数据独立、互不影响。</view>

    <!-- 来源宝宝 -->
    <view class="sync-section-label">来源宝宝</view>
    <picker mode="selector" range="{{sourceNames}}" value="{{sourceIndex}}" bindchange="onSourceChange">
      <view class="sync-picker">
        <text class="sync-picker-name">{{sourceNames[sourceIndex]}}</text>
        <text class="sync-arrow">▼</text>
      </view>
    </picker>

    <!-- 同步内容：每项带说明 -->
    <view class="sync-section-label">同步内容</view>
    <view class="sync-option-list">
      <view
        class="sync-option {{types[item.key] ? 'checked' : ''}}"
        wx:for="{{typeOptions}}"
        wx:key="key"
        data-type="{{item.key}}"
        bindtap="onToggleType"
        hover-class="sync-option-hover"
      >
        <view class="sync-option-icon">{{item.icon}}</view>
        <view class="sync-option-main">
          <view class="sync-option-name">{{item.name}}</view>
          <view class="sync-option-desc">{{item.desc}}</view>
        </view>
        <view class="sync-option-check">{{types[item.key] ? '✓' : ''}}</view>
      </view>
    </view>

    <!-- 冲突策略：每项带说明 -->
    <view class="sync-section-label">已有同名数据时</view>
    <view class="sync-option-list">
      <view
        class="sync-option {{strategy === item.key ? 'checked' : ''}}"
        wx:for="{{strategyOptions}}"
        wx:key="key"
        data-strategy="{{item.key}}"
        bindtap="onStrategyChange"
        hover-class="sync-option-hover"
      >
        <view class="sync-option-main">
          <view class="sync-option-name">
            {{item.name}}
            <text class="sync-option-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
          </view>
          <view class="sync-option-desc">{{item.desc}}</view>
        </view>
        <view class="sync-option-check">{{strategy === item.key ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="sync-hint" wx:if="{{!showRunButton}}">保存并创建新宝宝后，将自动同步勾选的数据。</view>
    <button class="sync-run-btn" wx:if="{{showRunButton}}" bindtap="runImport" disabled="{{importing}}">{{importing ? '同步中...' : '立即同步'}}</button>
  </block>
  <view class="sync-tip" wx:else>暂无可同步的来源宝宝。添加或加入另一个宝宝后，可在这里同步食物库、食谱和奶粉库。</view>
</view>
