.protein-help-anchor { display: block; width: 64rpx; height: 80rpx; }
.protein-help-trigger { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 80rpx; margin: 0; padding: 0; box-sizing: border-box; }
.protein-help-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 34rpx; height: 34rpx; border: 1rpx solid #cdbd9c; border-radius: 50%; box-sizing: border-box; }
.protein-help-mark { display: block; margin: 0; padding: 0; color: #92774b; font-size: 24rpx; font-weight: 400; line-height: 28rpx; text-align: center; }
.protein-help-disabled { opacity: .4; }
.protein-help-pressed { opacity: .6; }
.protein-help-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 11000; }
.protein-help-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: transparent; }
.protein-help-popover { position: fixed; padding: 10rpx 24rpx 24rpx; box-sizing: border-box; border: 1rpx solid #e5d9c2; border-radius: 18rpx; background: #fffdf7; box-shadow: 0 10rpx 36rpx rgba(78, 58, 24, .16); }
.protein-help-measuring { visibility: hidden; }
.protein-help-arrow { position: absolute; width: 12px; height: 12px; margin-left: -6px; box-sizing: border-box; background: #fffdf7; }
.protein-help-arrow-below { top: -7px; border-top: 1rpx solid #e5d9c2; border-left: 1rpx solid #e5d9c2; transform: rotate(45deg); }
.protein-help-arrow-above { bottom: -7px; border-bottom: 1rpx solid #e5d9c2; border-right: 1rpx solid #e5d9c2; transform: rotate(45deg); }
.protein-help-heading { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; }
.protein-help-title { flex: 1; min-width: 0; color: #5f4c28; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.protein-help-close { display: flex; align-items: center; justify-content: center; flex: 0 0 56rpx; width: 56rpx; height: 64rpx; margin-right: -12rpx; color: #a38b62; font-size: 36rpx; line-height: 1; }
.protein-help-copy { display: block; color: #786545; font-size: 25rpx; line-height: 1.65; }
.protein-help-note { display: block; margin-top: 12rpx; color: #96815d; font-size: 23rpx; line-height: 1.6; }
